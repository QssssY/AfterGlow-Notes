# 构建产物
dist/
.astro/

# 子集化字体产物（由 scripts/subset-cjk.mjs 生成，dev/build 时自动重建）
src/generated/

# 依赖
node_modules/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量
.env
.env.*
!.env.example

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Go 服务的本地构建产物与数据库（部署产物在服务器上，不进仓库）
server/*.exe
server/afterglow-api
server/*.db
server/*.db-*

# Pencil 备份
*.pen.bak

# 从 blog.pen 导出的参考 HTML（实现组件时的对照物，不是源码）
# 必须忽略：Tailwind 4 的自动内容探测会扫到导出里的 bg-[url('images/...')]，
# 生成指向不存在图片的 CSS，构建时报一堆 "didn't resolve at build time"
design-export/
.design/

# AI 生图与自动化验证的临时产物（脚本随用随建，最终图片会转 webp 入库）
.genimg/
.verify-shots/
.verify-*.mjs
