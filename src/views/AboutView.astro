---
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import Sidebar from '~/components/Sidebar.astro'
import AboutMe from '~/components/about/AboutMe.astro'
import BuildPanel from '~/components/about/BuildPanel.astro'
import ChangelogCard from '~/components/about/ChangelogCard.astro'
import CreditsPanel from '~/components/about/CreditsPanel.astro'
import FriendsPanel from '~/components/about/FriendsPanel.astro'
import PrivacyPanel from '~/components/about/PrivacyPanel.astro'
import SideStack from '~/components/about/SideStack.astro'
import { email } from '~/config'
import { useI18n } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { blogrollAvatar } from '~/utils/blogroll-avatars'
import { socialDisplay } from '~/utils/social'
import { loadPosts } from '~/utils/posts'

/**
 * 页面文案（自我介绍 / 清单 / 更新日志 / 朋友面板）真身在 src/data 的
 * about.json / changelog.json / friends.json —— 管理端可改，译文放同名的
 * about.en.json 之类（只写要翻的字段），这里只做取用与组装。
 */
const { t, c, path, locale } = useI18n(Astro)
const { aboutMe, changelog, repos } = c

/**
 * 站点数据 —— 全是真的：篇数按内容集合数、项目数按 repos 数，
 * 「次喜欢」由浏览器端向 Go 后端现查（live 标记），查不到就保持 —，不编数字。
 */
const posts = await loadPosts(locale)
const stats = [
  { value: String(posts.length), label: t('about.statPosts') },
  { value: String(repos.length), label: t('about.statProjects') },
  { value: '—', label: t('about.statLikes'), live: true },
]

/*
 * 联系方式：邮箱 + 社交链接（管理台「社交链接」页签可增删改）+ RSS。
 * 社交那几行原先写死成 github.com/QssssY —— fork 的人改完管理台，这里还挂着
 * 原作者账号且无处可改。现在从 socials.json 现推，图标也用条目自带的。
 */
const contacts = [
  { icon: 'mail', value: email, href: `mailto:${email}` },
  ...c.socials.map((s) => ({ icon: s.icon, value: socialDisplay(s.href), href: s.href })),
  // 域名还没定，先写站内路径；定了域名后这里显示完整地址更好看
  { icon: 'rss', value: t('about.rssContact'), href: path('/rss.xml') },
]

/** 头像按 domain 从 images/blogroll/ 取（和友链页共用），没图退回 icon + 渐变 */
const friends = c.friends.map((f) => ({ ...f, avatar: blogrollAvatar(f.domain) }))
---

<BaseLayout title={t('about.title')}>
  {/* 紧凑模式的图标条：sticky 钉住不消失；原版模式不渲染 */}
  <div class="pointer-events-none mb-[24px] hidden xl:sticky xl:top-[16px] xl:z-40 compact:xl:block">
    <div class="pointer-events-auto w-fit"><NavBar /></div>
  </div>

  <div class="flex w-full flex-col items-start gap-[24px] xl:flex-row xl:gap-[48px]">
    {/* 左栏双模式：原版 = 完整 Sidebar + 面板全静态；紧凑 = 面板短栏钉在图标条下 */}
    <div class="hidden w-[280px] shrink-0 flex-col items-start gap-[24px] xl:flex">
      <div class="hidden w-full classic:block"><Sidebar /></div>
      <div
        data-pin-group
        class="flex w-full flex-col items-start gap-[24px] compact:xl:sticky compact:xl:top-[84px]"
      >
        <BuildPanel />
        <PrivacyPanel />
      </div>
    </div>

    <div class="flex h-fit w-full flex-col items-start gap-[24px] xl:flex-1">
      <!-- Page Head -->
      <div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[10px] rounded-[30px] px-[30px] py-[28px]">
        <span class="font-display text-[28px]/[36px] font-normal text-ink">
          {t('about.headTitle')}
        </span>
        <span class="w-full text-[13px]/[22px] font-normal text-ink-soft">
          {t('about.headSubtitle')}
        </span>
      </div>

      <!-- Row 1 -->
      <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[24px] xl:flex-row">
        <AboutMe
          role={aboutMe.role}
          paragraphs={aboutMe.paragraphs}
          chips={aboutMe.chips}
          lists={aboutMe.lists}
        />
        <SideStack stats={stats} contacts={contacts} />
      </div>

      <ChangelogCard entries={changelog} />
      <CreditsPanel />
      <FriendsPanel note={t('about.friendsNote')} friends={friends} />
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block">
    {/* 托管平台还没定（c.build.hosting 同口径），定了再写上真名字 */}
    <Footer license={t('footer.licenseAbout', { title: c.site.title })} />
  </div>
</BaseLayout>
