---
/**
 * 管理台布局 —— 站内 /overview 一组页面共用。
 *
 * 和 BaseLayout 的区别：
 *  - 不挂 ClientRouter：后台页面全是重客户端状态的表单，整页跳转最省心，
 *    脚本不用伺候 astro:page-load 重绑那一套。
 *  - noindex + 不进 sitemap（astro.config 里过滤）：页面本身没有秘密
 *    （数据都要 token 才拿得到），但也没必要被搜索引擎收进去。
 *  - 主题跟随博客本体（同一份 localStorage 'theme'）。
 */
import { site } from '~/config'
import { themeCss } from '~/utils/theme'
import '~/styles/global.css'
import '~/styles/admin.css'

interface Props {
  title: string
  /** 顶部导航高亮项 */
  active?: 'dashboard' | 'posts' | 'data' | 'theme' | 'stats' | undefined
  /** 登录页不做前置跳转检查 */
  guard?: boolean
}
const { title, active, guard = true } = Astro.props

const tabs = [
  { key: 'dashboard', label: '概览', href: '/overview' },
  { key: 'posts', label: '文章', href: '/overview/posts' },
  { key: 'data', label: '站点数据', href: '/overview/data' },
  { key: 'theme', label: '主题', href: '/overview/theme' },
  { key: 'stats', label: '统计', href: '/overview/stats' },
] as const

const customTheme = themeCss()
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · 管理台 · {site.title}</title>
    <!-- 站标与前台同一套（此前漏了这三行，标签页只能显示默认地球图标） -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {customTheme && <style set:html={customTheme} />}

    <!-- 首屏渲染前同步主题，防暗色闪白（同 BaseLayout） -->
    <script is:inline>
      ;((d) => {
        const stored = localStorage.getItem('theme') ?? 'light'
        d.classList.toggle(
          'dark',
          stored === 'dark' ||
            (stored === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches),
        )
      })(document.documentElement)
    </script>

    {
      guard && (
        <script is:inline>
          if (!localStorage.getItem('afterglow:admin:token'))
            location.replace('/overview/login')
        </script>
      )
    }
  </head>

  <body class="bg-cream text-ink">
    <div class="relative w-full overflow-clip">
      <div class="aurora pointer-events-none absolute inset-[-240px] z-0"></div>

      <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-[1080px] flex-col px-[20px] pb-[72px] xl:px-[32px]">
        <header class="flex flex-wrap items-center gap-x-[18px] gap-y-[10px] py-[22px]">
          <a href="/overview" class="flex items-baseline gap-[8px]">
            <span class="font-display text-[20px] text-ink">{site.title}</span>
            <span class="text-[12px] text-ink-muted">管理台</span>
          </a>

          <nav class="flex items-center gap-[4px]">
            {
              tabs.map((t) => (
                <a href={t.href} class="ad-tab" aria-current={active === t.key ? 'page' : undefined}>
                  {t.label}
                </a>
              ))
            }
          </nav>

          <span class="flex-1"></span>

          <a href="/" target="_blank" rel="noopener" class="ad-btn-ghost">打开站点 ↗</a>
          <button type="button" data-admin-logout class="ad-btn-ghost">退出</button>
        </header>

        <main class="flex w-full flex-1 flex-col gap-[20px]">
          <slot />
        </main>
      </div>
    </div>

    <!-- 卡片错峰浮现（照搬前台 YYsuni 手感）：按屏上顺序给统计瓦片和卡片编号。
         admin 无客户端路由，整页加载时跑一次即可；动态插入的行不参与（秒出更顺手）。 -->
    <script is:inline>
      ;(() => {
        let i = 0
        for (const el of document.querySelectorAll('.ad-stat, .ad-card')) {
          el.style.setProperty('--ad-i', String(Math.min(i++, 8)))
          el.classList.add('ad-enter')
        }
      })()
    </script>

    <script>
      import { clearToken } from '~/scripts/admin'
      document.querySelector('[data-admin-logout]')?.addEventListener('click', () => {
        clearToken()
        location.href = '/overview/login'
      })
    </script>
  </body>
</html>
