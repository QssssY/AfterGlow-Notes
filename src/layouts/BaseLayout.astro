---
import { ClientRouter } from 'astro:transitions'
import ScrollTopButton from '~/components/ScrollTopButton.astro'
import TabBar from '~/components/mobile/TabBar.astro'
import { site } from '~/config'
import '~/styles/global.css'
// 首屏关键字体 preload：正文中文 400 子集 + 正文拉丁 400 + 标题 Averia。
// 不预载就要等 CSS 解析后才发现字体 → 文字先按后备字体闪一下再换（FOUT）。
// ?url 让 Vite 给出带哈希的产物地址，和 fonts.css 里引用的是同一份文件。
import averiaWoff2 from '@fontsource/averia-gruesa-libre/files/averia-gruesa-libre-latin-400-normal.woff2?url'
import notoLatinWoff2 from '@fontsource/noto-sans-sc/files/noto-sans-sc-latin-400-normal.woff2?url'
import notoCjkWoff2 from '../generated/fonts/noto-sans-sc-cjk-400.woff2?url'

interface Props {
  title: string
  description?: string | undefined
  /** OG 图的 slug：文章传 post.id，其他页面留空则用站点默认图 */
  ogSlug?: string | undefined
  /** 文章页传 article，其余是 website */
  ogType?: 'website' | 'article'
  /** 文章发布时间，用于 article:published_time */
  publishedAt?: Date | undefined
  /** 竖排站名装饰层，组件画廊这类页面不需要 */
  rail?: boolean
  /** 移动端底部 Tab Bar */
  tabBar?: boolean
  /**
   * 桌面端顶部内边距。设计稿的 Body 从 y72 起，但用户嫌顶上空得慌，
   * 全站统一走默认的 48；72 档保留着以备回调。
   */
  topPad?: 48 | 72
}

const {
  title,
  description = site.description,
  ogSlug = 'site',
  ogType = 'website',
  publishedAt,
  rail = true,
  tabBar = true,
  topPad = 48,
} = Astro.props
const fullTitle = title === site.title ? title : `${title} · ${site.title}`

const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const ogImage = new URL(`/og/${ogSlug}.png`, base).href
---

<!doctype html>
<html lang="zh-CN" data-layout="classic">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={notoCjkWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoLatinWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={averiaWoff2} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- 站标：SVG 主用（任意尺寸都利），PNG 兜底给不认 SVG 的场合，180 给 iOS 书签 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      View Transitions 客户端路由 —— 页面切换不再整页刷新，交叉淡入。
      代价是全站脚本都改成了 astro:page-load 初始化（模块只执行一次，
      每次换页要在新 DOM 上重绑），新增脚本必须沿用这个模式。
    -->
    <ClientRouter />

    <!-- 首屏渲染前同步应用主题与布局模式，避免暗色/紧凑布局下闪一下默认态 -->
    <script is:inline>
      ;((d) => {
        const stored = localStorage.getItem('theme') ?? 'light'
        d.classList.toggle(
          'dark',
          stored === 'dark' ||
            (stored === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches),
        )
        d.dataset.theme = stored
        d.dataset.layout = localStorage.getItem('layout') ?? 'classic'
      })(document.documentElement)
    </script>
  </head>

  <body class="bg-cream text-ink">
    <!--
      背景层铺满整个视口：内容仍收在 1440 里，但 aurora 不能只画在 1440 内 ——
      比 1440 宽的屏幕上，容器内外一个有柔光一个是纯 cream，左右两侧会看出色差接缝。
      裁切用 overflow-clip 而不是 hidden：hidden 会把这层变成滚动容器，
      里面所有 position:sticky（左栏）都会失效 —— clip 只裁绘制，不产生滚动容器。
    -->
    <div class="relative w-full overflow-clip">
      <!--
        Aurora Backdrop · blog.pen 里这层只有 blur(70) 没有填充，
        内容是按品牌色补的（见 global.css 的 @utility aurora）。
        inset -240 复刻设计稿的 1920×1808 @ (-240,-240)。
      -->
      <div class="aurora pointer-events-none absolute inset-[-240px] z-0"></div>

      <div class="relative z-10 mx-auto w-full max-w-[1440px]">
        {/* 竖排站名（VerticalRail）已收起：设计稿那版右上角是空的，布局迭代后
            它在哪都别扭（压卡 / 悬浮都被用户否了）。组件保留，想复出加一行即可；
            rail prop 暂留，免得动一圈页面。 */}
        {/* 页面内边距：移动端 24/28（设计稿 Content 在 390 帧内 left24 top28），桌面 48 左右。
            transition:name="page-content"：换页时整个内容区作为一层轻抬浮现（见 global.css），
            背景留在 root 组里交叉淡化 —— 前后两页 aurora 相同，视觉上等于纹丝不动 */}
        <div
          transition:name="page-content"
          class:list={[
            'relative flex flex-col px-[24px] pt-[28px]',
            tabBar ? 'pb-[110px]' : 'pb-[28px]',
            'xl:px-[48px] xl:pb-[56px]',
            topPad === 72 ? 'xl:pt-[72px]' : 'xl:pt-[48px]',
          ]}
        >
          <slot />
        </div>
      </div>
    </div>

    {tabBar && <TabBar />}
    <ScrollTopButton />

    <!-- 播放器没有 <audio> 标签：Astro 换页 swap 后会把 body 里所有媒体元素
         重建一遍（reifyMediaElements），连 transition:persist 的也保不住。
         音频实体在 NowPlayingCard 的脚本里 new Audio() —— 模块级对象
         不进 DOM，客户端路由怎么换页都碰不到它，音乐跨页不断。 -->

    <script>
      // 外观切换 —— 桌面是侧栏的三档分段控件，移动端是顶栏的明暗直切按钮
      const query = matchMedia('(prefers-color-scheme: dark)')
      /**
       * 切换瞬间给全站颜色挂一个短过渡（见 global.css 的 .theme-anim）。
       * 类是临时的：常驻会让所有 hover 的颜色反馈都慢半拍。
       */
      let animTimer: ReturnType<typeof setTimeout> | undefined
      function withColorTransition() {
        const root = document.documentElement
        root.classList.add('theme-anim')
        clearTimeout(animTimer)
        animTimer = setTimeout(() => root.classList.remove('theme-anim'), 400)
      }

      function apply(choice: string, animate = false) {
        if (animate) withColorTransition()
        document.documentElement.classList.toggle(
          'dark',
          choice === 'dark' || (choice === 'auto' && query.matches),
        )
        document.documentElement.dataset.theme = choice
        localStorage.setItem('theme', choice)
        // 每次现查：客户端路由换页后是全新的一批控件
        for (const chip of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
          chip.setAttribute('aria-checked', String(chip.dataset.themeChoice === choice))
        }
      }

      /**
       * 圆形揭示：新主题从点击点以圆形扩散铺满全屏（View Transitions 裁切 root 快照）。
       * 期间临时抹掉所有命名分组（theme-vt，见 global.css）——不抹的话导航/内容
       * 会各自独立换装，圆形边界就不完整了。明暗没实际翻转（比如浅色系统下
       * 浅色↔自动）或不支持 / 减少动态时，退回原来的颜色短过渡。
       */
      let revealing = false
      function applyWithReveal(choice: string, ev?: MouseEvent) {
        const willDark = choice === 'dark' || (choice === 'auto' && query.matches)
        const flips = willDark !== document.documentElement.classList.contains('dark')
        if (
          !flips ||
          revealing ||
          !document.startViewTransition ||
          matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          apply(choice, true)
          return
        }
        revealing = true
        const x = ev?.clientX ?? innerWidth / 2
        const y = ev?.clientY ?? 40
        document.documentElement.classList.add('theme-vt')
        const vt = document.startViewTransition(() => apply(choice, false))
        vt.ready
          .then(() => {
            const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
            document.documentElement.animate(
              {
                clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${Math.ceil(r)}px at ${x}px ${y}px)`],
              },
              {
                // 420ms：配合 theme-vt 按停页面动画（见 global.css）后快照不再逐帧
                // 重栅格化，扩散全程满帧；原 520ms 略拖，收紧一点更利落
                duration: 420,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                pseudoElement: '::view-transition-new(root)',
              },
            )
          })
          .catch(() => {
            // 过渡被跳过（罕见）也无妨，主题已经切完
          })
        vt.finished.finally(() => {
          document.documentElement.classList.remove('theme-vt')
          revealing = false
        })
      }

      const current = () => localStorage.getItem('theme') ?? 'light'

      query.addEventListener('change', () => {
        if (current() === 'auto') apply('auto')
      })

      // 换页瞬间（新文档就位、尚未绘制）先把 dark 类和布局模式补回来，不闪默认态；
      // 同时挂 during-nav：换页不重播 @starting-style 的入场浮现 ——
      // 整页卡片每切一次导航就浮一次，高频切换晃眼睛（见 global.css 对应规则）
      document.addEventListener('astro:after-swap', () => {
        const choice = current()
        document.documentElement.classList.toggle(
          'dark',
          choice === 'dark' || (choice === 'auto' && query.matches),
        )
        document.documentElement.dataset.theme = choice
        document.documentElement.dataset.layout = localStorage.getItem('layout') ?? 'classic'
        document.documentElement.classList.add('during-nav')
      })

      // 首次加载与每次换页都会触发：在当前 DOM 上重绑控件
      document.addEventListener('astro:page-load', () => {
        apply(current())

        // 新页首帧渲染完再摘掉 during-nav，入场过渡恢复给下一次「整页刷新」用
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.documentElement.classList.remove('during-nav')),
        )

        for (const chip of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
          chip.addEventListener('click', (e) => applyWithReveal(chip.dataset.themeChoice!, e))
        }
        for (const button of document.querySelectorAll('[data-theme-cycle]')) {
          button.addEventListener('click', (e) => {
            // 移动端/图标条只有这一颗按钮：在明暗之间直切。三档循环里的「自动」
            // 常与当前系统外观同色，点上去毫无反应，像是要点两次才生效。
            applyWithReveal(
              document.documentElement.classList.contains('dark') ? 'light' : 'dark',
              e as MouseEvent,
            )
          })
        }

        // 布局双模式（原版 / 紧凑）——控件在首页侧栏；纯 CSS 切换，见 global.css 变体
        const applyLayout = (choice: string) => {
          document.documentElement.dataset.layout = choice
          try {
            localStorage.setItem('layout', choice)
          } catch {
            // 存不了就本次会话有效
          }
          for (const chip of document.querySelectorAll<HTMLElement>('[data-layout-choice]')) {
            chip.setAttribute('aria-checked', String(chip.dataset.layoutChoice === choice))
          }
        }
        // 先把控件的选中态和当前模式对齐（不写存储）
        for (const chip of document.querySelectorAll<HTMLElement>('[data-layout-choice]')) {
          chip.setAttribute(
            'aria-checked',
            String(chip.dataset.layoutChoice === (document.documentElement.dataset.layout ?? 'classic')),
          )
          chip.addEventListener('click', () => applyLayout(chip.dataset.layoutChoice!))
        }
      })
    </script>

    <!-- 入场浮现改在 global.css 里用 @starting-style 做（纯 CSS）：
         最初的 WAAPI 版把「卡片可见」押在 JS 动画能跑完上，
         渲染帧一被节流（headless / 后台标签页 / 省电模式）整页就停在 opacity 0。 -->

    <!-- 粘性策略：导航侧栏从不钉（自然滚走），只有长内容页钉一屏装得下的
         功能面板组（文章页的 目录+信息+相关、归档页的 年表+订阅），
         见各页 data-pin-group。整栏钉住的方案改过两版都被否，别再回去。 -->

    <script>
      // 图片渐显：还没解码完的图先隐着（底下是容器的骨架屏微光），
      // 加载完 0.45s 淡入 —— 慢网下不再看到图片逐行蹦出来。
      // 图一就位就给骨架容器挂 skeleton-done 停掉扫带（用户反馈：图都出来了还在扫，晃眼）
      const settle = (img: HTMLImageElement) => {
        img.classList.remove('img-pending')
        img.closest('.skeleton')?.classList.add('skeleton-done')
      }
      document.addEventListener('astro:page-load', () => {
        for (const img of document.images) {
          if (img.complete) continue
          img.classList.add('img-pending')
          img.addEventListener('load', () => settle(img), { once: true })
          img.addEventListener('error', () => settle(img), { once: true })
        }
        // 已经就位的图（缓存命中/换页回来）和压根没图的占位块：立刻收工
        for (const box of document.querySelectorAll('.skeleton')) {
          const img = box.querySelector('img')
          if (!img || img.complete) box.classList.add('skeleton-done')
        }
      })
    </script>

    <script>
      // 数字滚动 —— 统计位（[data-countup]）首次进站时从 0 涨到真实值。
      // 只在整页加载的文档上播：客户端路由换页不重播，同入场浮现的 during-nav 规则。
      let navigated = false
      document.addEventListener('astro:after-swap', () => {
        navigated = true
      })

      document.addEventListener('astro:page-load', () => {
        if (navigated || matchMedia('(prefers-reduced-motion: reduce)').matches) return

        for (const el of document.querySelectorAll<HTMLElement>('[data-countup]')) {
          // 值可能是 1,024 / 2.4k / 21万 / 1.8k 字：拆成 数字 + 后缀，只滚数字
          const raw = (el.textContent ?? '').trim()
          const m = /^(\d[\d,]*)(?:\.(\d+))?(.*)$/.exec(raw)
          if (!m) continue
          const target = Number(m[1]!.replace(/,/g, '')) + Number(`0.${m[2] ?? '0'}`)
          if (!Number.isFinite(target) || target <= 0) continue

          const decimals = m[2]?.length ?? 0
          const grouped = m[1]!.includes(',')
          const suffix = m[3] ?? ''
          const fmt = (v: number) =>
            (grouped
              ? Number(v.toFixed(decimals)).toLocaleString('en-US')
              : v.toFixed(decimals)) + suffix

          const t0 = performance.now()
          const DURATION = 750
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / DURATION)
            const eased = 1 - (1 - p) ** 3
            el.textContent = p < 1 ? fmt(target * eased) : raw
            if (p < 1) requestAnimationFrame(step)
          }
          requestAnimationFrame(step)
        }
      })
    </script>
  </body>
</html>
