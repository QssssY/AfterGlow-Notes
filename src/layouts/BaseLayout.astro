---
import { ClientRouter } from 'astro:transitions'
import ScrollTopButton from '~/components/ScrollTopButton.astro'
import TabBar from '~/components/mobile/TabBar.astro'
import { defaultLocale, useI18n } from '~/i18n'
import { themeCss } from '~/utils/theme'
import '~/styles/global.css'
// 首屏关键字体 preload：正文中文 400 子集 + 标题/界面中文 500 瘦身子集
// + 正文拉丁 400 + 标题 Averia。不预载就要等 CSS 解析后才发现字体 →
// 文字先按后备字体闪一下再换（FOUT）。500 被 subset-cjk 裁到只剩界面与
// 标题字符，预载的代价很小。
// ?url 让 Vite 给出带哈希的产物地址，和 fonts.css 里引用的是同一份文件。
import averiaWoff2 from '@fontsource/averia-gruesa-libre/files/averia-gruesa-libre-latin-400-normal.woff2?url'
import notoLatinWoff2 from '@fontsource/noto-sans-sc/files/noto-sans-sc-latin-400-normal.woff2?url'
import notoCjkWoff2 from '../generated/fonts/noto-sans-sc-cjk-400.woff2?url'
import notoCjk500Woff2 from '../generated/fonts/noto-sans-sc-cjk-500.woff2?url'

interface Props {
  title: string
  description?: string | undefined
  /** OG 图的 slug：文章传 post.id，其他页面留空则用站点默认图 */
  ogSlug?: string | undefined
  /** 文章页传 article，其余是 website */
  ogType?: 'website' | 'article'
  /** 文章发布时间，用于 article:published_time */
  publishedAt?: Date | undefined
  /** 移动端底部 Tab Bar */
  tabBar?: boolean
  /**
   * 桌面端顶部内边距。设计的 Body 从 y72 起，但用户嫌顶上空得慌，
   * 全站统一走默认的 48；72 档保留着以备回调。
   */
  topPad?: 48 | 72
}

const { locale, meta, c, path, alternates, t } = useI18n(Astro)
const { site } = c

const {
  title,
  description = site.description,
  ogSlug = 'site',
  ogType = 'website',
  publishedAt,
  tabBar = true,
  topPad = 48,
} = Astro.props
const fullTitle = title === site.title ? title : `${title} · ${site.title}`

// 管理台「主题」页配的颜色覆盖（src/data/theme.json）；没配就一个字节不输出
const customTheme = themeCss()

const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
// OG 图按语种各出一张：标题、副标题、站名都跟着语言变（见 pages/og）
const ogImage = new URL(path(`/og/${ogSlug}.png`), base).href
---

<!doctype html>
<!-- data-locale 给客户端脚本用：脚本里的动态文案（分页、搜索提示、复制反馈）
     要按当前语种取词，读这个属性比再解析一次 URL 稳。 -->
<html lang={meta.htmlLang} data-locale={locale} data-layout="classic">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={notoCjkWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoCjk500Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoLatinWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={averiaWoff2} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- 站标：SVG 主用（任意尺寸都利），PNG 兜底给不认 SVG 的场合，180 给 iOS 书签 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={path('/rss.xml')} />

    <!--
      语言互链：告诉搜索引擎这三个地址是同一页的不同语言版本，别当重复内容。
      x-default 指向中文（默认语种），语言偏好不匹配时落在它上面。
    -->
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.htmlLang} href={new URL(alt.href, base).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates.find((alt) => alt.code === defaultLocale)!.href, base).href}
    />

    {customTheme && <style set:html={customTheme} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternates
        .filter((alt) => !alt.current)
        .map((alt) => <meta property="og:locale:alternate" content={alt.ogLocale} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      View Transitions 客户端路由 —— 页面切换不再整页刷新，交叉淡入。
      代价是全站脚本都改成了 astro:page-load 初始化（模块只执行一次，
      每次换页要在新 DOM 上重绑），新增脚本必须沿用这个模式。
    -->
    <ClientRouter />

    <!-- 首屏渲染前同步应用主题与布局模式，避免暗色/紧凑布局下闪一下默认态 -->
    <script is:inline>
      ;((d) => {
        // localStorage 在 Safari「阻止所有 Cookie」/ 沙箱 iframe 里一碰就抛：抛了就按默认态走
        let stored = 'light'
        let layout = 'classic'
        try {
          stored = localStorage.getItem('theme') ?? 'light'
          layout = localStorage.getItem('layout') ?? 'classic'
        } catch {}
        d.classList.toggle(
          'dark',
          stored === 'dark' ||
            (stored === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches),
        )
        d.dataset.theme = stored
        d.dataset.layout = layout
      })(document.documentElement)
    </script>
  </head>

  <body class="bg-cream text-ink">
    {/* 键盘用户的「跳到正文」：平时视觉隐藏，Tab 到它才浮出来（ui.ts 的文案早就三语备好，一直没接） */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-[16px] focus:left-[16px] focus:z-[100] focus:rounded-full focus:bg-btn-dark focus:px-[16px] focus:py-[8px] focus:text-[13px] focus:font-medium focus:text-white"
    >
      {t('common.skipToContent')}
    </a>
    <!--
      背景层铺满整个视口：内容仍收在 1440 里，但 aurora 不能只画在 1440 内 ——
      比 1440 宽的屏幕上，容器内外一个有柔光一个是纯 cream，左右两侧会看出色差接缝。
      裁切用 overflow-clip 而不是 hidden：hidden 会把这层变成滚动容器，
      里面所有 position:sticky（左栏）都会失效 —— clip 只裁绘制，不产生滚动容器。
    -->
    <div class="relative w-full overflow-clip">
      <!--
        Aurora Backdrop
        内容是按品牌色补的（见 global.css 的 @utility aurora）。
        inset -240 复刻设计的 1920×1808 @ (-240,-240)。
      -->
      <div class="aurora pointer-events-none absolute inset-[-240px] z-0"></div>

      <div class="relative z-10 mx-auto w-full max-w-[1440px]">
        {/* 竖排站名（VerticalRail）已收起：设计那版右上角是空的，布局迭代后
            它在哪都别扭（压卡 / 悬浮都被用户否了）。组件保留，想复出加一行即可。 */}
        {/* 页面内边距：移动端 24/28（设计 Content 在 390 帧内 left24 top28），桌面 48 左右。
            换页动效照搬 YYsuni：瞬时切换 + 新页卡片错峰弹入（global.css 的 card-enter），
            不再挂任何 View Transitions 共享元素名 —— 玻璃卡快照会变成模糊空板 */}
        {/* <main> 是页面唯一的正文地标（读屏 / 跳转链接的落点）；display 与 div 相同，不改布局 */}
        <main
          id="main"
          class:list={[
            'relative flex flex-col px-[24px] pt-[28px]',
            tabBar ? 'pb-[110px]' : 'pb-[28px]',
            'xl:px-[48px] xl:pb-[56px]',
            topPad === 72 ? 'xl:pt-[72px]' : 'xl:pt-[48px]',
          ]}
        >
          <slot />
        </main>
      </div>
    </div>

    {tabBar && <TabBar />}
    <ScrollTopButton />

    <!-- 入场错峰序号（照搬 YYsuni 的 order*0.1s）：给每张玻璃卡编 --enter-i，
         card-enter/panel-enter 的 animation-delay 按它错峰。必须在首帧前写好：
         首载靠这段同步脚本（在正文之后解析），换页靠 astro:after-swap（swap 后、绘制前）。
         封顶 8 —— 再靠后的卡在首屏外，等滚到时早轮到了，不让它干等一秒多。 -->
    <script is:inline>
      ;(() => {
        // 导航底盘（侧栏 / 紧凑图标条）的跨页三态（照搬 YYsuni）：
        //  1) 同款上一页已可见 → data-enter-static 静止，不重播入场（重播就是那下闪）
        //  2) 形态互换（紧凑模式 首页侧栏 ↔ 内页图标条）→ 变形飞行（下面 morph）
        //  3) 上一页没有且无从变形 → 照常错峰弹入
        const SIDEBAR = '[data-sidebar]'
        const NAVBAR = '[data-navbar]'
        const visible = (el) => (el.checkVisibility ? el.checkVisibility() : true)
        const find = (sel) => [...document.querySelectorAll(sel)].find(visible)
        // 变形时唯一单独飞的零件：头像（两形态共有、几乎同尺寸的圆，当「同一张卡」
        // 的身份锚点）。图标不飞 —— 八颗图标各自弹簧散飞被用户评为「搞笑」；
        // Material 容器变换的定式就是容器变形 + 内容整层交叉淡化，零件越少越体面
        const parts = (root) => {
          const img = root.querySelector('img')
          return img ? { '@avatar': img.getBoundingClientRect() } : {}
        }
        let had = {}
        document.addEventListener('astro:before-swap', () => {
          had = {}
          for (const sel of [SIDEBAR, NAVBAR]) {
            const el = find(sel)
            if (!el) continue
            const clone = el.cloneNode(true)
            for (const s of clone.querySelectorAll('script')) s.remove()
            had[sel] = {
              rect: el.getBoundingClientRect(),
              radius: getComputedStyle(el).borderRadius,
              parts: parts(el),
              clone,
            }
          }
        })

        // 形态互换的变形（Material「容器变换」定式的收敛版）：代理玻璃卡真实过渡
        // left/top/width/height/圆角 —— 两形态左上角几乎重合，观感就是卡片原地
        // 折叠/展开 —— 新旧内容整层交叉淡化，只有头像单独滑到新位。
        // 两轮教训：transform scale 非等比 = 哈哈镜；八颗图标弹簧散飞 = 搞笑。
        // 全程一条无回弹缓出曲线（回弹在 700→52 的高度上会穿负塌线，也显闹）。
        const morph = (el, from) => {
          el.toggleAttribute('data-enter-static', true) // 变形代替默认弹入（先打标再测量，backwards 填充的入场缩放会污染 rect）
          const to = el.getBoundingClientRect()
          if (!to.width || !from.rect.width) return
          const toRadius = getComputedStyle(el).borderRadius
          const toParts = parts(el)
          const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)'

          const proxy = document.createElement('div')
          proxy.className = 'glass'
          proxy.toggleAttribute('data-enter-static', true) // 代理卡自己别播 panel-enter
          Object.assign(proxy.style, {
            position: 'fixed',
            zIndex: '60',
            margin: '0',
            pointerEvents: 'none',
            overflow: 'clip',
            boxSizing: 'border-box',
            left: `${from.rect.left}px`,
            top: `${from.rect.top}px`,
            width: `${from.rect.width}px`,
            height: `${from.rect.height}px`,
            borderRadius: from.radius,
            transition: 'none',
          })

          // 新旧内容各铺一层：尺寸钉死在各自形态的原始大小，只被盒子裁切，
          // 不跟着挤压重排（他的内容靠 motion 重排归位，我们用飞行零件补这口感）
          const layer = (clone, rect) => {
            clone.classList.remove('glass') // 卡皮由代理画，内容层只留排版
            for (const s of clone.querySelectorAll('script')) s.remove()
            // 剥掉全部 data-*：站内脚本全按 data 属性找元素（astro:page-load 在变形
            // 中途才跑），不剥的话 NavBar/Sidebar 脚本会把克隆当真身初始化 ——
            // 实测胶囊被提前点亮在终点。视觉全靠 class + 内联样式，剥了不掉妆
            for (const n of [clone, ...clone.querySelectorAll('*')])
              for (const a of [...n.attributes])
                if (a.name.startsWith('data-')) n.removeAttribute(a.name)
            Object.assign(clone.style, {
              position: 'absolute',
              left: '0',
              top: '0',
              margin: '0',
              width: `${rect.width}px`,
              height: `${rect.height}px`,
              animation: 'none',
              transition: 'none',
            })
            return clone
          }
          const shared = Object.keys(from.parts).filter((k) => k in toParts)
          const pick = (root, k) =>
            k === '@avatar' ? root.querySelector('img') : root.querySelector(`a[href="${k}"] svg`)
          const hideShared = (root) => {
            for (const k of shared) {
              const n = pick(root, k)
              if (n) n.style.visibility = 'hidden' // 正体藏起来，位置由飞行替身占
            }
          }
          const oldLayer = layer(from.clone, from.rect)
          const newLayer = layer(el.cloneNode(true), to)
          newLayer.style.opacity = '0'
          hideShared(oldLayer)
          hideShared(newLayer)
          proxy.append(oldLayer, newLayer)

          // 飞行零件：用终点形态的节点当替身（落地即无缝接上正身），起终点都换算成
          // 代理盒内坐标 —— 盒子和零件同曲线，叠加后的视觉轨迹仍是同一条弹簧
          const flyers = shared.map((k) => {
            const src = pick(el, k)
            const start = from.parts[k]
            const end = toParts[k]
            const holder = document.createElement('span')
            const node = src.cloneNode(true)
            Object.assign(node.style, { width: '100%', height: '100%', display: 'block' })
            if (k !== '@avatar') holder.style.color = getComputedStyle(src.closest('a')).color
            Object.assign(holder.style, {
              position: 'absolute',
              left: `${start.left - from.rect.left}px`,
              top: `${start.top - from.rect.top}px`,
              width: `${start.width}px`,
              height: `${start.height}px`,
              transition: 'none',
            })
            holder.append(node)
            proxy.append(holder)
            return { holder, end }
          })

          document.body.append(proxy)
          el.style.visibility = 'hidden' // 正身让位但保住布局，变形完再现身
          void proxy.offsetWidth // 起点落定，再放开过渡
          proxy.style.transition = `left 0.45s ${EASE}, top 0.45s ${EASE}, width 0.45s ${EASE}, height 0.45s ${EASE}, border-radius 0.45s ${EASE}`
          Object.assign(proxy.style, {
            left: `${to.left}px`,
            top: `${to.top}px`,
            width: `${to.width}px`,
            height: `${to.height}px`,
            borderRadius: toRadius,
          })
          // 交叉淡化收紧：旧层速退、新层小重叠跟进，中途不出现空玻璃也不双重曝光
          oldLayer.style.transition = 'opacity 0.14s ease'
          oldLayer.style.opacity = '0'
          newLayer.style.transition = 'opacity 0.22s ease 0.06s'
          newLayer.style.opacity = '1'
          for (const { holder, end } of flyers) {
            holder.style.transition = `left 0.45s ${EASE}, top 0.45s ${EASE}, width 0.45s ${EASE}, height 0.45s ${EASE}`
            Object.assign(holder.style, {
              left: `${end.left - to.left}px`,
              top: `${end.top - to.top}px`,
              width: `${end.width}px`,
              height: `${end.height}px`,
            })
          }
          setTimeout(() => {
            el.style.visibility = ''
            proxy.remove()
          }, 470)
        }

        // 入场提层的登记簿（跨两次 stagger 存活：连点换页时先把上一批摘干净）
        let entering = []
        let enterTimer = 0

        const stagger = () => {
          // 先把布局模式补回来再量可见性：这个监听比主题脚本注册得早，换页后
          // 先跑到 —— 那一刻新文档还是初始 classic，紧凑用户的图标条 display:none，
          // 变形和编号都会量错对象
          try {
            document.documentElement.dataset.layout = localStorage.getItem('layout') ?? 'classic'
          } catch {}
          for (const sel of [SIDEBAR, NAVBAR]) {
            if (!had[sel]) continue
            for (const el of document.querySelectorAll(sel)) el.toggleAttribute('data-enter-static', true)
          }
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const nowSidebar = find(SIDEBAR)
            const nowNavbar = find(NAVBAR)
            if (nowNavbar && !had[NAVBAR] && had[SIDEBAR] && !nowSidebar) morph(nowNavbar, had[SIDEBAR])
            else if (nowSidebar && !had[SIDEBAR] && had[NAVBAR] && !nowNavbar) morph(nowSidebar, had[NAVBAR])
          }
          // 只给「当前可见」的卡编号 —— 双布局模式下另一形态的条/栏都在 DOM 里
          // （display:none），不滤掉的话可见卡的序号被白白推高，页面要空等几百毫秒。
          // 静止/变形中的底盘不占序号 —— 内容卡的错峰从 0 起跳。
          // 序号按屏上位置（上→下、左→右）排 —— YYsuni 手工 order 的自动版
          const cards = []
          for (const el of document.querySelectorAll('.glass, .glass-row, .glass-panel')) {
            if (el.closest('[data-enter-static]')) continue
            if (el.checkVisibility ? el.checkVisibility() : true) {
              const r = el.getBoundingClientRect()
              cards.push({ el, top: r.top, left: r.left })
            }
          }
          cards.sort((a, b) => a.top - b.top || a.left - b.left)
          cards.forEach(({ el }, i) => el.style.setProperty('--enter-i', String(Math.min(i, 8))))

          // 入场期间给卡挂 will-change（2026-08-29 掉帧复盘）：玻璃卡自带
          // backdrop-filter + 大投影，弹入的 scale/opacity 不提层就每帧重绘 ——
          // 实测换页 4× 节流下掉帧 35→13、实绘帧 253→292。
          // 但它绝不能常驻：每张卡长期独占合成层，静置时白占显存还拖累滚动。
          // 动画窗口 = 封顶 8 档错峰(800ms) + 时长 450ms，留足余量后统一摘掉。
          clearTimeout(enterTimer)
          for (const el of entering) el.style.willChange = ''
          entering = []
          // 减少动态偏好下入场动画整个不播（CSS 在 no-preference 里），别白提层
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            entering = cards.map((c) => c.el)
            for (const el of entering) el.style.willChange = 'transform, opacity'
            enterTimer = setTimeout(() => {
              for (const el of entering) el.style.willChange = ''
              entering = []
            }, 1500)
          }
        }
        stagger()
        document.addEventListener('astro:after-swap', stagger)
      })()
    </script>

    <!-- 播放器没有 <audio> 标签：Astro 换页 swap 后会把 body 里所有媒体元素
         重建一遍（reifyMediaElements），连 transition:persist 的也保不住。
         音频实体在 NowPlayingCard 的脚本里 new Audio() —— 模块级对象
         不进 DOM，客户端路由怎么换页都碰不到它，音乐跨页不断。 -->

    <script>
      // 外观切换 —— 桌面是侧栏的三档分段控件，移动端是顶栏的明暗直切按钮
      const query = matchMedia('(prefers-color-scheme: dark)')

      // localStorage 受限环境（Safari 阻止所有 Cookie / 沙箱 iframe）里 get/set 都会抛：
      // 这段跑在 page-load 回调开头，抛了后面的主题 / 布局控件一个都绑不上
      const storeGet = (k: string) => {
        try {
          return localStorage.getItem(k)
        } catch {
          return null
        }
      }
      const storeSet = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v)
        } catch {
          // 存不了就本次会话有效
        }
      }

      function apply(choice: string) {
        document.documentElement.classList.toggle(
          'dark',
          choice === 'dark' || (choice === 'auto' && query.matches),
        )
        document.documentElement.dataset.theme = choice
        storeSet('theme', choice)
        // 每次现查：客户端路由换页后是全新的一批控件
        for (const chip of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
          chip.setAttribute('aria-checked', String(chip.dataset.themeChoice === choice))
        }
      }

      /**
       * 圆形揭示（View Transitions）：圆内显影真实的新主题页面。
       * 动画本体在 global.css 的 theme-reveal-in（含防卡三措施的注释），
       * 这里只负责：算圆心/半径写进变量 → 挂 theme-vt → 开过渡 → 收尾。
       * 不翻转 / 连点 / 不支持 / 减少动态 → 退化为瞬时翻转。
       */
      let revealing = false
      const revealCleanup = () => {
        const rootStyle = document.documentElement.style
        document.documentElement.classList.remove('theme-vt')
        rootStyle.removeProperty('--reveal-x')
        rootStyle.removeProperty('--reveal-y')
        rootStyle.removeProperty('--reveal-r')
        revealing = false
      }
      function applyWithReveal(choice: string, ev?: MouseEvent) {
        const willDark = choice === 'dark' || (choice === 'auto' && query.matches)
        const flips = willDark !== document.documentElement.classList.contains('dark')
        if (
          !flips ||
          revealing ||
          !document.startViewTransition ||
          matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          apply(choice)
          return
        }
        revealing = true
        const x = ev?.clientX ?? innerWidth / 2
        const y = ev?.clientY ?? 40
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
        const rootStyle = document.documentElement.style
        rootStyle.setProperty('--reveal-x', `${x}px`)
        rootStyle.setProperty('--reveal-y', `${y}px`)
        rootStyle.setProperty('--reveal-r', `${Math.ceil(r)}px`)
        document.documentElement.classList.add('theme-vt')
        const vt = document.startViewTransition(() => apply(choice))
        vt.finished.finally(() => {
          // 收尾重算（摘类恢复循环动画）挪出最后一帧，扩散满屏后不顿；
          // revealing 等收尾完再放开，连点时迟到的清理才不会拆下一轮的台
          setTimeout(revealCleanup, 80)
        })
      }
      // 揭示进行中用户点了站内链接：先把揭示的规则拆干净，
      // 免得换页的 View Transition 沾上 theme-vt 的裁切动画
      document.addEventListener('astro:before-preparation', () => {
        if (revealing) revealCleanup()
      })

      const current = () => storeGet('theme') ?? 'light'

      query.addEventListener('change', () => {
        if (current() === 'auto') apply('auto')
      })

      // 换页瞬间（新文档就位、尚未绘制）先把 dark 类和布局模式补回来，不闪默认态。
      // 入场弹跳每次换页都重播（YYsuni 的手感），不再挂 during-nav 抑制
      document.addEventListener('astro:after-swap', () => {
        const choice = current()
        document.documentElement.classList.toggle(
          'dark',
          choice === 'dark' || (choice === 'auto' && query.matches),
        )
        document.documentElement.dataset.theme = choice
        document.documentElement.dataset.layout = storeGet('layout') ?? 'classic'
      })

      // 首次加载与每次换页都会触发：在当前 DOM 上重绑控件
      document.addEventListener('astro:page-load', () => {
        apply(current())

        for (const chip of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
          chip.addEventListener('click', (e) => applyWithReveal(chip.dataset.themeChoice!, e))
        }
        for (const button of document.querySelectorAll('[data-theme-cycle]')) {
          button.addEventListener('click', (e) => {
            // 移动端/图标条只有这一颗按钮：在明暗之间直切。三档循环里的「自动」
            // 常与当前系统外观同色，点上去毫无反应，像是要点两次才生效。
            applyWithReveal(
              document.documentElement.classList.contains('dark') ? 'light' : 'dark',
              e as MouseEvent,
            )
          })
        }

        // 布局双模式（原版 / 紧凑）——控件在首页侧栏；纯 CSS 切换，见 global.css 变体
        const applyLayout = (choice: string) => {
          document.documentElement.dataset.layout = choice
          storeSet('layout', choice)
          for (const chip of document.querySelectorAll<HTMLElement>('[data-layout-choice]')) {
            chip.setAttribute('aria-checked', String(chip.dataset.layoutChoice === choice))
          }
        }
        // 先把控件的选中态和当前模式对齐（不写存储）
        for (const chip of document.querySelectorAll<HTMLElement>('[data-layout-choice]')) {
          chip.setAttribute(
            'aria-checked',
            String(chip.dataset.layoutChoice === (document.documentElement.dataset.layout ?? 'classic')),
          )
          chip.addEventListener('click', () => applyLayout(chip.dataset.layoutChoice!))
        }
      })
    </script>

    <!-- 入场弹跳本体在 global.css（card-enter/panel-enter，纯 CSS 动画）：
         引擎保证到达终态，headless / 后台标签页这类不出帧的环境直接显示终值。 -->

    <!-- 粘性策略：导航侧栏从不钉（自然滚走），只有长内容页钉一屏装得下的
         功能面板组（文章页的 目录+信息+相关、归档页的 年表+订阅），
         见各页 data-pin-group。整栏钉住的方案改过两版都被否，别再回去。 -->

    <script>
      // 图片渐显：还没解码完的图先隐着（底下是容器的骨架屏微光），
      // 加载完 0.45s 淡入 —— 慢网下不再看到图片逐行蹦出来。
      // 图一就位就给骨架容器挂 skeleton-done 停掉扫带（用户反馈：图都出来了还在扫，晃眼）
      const settle = (img: HTMLImageElement) => {
        img.classList.remove('img-pending')
        img.closest('.skeleton')?.classList.add('skeleton-done')
      }
      document.addEventListener('astro:page-load', () => {
        for (const img of document.images) {
          if (img.complete) continue
          img.classList.add('img-pending')
          img.addEventListener('load', () => settle(img), { once: true })
          img.addEventListener('error', () => settle(img), { once: true })
        }
        // 已经就位的图（缓存命中/换页回来）和压根没图的占位块：立刻收工
        for (const box of document.querySelectorAll('.skeleton')) {
          const img = box.querySelector('img')
          if (!img || img.complete) box.classList.add('skeleton-done')
        }
      })
    </script>

    <script>
      // 数字滚动 —— 统计位（[data-countup]）首次进站时从 0 涨到真实值。
      // 只在整页加载的文档上播：客户端路由换页不重播（高频换页反复滚数字很吵）。
      let navigated = false
      document.addEventListener('astro:after-swap', () => {
        navigated = true
      })

      document.addEventListener('astro:page-load', () => {
        if (navigated || matchMedia('(prefers-reduced-motion: reduce)').matches) return

        for (const el of document.querySelectorAll<HTMLElement>('[data-countup]')) {
          // 值可能是 1,024 / 2.4k / 21万 / 1.8k 字：拆成 数字 + 后缀，只滚数字
          const raw = (el.textContent ?? '').trim()
          const m = /^(\d[\d,]*)(?:\.(\d+))?(.*)$/.exec(raw)
          if (!m) continue
          const target = Number(m[1]!.replace(/,/g, '')) + Number(`0.${m[2] ?? '0'}`)
          if (!Number.isFinite(target) || target <= 0) continue

          const decimals = m[2]?.length ?? 0
          const grouped = m[1]!.includes(',')
          const suffix = m[3] ?? ''
          // 千分位跟着页面语种走：终值是服务端渲染的 raw（已按语种格式化），
          // 中途各帧用同一套 locale 才不会在最后一帧「跳一下」
          const tag = document.documentElement.lang || undefined
          const fmt = (v: number) =>
            (grouped ? Number(v.toFixed(decimals)).toLocaleString(tag) : v.toFixed(decimals)) +
            suffix

          const t0 = performance.now()
          const DURATION = 750
          // 有的统计位是活数据（关于页的喜欢数：SWR 先回放缓存、网络应答再改写）。
          // 别人改过的文本就不能再由动画收尾覆盖 —— 每帧先核对上一帧写的值还在不在，
          // 不在了说明新值已经到了，立刻退场；否则网络值会被下一帧盖掉，定格在缓存旧值
          let written = raw
          const step = (now: number) => {
            if (el.textContent !== written) return
            const p = Math.min(1, (now - t0) / DURATION)
            const eased = 1 - (1 - p) ** 3
            written = p < 1 ? fmt(target * eased) : raw
            el.textContent = written
            if (p < 1) requestAnimationFrame(step)
          }
          requestAnimationFrame(step)
        }
      })
    </script>
  </body>
</html>
