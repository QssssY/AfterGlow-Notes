---
import TabBar from '~/components/mobile/TabBar.astro'
import VerticalRail from '~/components/VerticalRail.astro'
import { site } from '~/config'
import '~/styles/global.css'

interface Props {
  title: string
  description?: string | undefined
  /** OG 图的 slug：文章传 post.id，其他页面留空则用站点默认图 */
  ogSlug?: string | undefined
  /** 文章页传 article，其余是 website */
  ogType?: 'website' | 'article'
  /** 文章发布时间，用于 article:published_time */
  publishedAt?: Date | undefined
  /** 竖排站名装饰层，组件画廊这类页面不需要 */
  rail?: boolean
  /** 移动端底部 Tab Bar */
  tabBar?: boolean
  /**
   * 桌面端顶部内边距。设计稿现在所有页面的 Body 都从 y72 起
   * （首页那排 Header 大按钮这轮被挪进了侧栏，48 那一档只剩组件画廊在用）。
   */
  topPad?: 48 | 72
}

const {
  title,
  description = site.description,
  ogSlug = 'site',
  ogType = 'website',
  publishedAt,
  rail = true,
  tabBar = true,
  topPad = 48,
} = Astro.props
const fullTitle = title === site.title ? title : `${title} · ${site.title}`

const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const ogImage = new URL(`/og/${ogSlug}.png`, base).href
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 首屏渲染前同步应用主题，避免暗色下闪白 -->
    <script is:inline>
      ;((d) => {
        const stored = localStorage.getItem('theme') ?? 'light'
        d.classList.toggle(
          'dark',
          stored === 'dark' ||
            (stored === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches),
        )
        d.dataset.theme = stored
      })(document.documentElement)
    </script>
  </head>

  <body class="bg-cream text-ink">
    <div class="relative mx-auto w-full max-w-[1440px] overflow-hidden">
      <!--
        Aurora Backdrop · blog.pen 里这层只有 blur(70) 没有填充，
        内容是按品牌色补的（见 global.css 的 @utility aurora）。
        inset -240 复刻设计稿的 1920×1808 @ (-240,-240)。
      -->
      <div class="aurora pointer-events-none absolute inset-[-240px] z-0"></div>

      {rail && <VerticalRail />}
      <!-- 页面内边距：移动端 24/28（设计稿 Content 在 390 帧内 left24 top28），桌面 48 左右 -->
      <div
        class:list={[
          'relative z-10 flex flex-col px-[24px] pt-[28px]',
          tabBar ? 'pb-[110px]' : 'pb-[28px]',
          'xl:px-[48px] xl:pb-[56px]',
          topPad === 72 ? 'xl:pt-[72px]' : 'xl:pt-[48px]',
        ]}
      >
        <slot />
      </div>
    </div>

    {tabBar && <TabBar />}

    <script>
      // 外观切换 —— 桌面是侧栏的三档分段控件，移动端是顶栏的单个循环按钮
      const ORDER = ['light', 'dark', 'auto']
      const query = matchMedia('(prefers-color-scheme: dark)')
      const chips = document.querySelectorAll<HTMLElement>('[data-theme-choice]')

      /**
       * 切换瞬间给全站颜色挂一个短过渡（见 global.css 的 .theme-anim）。
       * 类是临时的：常驻会让所有 hover 的颜色反馈都慢半拍。
       */
      let animTimer: ReturnType<typeof setTimeout> | undefined
      function withColorTransition() {
        const root = document.documentElement
        root.classList.add('theme-anim')
        clearTimeout(animTimer)
        animTimer = setTimeout(() => root.classList.remove('theme-anim'), 400)
      }

      function apply(choice: string, animate = false) {
        if (animate) withColorTransition()
        document.documentElement.classList.toggle(
          'dark',
          choice === 'dark' || (choice === 'auto' && query.matches),
        )
        document.documentElement.dataset.theme = choice
        localStorage.setItem('theme', choice)
        for (const chip of chips) {
          chip.setAttribute('aria-checked', String(chip.dataset.themeChoice === choice))
        }
      }

      const current = () => localStorage.getItem('theme') ?? 'light'
      apply(current())

      for (const chip of chips) {
        chip.addEventListener('click', () => apply(chip.dataset.themeChoice!, true))
      }

      for (const button of document.querySelectorAll('[data-theme-cycle]')) {
        button.addEventListener('click', () => {
          apply(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]!, true)
        })
      }

      query.addEventListener('change', () => {
        if (current() === 'auto') apply('auto')
      })
    </script>

    <script>
      /**
       * 入场浮现 —— 参考 YYsuni 2025 blog 卡片进场（opacity 0→1 + 上移收位，错峰）。
       *
       * 用 WAAPI 而不是 CSS 类：动画结束后不留任何样式，
       * 不会和 hover 上浮的 translate 过渡打架。fill: backwards 保证
       * 延迟期间元素停在初始帧，不会先闪现再消失。
       * 只挑最外层的玻璃卡（嵌套的跟着父级走就够了），首屏之外的进视口再播。
       */
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const cards = [...document.querySelectorAll<HTMLElement>('.glass, .glass-panel, .glass-row')]
          .filter((el) => !el.parentElement?.closest('.glass, .glass-panel, .glass-row'))
          .filter((el) => el.offsetParent !== null)

        const io = new IntersectionObserver(
          (entries) => {
            let i = 0
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              io.unobserve(entry.target)
              entry.target.animate(
                [
                  { opacity: 0, translate: '0 12px' },
                  { opacity: 1, translate: '0 0' },
                ],
                {
                  duration: 480,
                  delay: Math.min(i++ * 55, 440),
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  fill: 'backwards',
                },
              )
            }
          },
          { rootMargin: '0px 0px -4% 0px' },
        )
        for (const el of cards) io.observe(el)
      }
    </script>
  </body>
</html>
