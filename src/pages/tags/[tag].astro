---
import type { GetStaticPaths } from 'astro'
import { defaultLocale } from '~/i18n/locales'
import { tagRoutes } from '~/utils/posts'
import TagView from '~/views/TagView.astro'

export const getStaticPaths = (async () => tagRoutes(defaultLocale)) satisfies GetStaticPaths

const { tag, posts } = Astro.props
---

<TagView tag={tag} posts={posts} />
