---
import type { GetStaticPaths } from 'astro'
import { Icon } from 'astro-icon/components'
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import Sidebar from '~/components/Sidebar.astro'
import StatsPageHead from '~/components/StatsPageHead.astro'
import TagsBand from '~/components/blog/TagsBand.astro'
import TimelineCard from '~/components/blog/TimelineCard.astro'
import { compactCount, groupByYear, loadPosts, tagCounts } from '~/components/blog/data'
import BaseLayout from '~/layouts/BaseLayout.astro'

/**
 * 设计稿没有标签页的帧 —— 沿用归档页这轮的新结构（内容栏 Page Head + 标签横带
 * + 年份时间轴），只把标题换成 #标签、篇数字数按这个标签下的文章算。
 * 注意 loadPosts 必须来自独立模块：Astro 会把 getStaticPaths 抽出去。
 */
export const getStaticPaths = (async () => {
  const posts = await loadPosts()
  const tags = new Set<string>()
  for (const post of posts) {
    for (const tag of post.tags) tags.add(tag)
  }

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.tags.includes(tag)) },
  }))
}) satisfies GetStaticPaths

const { tag, posts } = Astro.props

const all = await loadPosts()
const words = posts.reduce((sum, post) => sum + post.words, 0)
const groups = groupByYear(posts)
---

<BaseLayout
  title={`#${tag}`}
  description={`标签「${tag}」下的 ${posts.length} 篇文章`}
  rail={false}
>
  {/* 紧凑模式的图标条：sticky 钉住不消失；原版模式不渲染 */}
  <div class="pointer-events-none mb-[24px] hidden xl:sticky xl:top-[16px] xl:z-40 compact:xl:block">
    <div class="pointer-events-auto w-fit"><NavBar /></div>
  </div>

  <div class="flex w-full flex-row items-start gap-[48px]">
    {/* 原版 = 完整 Sidebar（blog.pen 原样）；紧凑 = 无侧栏，内容居中单列（宽 1016） */}
    <div class="hidden w-[280px] shrink-0 classic:xl:block"><Sidebar /></div>

    <div class="flex h-fit w-full min-w-0 flex-col items-start gap-[24px] classic:xl:flex-1 compact:xl:mx-auto compact:xl:max-w-[1016px]">
      <StatsPageHead
        title={`#${tag}`}
        subtitle={`「${tag}」下的文章，按时间倒叙排列。`}
        stats={[
          { value: String(posts.length), label: '篇文章' },
          { value: compactCount(words), label: '累计字数' },
        ]}
      />

      <a
        href="/archive"
        class="glass box-border flex h-fit w-fit shrink-0 flex-row items-center gap-[8px] rounded-[14px] px-[14px] py-[8px]"
      >
        <Icon name="lucide:arrow-left" class="size-[16px] shrink-0 text-ink-soft" />
        <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">返回全部文章</span>
      </a>

      <TagsBand tags={tagCounts(all)} />

      <TimelineCard groups={groups} />
    </div>
  </div>

  <!-- 移动端不显示 Footer：由底部 Tab Bar 取代 -->
  <div class="mt-[30px] hidden w-full xl:block"><Footer /></div>
</BaseLayout>
