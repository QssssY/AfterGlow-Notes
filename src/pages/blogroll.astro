---
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import Sidebar from '~/components/Sidebar.astro'
import StatsPageHead from '~/components/StatsPageHead.astro'
import ApplyPanel from '~/components/blogroll/ApplyPanel.astro'
import type { ImageMetadata } from 'astro'
import BlogCard from '~/components/blogroll/BlogCard.astro'
import { blogroll } from '~/config'
import BaseLayout from '~/layouts/BaseLayout.astro'
import avBilibili from '../../images/blogroll/bilibili.com.png'
import avJuejin from '../../images/blogroll/juejin.cn.png'
import avRuanyifeng from '../../images/blogroll/ruanyifeng.com.png'
import avSspai from '../../images/blogroll/sspai.com.png'
import avZhangxinxu from '../../images/blogroll/zhangxinxu.com.png'
import avZhihu from '../../images/blogroll/zhihu.com.png'

/**
 * 各站真实头像：站方 icon / 博主本人照片，抓取自各站自己发布的资源。
 * config 里的渐变配色保留作退路 —— 以后新增友链没头像也不会缺角。
 */
const avatars: Record<string, ImageMetadata> = {
  'ruanyifeng.com': avRuanyifeng,
  'zhangxinxu.com': avZhangxinxu,
  'sspai.com': avSspai,
  'bilibili.com': avBilibili,
  'juejin.cn': avJuejin,
  'zhihu.com': avZhihu,
}

// 设计稿写的是 18 个 / 9 年；按真实数据算
const total = blogroll.length
const oldest = new Date().getFullYear() - Math.min(...blogroll.map((blog) => blog.since))

// 设计稿是两行定宽三列；移动端按 Home 的规则收成单列
const rows = [blogroll.slice(0, 3), blogroll.slice(3, 6)]
---

<BaseLayout
  title="优秀博客"
  description="长期在读的个人站点。都还在更新，而且写得比我好。"
  rail={false}
>
  {/* 紧凑模式的图标条：sticky 钉住不消失；原版模式不渲染 */}
  <div class="pointer-events-none mb-[24px] hidden xl:sticky xl:top-[16px] xl:z-40 compact:xl:block">
    <div class="pointer-events-auto w-fit"><NavBar /></div>
  </div>

  <div class="flex w-full flex-row items-start gap-[48px]">
    {/* 原版 = 完整 Sidebar（blog.pen 原样）；紧凑 = 无侧栏，内容居中单列（宽 1016） */}
    <div class="hidden w-[280px] shrink-0 classic:xl:block"><Sidebar /></div>

    <div class="flex h-fit w-full min-w-0 flex-col items-start gap-[24px] classic:xl:flex-1 compact:xl:mx-auto compact:xl:max-w-[1016px]">
      <StatsPageHead
        title="优秀博客"
        subtitle="长期在读的个人站点。都还在更新，而且写得比我好。"
        stats={[
          { value: String(total), label: '个友链' },
          { value: String(oldest), label: '年最久' },
        ]}
      />

      <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[24px]">
        {
          rows.map((row) => (
            <div class="flex h-fit w-full shrink-0 flex-col items-stretch gap-[24px] xl:flex-row">
              {row.map((blog) => (
                <BlogCard
                  name={blog.name}
                  initial={blog.initial}
                  href={blog.href}
                  domain={blog.domain}
                  desc={blog.desc}
                  tags={blog.tags}
                  avatar={avatars[blog.domain]}
                  from={blog.from}
                  to={blog.to}
                  initialColor={blog.initialColor}
                />
              ))}
            </div>
          ))
        }

        <ApplyPanel />
      </div>
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block">
    <Footer license="友链长期开放，欢迎自荐 · 萤火录" />
  </div>
</BaseLayout>
