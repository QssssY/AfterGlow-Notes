---
import type { GetStaticPaths } from 'astro'
import { defaultLocale } from '~/i18n/locales'
import { loadPosts } from '~/utils/posts'
import ArchiveView from '~/views/ArchiveView.astro'

// pageSize 写字面量：getStaticPaths 被 Astro 抽成独立模块，取不到这里的常量
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await loadPosts(defaultLocale), { pageSize: 10 })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<ArchiveView page={page} />
