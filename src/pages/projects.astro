---
import Footer from '~/components/Footer.astro'
import ProjectCard from '~/components/ProjectCard.astro'
import RepoStars from '~/components/RepoStars.astro'
import Sidebar from '~/components/Sidebar.astro'
import FeaturedProject from '~/components/projects/FeaturedProject.astro'
import FilterBar from '~/components/projects/FilterBar.astro'
import PageHead from '~/components/projects/PageHead.astro'
import { repoUrl, repos } from '~/config'
import BaseLayout from '~/layouts/BaseLayout.astro'

// repos[0] 是主推项目，进 Featured 卡；其余进下面的网格
const [featured, ...rest] = repos

function relative(iso: string) {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000)
  if (days <= 0) return '今天更新'
  if (days === 1) return '更新于昨天'
  if (days < 30) return `更新于 ${days} 天前`
  if (days < 365) return `更新于 ${Math.floor(days / 30)} 个月前`
  return `更新于 ${Math.floor(days / 365)} 年前`
}

/**
 * 档位从真实数据派生，不照抄设计稿的 ['全部','TypeScript','Rust','Astro','归档'] ——
 * 那批项目本身就是虚构的。等真有归档项目了再给数据加 archived 字段补回来。
 */
const stacks = ['全部', ...new Set(rest.map((repo) => repo.stack))]

// 设计稿写的是 12 仓库 / 868 Star，按真实数据算；Star 总数还会被浏览器端刷新
const totalStars = repos.reduce((sum, repo) => sum + repo.stars, 0)
---

<BaseLayout title="我的项目" rail={false} topPad={72}>
  <div class="flex w-full flex-col items-start gap-[24px] xl:flex-row xl:gap-[48px]">
    <div class="hidden w-[280px] shrink-0 xl:block">
      <Sidebar />
    </div>

    <div class="flex h-fit w-full flex-col items-start gap-[24px] xl:flex-1">
      <FilterBar stacks={stacks} />
      <PageHead
        title="我的项目"
        subtitle="一些自己在用、也顺手开源出来的小东西。多数很小，但都解决过我真实的麻烦。"
        stats={[
          { value: String(repos.length), label: '开源仓库' },
          { value: String(totalStars), label: '累计 Star', total: true },
        ]}
      />
      <FeaturedProject
        badge={featured.badge}
        title={featured.name}
        desc={featured.desc}
        stack={featured.stack}
        stars={featured.stars}
        updated={relative(featured.pushed)}
        repo={featured.repo}
        href={repoUrl(featured.repo)}
      />

      {/*
        设计稿画的是两行定宽三列。这里用单个 flex-wrap 容器代替两个定长行：
        全排满时几何完全一样（1/3 = (100% - 两个 24 间隙) / 3），
        但筛选隐藏卡片后能自然回流，不会留下空洞。
      */}
      <div
        data-project-grid
        data-view="grid"
        class="group/view flex h-fit w-full flex-row flex-wrap items-stretch gap-[24px]"
      >
        {
          rest.map((repo) => (
            <div
              data-project
              data-stack={repo.stack}
              class="flex w-full xl:w-[calc((100%-48px)/3)] xl:group-data-[view=list]/view:w-full"
            >
              <ProjectCard
                title={repo.name}
                desc={repo.desc}
                stack={repo.stack}
                stars={repo.stars}
                repo={repo.repo}
                href={repoUrl(repo.repo)}
                full
              />
            </div>
          ))
        }
        <p data-project-empty hidden class="w-full py-[24px] text-center text-[13px] text-ink-muted">
          这个技术栈下还没有项目。
        </p>
      </div>
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block">
    <Footer license="项目代码以 MIT 授权开源 · 萤火录" />
  </div>

  <RepoStars />
</BaseLayout>

<script>
  const pills = [...document.querySelectorAll<HTMLElement>('[data-filter]')]
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')]
  const grid = document.querySelector<HTMLElement>('[data-project-grid]')
  const empty = document.querySelector<HTMLElement>('[data-project-empty]')

  if (pills.length && cards.length && grid) {
    const ALL = pills[0]!.dataset.filter

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        const want = pill.dataset.filter
        let shown = 0
        for (const card of cards) {
          const hit = want === ALL || card.dataset.stack === want
          card.hidden = !hit
          if (hit) shown++
        }
        for (const p of pills) p.setAttribute('aria-pressed', String(p.dataset.filter === want))
        if (empty) empty.hidden = shown > 0
      })
    }
  }

  // 网格 / 列表：只切容器上的 data-view，宽度由 group-data 变体接管
  const toggles = [...document.querySelectorAll<HTMLElement>('[data-view-set]')]
  if (grid && toggles.length) {
    for (const toggle of toggles) {
      toggle.addEventListener('click', () => {
        const view = toggle.dataset.viewSet!
        grid.dataset.view = view
        for (const t of toggles) t.setAttribute('aria-pressed', String(t.dataset.viewSet === view))
      })
    }
  }
</script>
