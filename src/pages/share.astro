---
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import Sidebar from '~/components/Sidebar.astro'
import StackPill from '~/components/StackPill.astro'
import StatsPageHead from '~/components/StatsPageHead.astro'
import ShareItem from '~/components/share/ShareItem.astro'
import { shareFilters, shareItems } from '~/config'
import { Icon } from 'astro-icon/components'
import BaseLayout from '~/layouts/BaseLayout.astro'

// 设计稿写的是 32 条 / 4 个分类；按真实数据算，等条目攒够了数字自己会长上去
const total = shareItems.length
const categories = new Set(shareItems.map((item) => item.category)).size

// 每页条数：条目攒多了列表拖得老长，切成页（用户点名要翻页）。
// 分页是纯前端的 —— 分类筛选本来就在前端显隐，翻页得跟它联动（每个分类各自分页），
// 走归档页那种静态路由反而做不到。首页之外的条目服务端先 hidden，脚本接手前不闪全列。
const PAGE_SIZE = 8
---

<BaseLayout
  title="推荐分享"
  description="值得反复打开的工具、文章和播客。只收自己真正用过的，不做榜单。"
>
  {/* 紧凑模式的图标条：sticky 钉住不消失；原版模式不渲染 */}
  <div class="pointer-events-none mb-[24px] hidden xl:sticky xl:top-[16px] xl:z-40 compact:xl:block">
    <div class="pointer-events-auto w-fit"><NavBar /></div>
  </div>

  <div class="flex w-full flex-row items-start gap-[48px]">
    {/* 原版 = 完整 Sidebar（blog.pen 原样）；紧凑 = 无侧栏，内容居中单列（宽 1016） */}
    <div class="hidden w-[280px] shrink-0 classic:xl:block"><Sidebar /></div>

    <div class="flex h-fit w-full min-w-0 flex-col items-start gap-[24px] classic:xl:flex-1 compact:xl:mx-auto compact:xl:max-w-[1016px]">
      <StatsPageHead
        title="推荐分享"
        subtitle="值得反复打开的工具、文章和播客。只收自己真正用过的，不做榜单。"
        stats={[
          { value: String(total), label: '条收录' },
          { value: String(categories), label: '个分类' },
        ]}
      />

      <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[24px]">
        {/* data-share-top：翻页后把视线拉回的锚点；scroll-mt 给顶上留口气 */}
        <div
          data-share-top
          class="flex h-[38px] w-full shrink-0 scroll-mt-[24px] flex-row items-center justify-between gap-[12px]"
        >
          <div
            class="flex h-fit w-fit shrink-0 flex-row items-center gap-[7px] overflow-x-auto xl:overflow-visible"
          >
            {shareFilters.map((label, i) => <StackPill label={label} active={i === 0} />)}
          </div>

          <div class="hidden h-fit w-fit shrink-0 flex-row items-center gap-[7px] xl:flex">
            <Icon name="lucide:bookmark" class="size-[14px] shrink-0 text-ink-muted" />
            <span class="text-[12.5px] font-normal whitespace-nowrap text-ink-muted">
              共 <span data-share-count>{total}</span> 条收藏
            </span>
          </div>
        </div>

        <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[14px]">
          {
            shareItems.map((item, i) => (
              <ShareItem
                title={item.title}
                desc={item.desc}
                href={item.href}
                domain={item.domain}
                icon={item.icon}
                tone={item.tone}
                category={item.category}
                hidden={i >= PAGE_SIZE}
              />
            ))
          }
          <p data-share-empty hidden class="w-full py-[24px] text-center text-[13px] text-ink-muted">
            这个分类还没有收录。
          </p>
        </div>

        {/* 翻页 —— 皮肤对齐归档页 blog/Pagination.astro（38px 方块 / 品牌色当前页 / ‹›）。
            按钮由脚本按「当前筛选」现算现填；只有一页时整块藏起 */}
        <div
          data-share-pager
          data-page-size={PAGE_SIZE}
          hidden={total <= PAGE_SIZE}
          class="flex w-full shrink-0 flex-col items-center gap-[10px]"
        >
          <nav
            aria-label="分页"
            data-share-pages
            class="flex min-h-[38px] w-full flex-row flex-wrap items-center justify-center gap-[8px]"
          ></nav>
          <span
            data-share-pageinfo
            class="text-[12px] font-normal whitespace-nowrap text-ink-muted"
          >
            共 {total} 条 · 第 1 / {Math.ceil(total / PAGE_SIZE)} 页
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block">
    <Footer license="外链内容版权归原作者所有 · 余晖录" />
  </div>
</BaseLayout>

<script>
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    // 纯前端筛选 + 分页：先按分类筛，再切页 —— 两个操作共用一份 render()。
    // 「全部」是 shareFilters 的第一项；换分类回到第 1 页
    const pills = [...document.querySelectorAll<HTMLElement>('[data-filter]')]
    const items = [...document.querySelectorAll<HTMLElement>('[data-share-item]')]
    const count = document.querySelector<HTMLElement>('[data-share-count]')
    const empty = document.querySelector<HTMLElement>('[data-share-empty]')
    const pager = document.querySelector<HTMLElement>('[data-share-pager]')
    const pagesBox = document.querySelector<HTMLElement>('[data-share-pages]')
    const pageInfo = document.querySelector<HTMLElement>('[data-share-pageinfo]')
    const listTop = document.querySelector<HTMLElement>('[data-share-top]')
    if (pills.length === 0 || items.length === 0) return

    const PAGE_SIZE = Number(pager?.dataset.pageSize) || 8
    const ALL = pills[0]!.dataset.filter
    let filter = ALL
    let page = 1

    // 分页块的皮 —— 类名逐字照抄 blog/Pagination.astro，两页视觉必须一致；
    // 那边是静态 <a>，这边页数跟着筛选变，只能脚本现建 <button>
    const BOX =
      'flex size-[38px] shrink-0 flex-row items-center justify-center rounded-[12px] text-[13.5px] font-bold'
    const IDLE = 'bg-card text-ink-soft outline-[1.5px] -outline-offset-[0.75px] outline-card-border'
    const ON = 'bg-brand text-on-brand outline-[1.5px] -outline-offset-[0.75px] outline-brand'
    const TAP =
      'cursor-pointer transition-[translate,background-color,scale] hover:-translate-y-[1px] hover:bg-card-solid active:scale-95'

    /** 首页、末页、当前页 ±1，中间断开处用 …（同 Pagination.astro） */
    const pageList = (current: number, totalPages: number): (number | 'gap')[] => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1)
      const keep = new Set([1, totalPages, current, current - 1, current + 1])
      const out: (number | 'gap')[] = []
      let gap = false
      for (let p = 1; p <= totalPages; p += 1) {
        if (keep.has(p)) {
          out.push(p)
          gap = false
        } else if (!gap) {
          out.push('gap')
          gap = true
        }
      }
      return out
    }

    /** target=null 且非当前页 = 失效箭头（减淡不可点，对应归档页的 span 版） */
    const button = (label: string, aria: string | null, target: number | null, on = false) => {
      const b = document.createElement('button')
      b.type = 'button'
      b.textContent = label
      if (aria) b.setAttribute('aria-label', aria)
      if (on) {
        b.className = `${BOX} ${ON}`
        b.setAttribute('aria-current', 'page')
        b.disabled = true
      } else if (target === null) {
        b.className = `${BOX} ${IDLE} opacity-[0.4]`
        b.disabled = true
      } else {
        b.className = `${BOX} ${IDLE} ${TAP}`
        b.addEventListener('click', () => goto(target))
      }
      return b
    }

    const gapSpan = () => {
      const s = document.createElement('span')
      s.className = `${BOX} ${IDLE}`
      s.textContent = '…'
      return s
    }

    const render = (replay: boolean) => {
      const hits = items.filter((it) => filter === ALL || it.dataset.category === filter)
      const totalPages = Math.max(1, Math.ceil(hits.length / PAGE_SIZE))
      if (page > totalPages) page = totalPages
      const slice = hits.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
      const shown = new Set(slice)
      for (const it of items) it.hidden = !shown.has(it)

      if (replay) {
        // 重放入场弹跳（global.css 的 card-enter）。display:none 恢复本来就会重播，
        // 但换页后留在原位的卡不会动、且各卡还带着整页入场的 --enter-i 长延迟 ——
        // 统一重置 + 错峰收紧到 40ms/张，局部更新不必像整页入场那样慢慢排队
        for (const it of slice) it.style.animation = 'none'
        void slice[0]?.offsetWidth
        slice.forEach((it, i) => {
          it.style.animation = ''
          it.style.animationDelay = `${i * 40}ms`
        })
      }

      for (const pill of pills) {
        pill.setAttribute('aria-pressed', String(pill.dataset.filter === filter))
      }
      if (count) count.textContent = String(hits.length)
      if (empty) empty.hidden = hits.length > 0

      if (pager && pagesBox && pageInfo) {
        pager.hidden = totalPages <= 1
        pageInfo.textContent = `共 ${hits.length} 条 · 第 ${page} / ${totalPages} 页`
        pagesBox.replaceChildren(
          button('‹', '上一页', page > 1 ? page - 1 : null),
          ...pageList(page, totalPages).map((p) =>
            p === 'gap' ? gapSpan() : button(String(p), null, p === page ? null : p, p === page),
          ),
          button('›', '下一页', page < totalPages ? page + 1 : null),
        )
      }
    }

    const goto = (next: number) => {
      page = next
      render(true)
      // 从底部的分页块跳完页把视线拉回列表开头；html 的 scroll-behavior 管平滑，
      // 减少动态时那条规则不生效、自动变直达
      listTop?.scrollIntoView(true)
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        filter = pill.dataset.filter
        page = 1
        render(true)
      })
    }

    // 首屏：服务端已按第 1 页渲染好显隐，这里只补分页按钮，不重放入场（让整页错峰自己跑）
    render(false)
  })
</script>
