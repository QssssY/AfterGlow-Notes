---
import type { GetStaticPaths } from 'astro'
import { defaultLocale } from '~/i18n/locales'
import { postRoutes } from '~/utils/posts'
import PostView from '~/views/PostView.astro'

// 网址片段是与语种无关的文章身份（en/hello-world.md 也走 /posts/hello-world）
export const getStaticPaths = (async () => postRoutes(defaultLocale)) satisfies GetStaticPaths

const { post, related, older, newer } = Astro.props
---

<PostView post={post} related={related} older={older} newer={newer} />
