---
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import ArticleActions from '~/components/post/ArticleActions.astro'
import ArticleInfo from '~/components/post/ArticleInfo.astro'
import LicenseBlock from '~/components/post/LicenseBlock.astro'
import PrevNext from '~/components/post/PrevNext.astro'
import ReadingProgress from '~/components/post/ReadingProgress.astro'
import RelatedCard from '~/components/post/RelatedCard.astro'
import TocCard from '~/components/post/TocCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { postStats } from '~/utils/post'

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  )

  return posts.map((post, i) => {
    /**
     * 左栏「相关 RELATED」：和本篇有共同标签的文章，取最近三篇。
     * posts 已经是时间倒序，filter 不改顺序，所以 slice 出来就是最近的三篇。
     * 在这里算而不是在组件里：这里本来就握着全部文章，组件不必再查一次集合。
     */
    const tags = new Set(post.data.tags)
    const related = posts
      .filter((other) => other.id !== post.id && other.data.tags.some((tag) => tags.has(tag)))
      .slice(0, 3)
      .map((other) => ({
        title: other.data.title,
        href: `/posts/${other.id}`,
        date: other.data.date,
      }))

    return {
      params: { slug: post.id },
      props: {
        post,
        related,
        // 数组是时间倒序：下一项更旧 = 上一篇，上一项更新 = 下一篇
        older: posts[i + 1],
        newer: posts[i - 1],
      },
    }
  })
}

const { post, related, older, newer } = Astro.props
const { Content, headings } = await render(post)
const stats = postStats(post.body ?? '')

const date = post.data.date
const dateLabel = `${date.getFullYear()} 年 ${date.getMonth() + 1} 月 ${date.getDate()} 日`

const entry = (p: typeof post | undefined) =>
  p ? { title: p.data.title, href: `/posts/${p.id}` } : undefined

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
const permalink = `${new URL(Astro.site ?? Astro.url).host}${Astro.url.pathname}`
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogSlug={post.id}
  ogType="article"
  publishedAt={post.data.date}
  rail={false}
>
  <ReadingProgress />

  {/* 结构照搬 YYsuni：内容页没有整根侧栏，导航缩成顶部图标条（随页滚走） */}
  <div class="mb-[24px] hidden xl:block"><NavBar /></div>

  <div class="flex w-full flex-col items-start gap-[20px] xl:flex-row xl:gap-[48px]">
    <!--
      左栏（纯桌面）就是 YYsuni 文章页那根短栏：目录+本文+相关，
      整栏一屏装得下（目录内部限高 300 自滚），简单 sticky top-48 ——
      从不钉超过一屏的东西。
      移动端整栏不渲染：导航由底部 TabBar 代替，本文/相关摆到 390 下
      就成了正文前的一大段前言；目录单独在返回按钮之后再出一份（见下）。
    -->
    <div
      data-pin-group
      class="hidden w-[280px] shrink-0 flex-col items-start gap-[24px] xl:sticky xl:top-[48px] xl:flex"
    >
      <TocCard headings={headings} />
      <ArticleInfo
        words={stats.words}
        minutes={stats.minutes}
        date={date}
        updated={post.data.updated}
      />
      <RelatedCard posts={related} />
    </div>

    <div class="flex h-fit w-full flex-col items-start gap-[20px] xl:flex-1">
      <a
        href="/archive"
        class="glass box-border flex h-fit w-fit shrink-0 flex-row items-center gap-[8px] rounded-[14px] px-[14px] py-[8px]"
      >
        <Icon name="lucide:arrow-left" class="size-[16px] shrink-0 text-ink-soft" />
        <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">返回文章列表</span>
      </a>

      {/* 移动端目录：排在返回按钮之后、正文之前（用户点名的顺序）；桌面版在左栏里 */}
      <div class="w-full xl:hidden"><TocCard headings={headings} /></div>

      <!-- data-pagefind-* 告诉索引器只收正文，并把标题/日期存进搜索结果 -->
      <article
        data-pagefind-body
        class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[22px] rounded-[34px] p-[20px] xl:p-[36px]"
      >
        {
          post.data.cover && (
            <Image
              src={post.data.cover}
              alt=""
              class="h-[300px] w-full shrink-0 rounded-[22px] object-cover"
            />
          )
        }

        <header class="flex h-fit w-full shrink-0 flex-col items-start gap-[12px]">
          {
            post.data.tags.length > 0 && (
              <div class="flex h-fit w-fit shrink-0 flex-row flex-wrap items-center gap-[8px]">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class="flex h-fit w-fit shrink-0 flex-row rounded-[12px] bg-fire-tint px-[11px] py-[5px]"
                  >
                    <span class="text-[12px] font-medium whitespace-nowrap text-brand-ink">
                      #{tag}
                    </span>
                  </a>
                ))}
              </div>
            )
          }

          <h1
            data-pagefind-meta="title"
            class="font-display w-full text-[28px]/[40px] font-normal text-ink xl:text-[38px]/[51px]"
          >
            {post.data.title}
          </h1>

          <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[10px]">
            <time
              datetime={date.toISOString()}
              data-pagefind-meta={`date:${dateLabel}`}
              class="text-[12px] font-normal whitespace-nowrap text-ink-muted"
            >
              {dateLabel}
            </time>
            <span class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
            <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
              阅读约 {stats.minutes} 分钟
            </span>
            {/* 字数这轮挪进了左栏的 ARTICLE 面板，这行不再重复 */}
            {/* 设计稿第三格是「2,148 次阅读」：数字来自 Go 后端，没配后端就整块不出现 */}
            <span data-views hidden class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
            <span
              data-views
              data-views-label
              hidden
              class="text-[12px] font-normal whitespace-nowrap text-ink-muted"></span>
          </div>
        </header>

        <span class="h-[1px] w-full shrink-0 bg-hairline"></span>

        {/* 摘要不在正文里，但它是很自然的搜索目标 —— 单独喂给索引器 */}
        {post.data.description && <span class="sr-only">{post.data.description}</span>}

        <div class="article-body"><Content /></div>

        <span class="h-[1px] w-full shrink-0 bg-hairline"></span>

        <ArticleActions slug={post.id} updated={post.data.updated} />
      </article>

      <LicenseBlock
        permalink={permalink}
        shareUrl={shareUrl}
        title={post.data.title}
        updated={post.data.updated}
      />

      <PrevNext prev={entry(older)} next={entry(newer)} />
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block"><Footer /></div>
</BaseLayout>

<script>
  // 记一次阅读并回填「N 次阅读」。slug 从点赞按钮身上拿（同一篇文章）。
  // 后端没配 / 没应答时 postView 返回 null，两个 span 保持 hidden —— 不编数字。
  import { postView } from '~/scripts/api'

  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化（进别的文章也算一次阅读）
  document.addEventListener('astro:page-load', () => {
    const slug = document.querySelector<HTMLElement>('[data-like-slug]')?.dataset.likeSlug
    if (slug) {
      postView(slug).then((res) => {
        if (!res || res.count <= 0) return
        const label = document.querySelector<HTMLElement>('[data-views-label]')
        // 设计稿写法带千分位：2,148 次阅读
        if (label) label.textContent = `${res.count.toLocaleString('en-US')} 次阅读`
        for (const el of document.querySelectorAll('[data-views]')) el.removeAttribute('hidden')
      })
    }
  })
</script>
