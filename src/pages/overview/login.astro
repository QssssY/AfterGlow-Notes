---
import { apiBase } from '~/config'
import AdminLayout from '~/layouts/AdminLayout.astro'

// 纯静态形态（没配 PUBLIC_API_BASE）没有数据服务，管理台整个不存在 ——
// 给 fork 后一键托管的人一个明白话，别让他们对着登录框猜口令
const staticOnly = apiBase === null
---

<AdminLayout title="登录" guard={false}>
  <div class="flex flex-1 items-center justify-center">
    {staticOnly && (
      <div class="ad-card flex w-full max-w-[460px] flex-col gap-[10px] p-[32px]">
        <span class="font-display text-[22px] text-ink">这个部署没有管理台</span>
        <span class="ad-hint">
          当前是纯静态托管（未配置 PUBLIC_API_BASE），管理台需要配套的 Go 数据服务。
          改内容的方式：直接在 GitHub 网页上编辑仓库文件（src/data/*.json 与
          src/content/posts/），提交后托管平台会自动重新构建上线 ——
          详见仓库 docs/easy-deploy.md。
        </span>
      </div>
    )}
    {!staticOnly && (
    <form data-login class="ad-card flex w-full max-w-[380px] flex-col gap-[16px] p-[32px]">
      <div class="flex flex-col gap-[6px]">
        <span class="font-display text-[22px] text-ink">管理台</span>
        <span class="ad-hint">口令是启动数据服务时 -admin-pass 设的那个</span>
      </div>

      <label class="flex flex-col">
        <span class="ad-label">口令</span>
        <input
          class="ad-input"
          type="password"
          name="password"
          autocomplete="current-password"
          autofocus
          required
        />
      </label>

      <button type="submit" class="ad-btn-primary justify-center">进入</button>
    </form>
    )}
  </div>
</AdminLayout>

<script>
  import { API, getToken, report, setToken } from '~/scripts/admin'

  // 已登录就直接进去（token 若已过期，里面的第一个请求会把人送回来）
  if (getToken()) location.replace('/overview')

  const form = document.querySelector<HTMLFormElement>('[data-login]')!
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const password = new FormData(form).get('password')
    try {
      const res = await fetch(`${API}/api/overview/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      }).catch(() => {
        throw new Error(`连不上数据服务（${API}）——先把 server/ 跑起来`)
      })
      const data = (await res.json().catch(() => null)) as { token?: string; error?: string } | null
      if (!res.ok || !data?.token) throw new Error(data?.error ?? `登录失败（HTTP ${res.status}）`)
      setToken(data.token)
      location.replace('/overview')
    } catch (err) {
      report(err)
    }
  })
</script>
