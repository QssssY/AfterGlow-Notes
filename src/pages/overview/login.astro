---
import { apiBase } from '~/config'
import AdminLayout from '~/layouts/AdminLayout.astro'

// 双后端登录：配了 PUBLIC_API_BASE 走 Go 服务（口令）；没配 = GitHub 直连模式
// （细粒度令牌）—— 无服务器的 fork 也有完整管理台，保存即提交、平台自动重建。
const ghMode = apiBase === null
// 一键托管平台构建时能自动识别仓库（astro.config.mjs 里推导），识别不到就手填
const ghRepoDefault = import.meta.env.PUBLIC_GITHUB_REPO ?? ''
---

<AdminLayout title="登录" guard={false}>
  <div class="flex flex-1 items-center justify-center">
    {
      ghMode ? (
        <form data-login-gh class="ad-card flex w-full max-w-[440px] flex-col gap-[16px] p-[32px]">
          <div class="flex flex-col gap-[6px]">
            <span class="font-display text-[22px] text-ink">管理台 · GitHub 直连</span>
            <span class="ad-hint">
              这个部署没有服务器，管理台直接读写你的 GitHub 仓库：保存 = 提交 =
              托管平台自动重建（1~3 分钟生效）。令牌只存本浏览器会话，关闭即忘。
            </span>
          </div>

          <label class="flex flex-col">
            <span class="ad-label">仓库（owner/repo）</span>
            <input
              class="ad-input"
              type="text"
              name="repo"
              placeholder="你的用户名/仓库名"
              value={ghRepoDefault}
              autocomplete="off"
              spellcheck="false"
              required
            />
          </label>

          <label class="flex flex-col">
            <span class="ad-label">细粒度访问令牌（PAT）</span>
            <input
              class="ad-input"
              type="password"
              name="token"
              autocomplete="off"
              autofocus
              required
            />
          </label>

          <span class="ad-hint">
            生成令牌：GitHub 头像 → Settings → Developer settings →
            <b>Fine-grained tokens</b> → Generate new token —— Repository access 选
            <b>Only select repositories</b>（只勾这个仓库），Permissions 里把
            <b>Contents</b> 设为 <b>Read and write</b>，其余都不要。
          </span>

          <button type="submit" class="ad-btn-primary justify-center">验证并进入</button>
        </form>
      ) : (
        <form data-login class="ad-card flex w-full max-w-[380px] flex-col gap-[16px] p-[32px]">
          <div class="flex flex-col gap-[6px]">
            <span class="font-display text-[22px] text-ink">管理台</span>
            <span class="ad-hint">口令是启动数据服务时 -admin-pass 设的那个</span>
          </div>

          <label class="flex flex-col">
            <span class="ad-label">口令</span>
            <input
              class="ad-input"
              type="password"
              name="password"
              autocomplete="current-password"
              autofocus
              required
            />
          </label>

          <button type="submit" class="ad-btn-primary justify-center">进入</button>
        </form>
      )
    }
  </div>
</AdminLayout>

<script>
  import { API, getToken, ghMode, report, setToken } from '~/scripts/admin'
  import { ghSaveAuth, ghVerify } from '~/scripts/gh-cms'

  // 已登录就直接进去（凭证若已失效，里面的第一个请求会把人送回来）
  if (getToken()) location.replace('/overview')

  if (ghMode) {
    const form = document.querySelector<HTMLFormElement>('[data-login-gh]')!
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fd = new FormData(form)
      const repo = String(fd.get('repo') ?? '').trim().replace(/^https:\/\/github\.com\//, '')
      const token = String(fd.get('token') ?? '').trim()
      if (!/^[\w.-]+\/[\w.-]+$/.test(repo)) {
        report(new Error('仓库要写成 owner/repo 的形式，例如 QssssY/AfterGlow-Notes'))
        return
      }
      try {
        await ghVerify(repo, token)
        ghSaveAuth(repo, token)
        location.replace('/overview')
      } catch (err) {
        report(err)
      }
    })
  } else {
    const form = document.querySelector<HTMLFormElement>('[data-login]')!
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const password = new FormData(form).get('password')
      try {
        const res = await fetch(`${API}/api/overview/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        }).catch(() => {
          throw new Error(`连不上数据服务（${API}）——先把 server/ 跑起来`)
        })
        const data = (await res.json().catch(() => null)) as { token?: string; error?: string } | null
        if (!res.ok || !data?.token) throw new Error(data?.error ?? `登录失败（HTTP ${res.status}）`)
        setToken(data.token)
        location.replace('/overview')
      } catch (err) {
        report(err)
      }
    })
  }
</script>
