---
/**
 * 写文章 —— 布局与手感照搬 YYsuni/2025-blog-public 的 write 后台：
 * 主编辑卡（标题+slug 一行、巨型正文框）+ 320px 侧栏（封面 / 元信息 / 插图
 * 三段错峰入场）+ 顶部悬浮操作组；预览是「就地整屏切换」而不是原来的
 * 卡内切换。编辑手感三件：Ctrl+B/I/K 与 Tab 缩进（execCommand 保撤销栈）、
 * 粘贴或拖拽图片直接上传插入、标签是胶囊式输入。
 * 数据流不变：读写走 /api/overview/posts/{slug}，图片走 /api/overview/upload。
 */
import AdminLayout from '~/layouts/AdminLayout.astro'
---

<AdminLayout title="写文章" active="posts">
  <div class="flex flex-wrap items-center justify-between gap-[10px]">
    <div class="flex items-center gap-[10px]">
      <h1 data-head class="font-display text-[22px] text-ink">写新文章</h1>
      <span data-mode-badge hidden class="ad-chip ad-chip--draft">编辑模式</span>
    </div>
    <div class="flex items-center gap-[8px]">
      <a data-view hidden class="ad-btn-ghost" target="_blank" rel="noopener">在站点里看 ↗</a>
      <button type="button" data-md-import class="ad-btn-ghost">导入 MD</button>
      <button type="button" data-preview-toggle class="ad-btn-ghost" aria-pressed="false">预览</button>
      <button type="button" data-save class="ad-btn-primary">保存（Ctrl+S）</button>
      <input type="file" data-md-file accept=".md,.markdown,.txt" hidden />
    </div>
  </div>

  <!-- 写作区：主编辑卡 + 侧栏（YYsuni write 布局） -->
  <div data-write class="flex flex-col items-start gap-[20px] xl:flex-row">
    <section class="ad-card flex w-full min-w-0 flex-1 flex-col gap-[12px] p-[24px]">
      <div class="flex flex-col gap-[12px] xl:flex-row">
        <input class="ad-input xl:flex-1" data-f="title" placeholder="标题" />
        {/* ad-input 自带 width:100%（无层级样式压得过 xl:w-* 工具类），
            所以用 max-w 收住 slug —— 它没被 .ad-input 占用，能正常生效 */}
        <input class="ad-input ad-mono xl:max-w-[240px]" data-f="slug" placeholder="slug（my-first-post）" />
      </div>
      <textarea
        class="ad-textarea ad-mono min-h-[62vh] flex-1"
        data-f="body"
        placeholder="## 从这里开始写&#10;&#10;支持全部 Markdown 语法。图片直接粘贴或拖进来，会自动上传并插到光标处；&#10;Ctrl+B 加粗 · Ctrl+I 斜体 · Ctrl+K 链接 · Tab 缩进 · Ctrl+S 保存。"></textarea>
      <p class="ad-hint">
        语法备忘：<code>## 小标题</code>、<code>**加粗**</code>、<code>[文字](链接)</code>、
        <code>```ts</code> 开代码块、<code>&gt; 引用</code>。预览是快速排版检查（marked 渲染），正式效果以文章页为准。
      </p>
    </section>

    <div class="flex w-full shrink-0 flex-col gap-[20px] xl:w-[320px]">
      <section class="ad-card flex flex-col gap-[12px] p-[20px]">
        <span class="text-[14px] font-medium text-ink">封面</span>
        <div data-cover-drop class="ad-drop">
          <span data-cover-empty>点击选择，或把图片拖进来</span>
          <span data-cover-name hidden class="ad-chip"></span>
        </div>
        <button type="button" class="ad-btn-danger self-start" data-cover-clear hidden>去掉封面</button>
        <input type="file" data-cover-file accept="image/*" hidden />
      </section>

      <section class="ad-card flex flex-col gap-[12px] p-[20px]">
        <span class="text-[14px] font-medium text-ink">元信息</span>
        <textarea class="ad-textarea" rows="3" data-f="description" placeholder="为这篇文章写一段简短摘要（列表和 SEO 用，可空）"></textarea>

        <div data-tagbox class="ad-tagbox">
          <input data-tag-input placeholder="添加标签（回车确认）" />
        </div>

        <input class="ad-input" data-f="category" placeholder="分类（可空，如：前端工程）" />

        <div class="grid grid-cols-2 gap-[10px]">
          <label class="flex flex-col">
            <span class="ad-label">日期</span>
            <input class="ad-input" type="date" data-f="date" />
          </label>
          <label class="flex flex-col">
            <span class="ad-label">更新于（可空）</span>
            <input class="ad-input" type="date" data-f="updated" />
          </label>
        </div>

        <label class="flex cursor-pointer items-center gap-[8px] text-[13px] text-ink select-none">
          <input type="checkbox" class="ad-check" data-f="draft" />
          存成草稿（不出现在站点上）
        </label>
      </section>

      <section class="ad-card flex flex-col gap-[10px] p-[20px]">
        <span class="text-[14px] font-medium text-ink">插图</span>
        <button type="button" class="ad-btn-ghost self-start" data-img-pick>选择图片插入正文</button>
        <p class="ad-hint">更快的方式：截图后直接在正文里 Ctrl+V，或把图片文件拖到正文框上。</p>
        <input type="file" data-img-file accept="image/*" multiple hidden />
      </section>
    </div>
  </div>

  <!-- 就地全屏预览（YYsuni WritePreview 式）：整个写作区让位给渲染结果 -->
  <section data-preview-panel hidden class="ad-card p-[24px] xl:p-[40px]">
    <div class="ad-prose mx-auto max-w-[820px]" data-preview></div>
  </section>
</AdminLayout>

<script>
  import { marked } from 'marked'
  import {
    $,
    api,
    apiRead,
    cacheDrop,
    ETAG_ABSENT,
    isConflict,
    report,
    SLUG_RE,
    toast,
    today,
  } from '~/scripts/admin'
  import type { PostMeta } from '~/scripts/admin'

  const field = (k: string) => $(`[data-f="${k}"]`) as HTMLInputElement | HTMLTextAreaElement

  const slugInput = field('slug') as HTMLInputElement
  const body = field('body') as HTMLTextAreaElement
  const viewLink = $<HTMLAnchorElement>('[data-view]')

  let editing = new URLSearchParams(location.search).get('slug') ?? ''
  let cover = ''
  let tags: string[] = []
  let dirty = false

  document.addEventListener('input', () => (dirty = true))
  window.addEventListener('beforeunload', (e) => {
    if (dirty) e.preventDefault()
  })

  // ---- 光标处插入：优先 execCommand —— 它走浏览器编辑管线，Ctrl+Z 撤销栈不断 ----
  function insertText(text: string) {
    body.focus()
    if (!document.execCommand('insertText', false, text)) {
      const { selectionStart, selectionEnd, value } = body
      body.value = value.slice(0, selectionStart) + text + value.slice(selectionEnd)
      const at = selectionStart + text.length
      body.setSelectionRange(at, at)
      dirty = true
    }
  }

  // ---- Markdown 快捷键（照搬 YYsuni：B/I 可加可解，K 选中 url 待替换，Tab 缩进）----
  const DEFAULT_TEXT = '文字'
  body.addEventListener('keydown', (e) => {
    const { selectionStart, selectionEnd, value } = body
    const selected = value.slice(selectionStart, selectionEnd)

    const toggleWrap = (mark: string) => {
      e.preventDefault()
      const before = value.slice(0, selectionStart)
      const after = value.slice(selectionEnd)
      // 已经包着同款记号：把记号连着选中一起替换回纯文本
      if (selected && before.endsWith(mark) && after.startsWith(mark)) {
        body.setSelectionRange(selectionStart - mark.length, selectionEnd + mark.length)
        insertText(selected)
        return
      }
      const text = selected || DEFAULT_TEXT
      insertText(`${mark}${text}${mark}`)
      if (!selected) {
        // 没选中就给占位词，插完选中它 —— 直接打字覆盖
        setTimeout(() => {
          body.setSelectionRange(selectionStart + mark.length, selectionStart + mark.length + DEFAULT_TEXT.length)
        }, 0)
      }
    }

    if ((e.ctrlKey || e.metaKey) && e.key === 'b') return toggleWrap('**')
    if ((e.ctrlKey || e.metaKey) && e.key === 'i') return toggleWrap('*')

    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault()
      const text = selected || DEFAULT_TEXT
      insertText(`[${text}](url)`)
      setTimeout(() => {
        const urlStart = selectionStart + text.length + 3
        body.setSelectionRange(urlStart, urlStart + 3)
      }, 0)
      return
    }

    if (e.key === 'Tab' && !e.shiftKey) {
      e.preventDefault()
      insertText('\t')
      return
    }
    if (e.key === 'Tab' && e.shiftKey) {
      e.preventDefault()
      const lineStart = value.lastIndexOf('\n', selectionStart - 1) + 1
      const lineEnd = value.indexOf('\n', selectionStart)
      const line = value.slice(lineStart, lineEnd === -1 ? undefined : lineEnd)
      const eat = line.startsWith('\t') ? 1 : line.startsWith('  ') ? 2 : 0
      if (eat > 0) {
        body.setSelectionRange(lineStart, lineStart + eat)
        insertText('')
      }
    }
  })

  // ---- 图片：按钮 / 粘贴 / 拖拽 三条路汇到同一个上传（内容寻址去重在服务端）----
  async function uploadIntoBody(files: File[]) {
    const images = files.filter((f) => f.type.startsWith('image/'))
    if (images.length === 0) return
    for (const file of images) {
      const fd = new FormData()
      fd.append('kind', 'image')
      fd.append('file', file)
      try {
        const res = await api<{ path: string }>('/api/overview/upload', { method: 'POST', body: fd })
        insertText(`\n![](${res.path})\n`)
      } catch (err) {
        report(err)
        return
      }
    }
    toast(images.length > 1 ? `已插入 ${images.length} 张图片` : '图片已插入正文')
  }

  const imgFile = $<HTMLInputElement>('[data-img-file]')
  $('[data-img-pick]').addEventListener('click', () => imgFile.click())
  imgFile.addEventListener('change', async () => {
    await uploadIntoBody([...(imgFile.files ?? [])])
    imgFile.value = ''
  })

  body.addEventListener('paste', (e) => {
    const files = [...(e.clipboardData?.items ?? [])]
      .filter((it) => it.type.startsWith('image/'))
      .map((it) => it.getAsFile())
      .filter((f): f is File => f !== null)
    if (files.length > 0) {
      e.preventDefault()
      uploadIntoBody(files)
    }
  })
  body.addEventListener('dragover', (e) => e.preventDefault())
  body.addEventListener('drop', (e) => {
    const files = [...(e.dataTransfer?.files ?? [])]
    if (files.some((f) => f.type.startsWith('image/'))) {
      e.preventDefault()
      uploadIntoBody(files)
    }
  })

  // ---- 标签：胶囊输入（回车/逗号添加，× 或空输入退格删除）----
  const tagbox = $('[data-tagbox]')
  const tagInput = $<HTMLInputElement>('[data-tag-input]')

  function renderTags() {
    for (const chip of tagbox.querySelectorAll('.ad-tag')) chip.remove()
    for (const [i, t] of tags.entries()) {
      const chip = document.createElement('span')
      chip.className = 'ad-tag'
      chip.append(`#${t}`)
      const x = document.createElement('button')
      x.type = 'button'
      x.textContent = '×'
      x.addEventListener('click', () => {
        tags.splice(i, 1)
        dirty = true
        renderTags()
      })
      chip.append(x)
      tagbox.insertBefore(chip, tagInput)
    }
  }
  function addTag() {
    const t = tagInput.value.trim().replace(/^#/, '')
    if (t && !tags.includes(t)) {
      tags.push(t)
      dirty = true
      renderTags()
    }
    tagInput.value = ''
  }
  tagbox.addEventListener('click', () => tagInput.focus())
  tagInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',' || e.key === '，') {
      e.preventDefault()
      addTag()
    }
    if (e.key === 'Backspace' && tagInput.value === '' && tags.length > 0) {
      tags.pop()
      dirty = true
      renderTags()
    }
  })
  tagInput.addEventListener('blur', addTag)

  // ---- 封面：点击或拖拽（按 slug 命名存 _covers/，所以要先有 slug）----
  const coverDrop = $('[data-cover-drop]')
  const coverFile = $<HTMLInputElement>('[data-cover-file]')

  function showCover() {
    $('[data-cover-empty]').hidden = !!cover
    const name = $('[data-cover-name]')
    name.hidden = !cover
    name.textContent = cover.replace('./_covers/', '')
    $('[data-cover-clear]').hidden = !cover
  }
  function slugReady(): string | null {
    const slug = slugInput.value.trim()
    if (!SLUG_RE.test(slug)) {
      toast('先把 slug 填好 —— 封面文件按 slug 命名存进 _covers/', false)
      slugInput.focus()
      return null
    }
    return slug
  }
  async function uploadCover(file: File) {
    const slug = slugReady()
    if (!slug) return
    const fd = new FormData()
    fd.append('kind', 'cover')
    fd.append('slug', slug)
    fd.append('file', file)
    try {
      const res = await api<{ path: string }>('/api/overview/upload', { method: 'POST', body: fd })
      cover = res.path
      dirty = true
      showCover()
      toast('封面已上传，保存后生效')
    } catch (err) {
      report(err)
    }
  }
  coverDrop.addEventListener('click', () => {
    if (slugReady()) coverFile.click()
  })
  coverDrop.addEventListener('dragover', (e) => {
    e.preventDefault()
    coverDrop.toggleAttribute('data-over', true)
  })
  coverDrop.addEventListener('dragleave', () => coverDrop.toggleAttribute('data-over', false))
  coverDrop.addEventListener('drop', (e) => {
    e.preventDefault()
    coverDrop.toggleAttribute('data-over', false)
    const file = [...(e.dataTransfer?.files ?? [])].find((f) => f.type.startsWith('image/'))
    if (file) uploadCover(file)
  })
  coverFile.addEventListener('change', async () => {
    const file = coverFile.files?.[0]
    if (file) await uploadCover(file)
    coverFile.value = ''
  })
  $('[data-cover-clear]').addEventListener('click', () => {
    cover = ''
    dirty = true
    showCover()
  })

  // ---- 就地全屏预览：写作区整个让位（YYsuni WritePreview 的手感）----
  const writeWrap = $('[data-write]')
  const previewPanel = $('[data-preview-panel]')
  const previewBtn = $('[data-preview-toggle]')
  previewBtn.addEventListener('click', () => {
    const showing = previewPanel.hidden
    if (showing) {
      $('[data-preview]').innerHTML = marked.parse(body.value, { async: false }) as string
    }
    previewPanel.hidden = !showing
    writeWrap.hidden = showing
    previewBtn.setAttribute('aria-pressed', String(showing))
    previewBtn.textContent = showing ? '继续写' : '预览'
  })

  // ---- 导入 MD（抄 YYsuni 的按钮，加料：带 front-matter 的文件自动回填字段）----
  const mdFile = $<HTMLInputElement>('[data-md-file]')
  $('[data-md-import]').addEventListener('click', () => mdFile.click())

  function importMarkdown(text: string, fileName: string) {
    text = text.replace(/^﻿/, '')
    const fm = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text)
    if (!fm) {
      body.value = text
    } else {
      const yaml = fm[1]!
      body.value = text.slice(fm[0].length).replace(/^\r?\n/, '')
      const unquote = (s: string) => s.replace(/^['"]|['"]$/g, '').trim()
      const line = (k: string) => {
        const m = new RegExp(`^${k}:[ \\t]*(.+)$`, 'm').exec(yaml)
        return m ? unquote(m[1]!.trim()) : ''
      }
      const setIf = (k: string, v: string) => {
        if (v) field(k).value = v
      }
      setIf('title', line('title'))
      setIf('description', line('description'))
      setIf('category', line('category'))
      const date = line('date')
      if (/^\d{4}-\d{2}-\d{2}/.test(date)) field('date').value = date.slice(0, 10)
      const updated = line('updated')
      if (/^\d{4}-\d{2}-\d{2}/.test(updated)) field('updated').value = updated.slice(0, 10)
      const draft = line('draft')
      if (draft) (field('draft') as HTMLInputElement).checked = draft === 'true'
      // 封面只认本仓库的 _covers 路径（服务端也只收这个格式），外来路径丢弃
      const cov = line('cover')
      if (/^\.\/_covers\//.test(cov)) {
        cover = cov
        showCover()
      }
      // tags：行内 [a, b] 或块列表 "- x" 两种写法都认
      const inline = /^tags:[ \t]*\[(.*)\]/m.exec(yaml)
      const block = /^tags:[ \t]*\r?\n((?:[ \t]+-[ \t]*.+(?:\r?\n)?)+)/m.exec(yaml)
      if (inline) {
        tags = inline[1]!.split(',').map((s) => unquote(s.trim())).filter(Boolean)
      } else if (block) {
        tags = block[1]!.split(/\r?\n/).map((l) => unquote(l.replace(/^[ \t]+-[ \t]*/, ''))).filter(Boolean)
      }
      renderTags()
    }
    // 还没定 slug 的新文章：拿文件名兜底（净化成合法 slug）
    if (!editing && !slugInput.value.trim()) {
      const guess = fileName.replace(/\.(md|markdown|txt)$/i, '').toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '')
      if (SLUG_RE.test(guess)) slugInput.value = guess
    }
    dirty = true
    toast(fm ? '已导入，front-matter 回填完毕' : '已导入 Markdown')
  }

  mdFile.addEventListener('change', async () => {
    const file = mdFile.files?.[0]
    if (file) {
      try {
        importMarkdown(await file.text(), file.name)
      } catch {
        toast('读取文件失败', false)
      }
    }
    mdFile.value = ''
  })

  // ---- 编辑态与读写 ----
  function enterEditMode(slug: string) {
    editing = slug
    slugInput.value = slug
    slugInput.disabled = true
    $('[data-head]').textContent = '编辑文章'
    $('[data-mode-badge]').hidden = false
    viewLink.hidden = false
    viewLink.href = `/posts/${slug}`
    history.replaceState(null, '', `?slug=${encodeURIComponent(slug)}`)
  }

  /** 这篇文章读到手时的版本号，保存时带回去做乐观并发（见 admin-contract.ts 的 ApiInit.etag）。
   *  新文章还没有文件，用 ETAG_ABSENT —— 撞了已有的 slug 服务端会答 409，不会静默覆盖 */
  let etag: string | null = ETAG_ABSENT

  async function load() {
    field('date').value = today()
    if (!editing) return
    const res = await apiRead<{ slug: string; meta: PostMeta; body: string }>(
      `/api/overview/posts/${encodeURIComponent(editing)}`,
    )
    const post = res.data
    etag = res.etag
    const m = post.meta
    field('title').value = m.title
    field('date').value = m.date
    field('updated').value = m.updated ?? ''
    field('category').value = m.category ?? ''
    field('description').value = m.description ?? ''
    ;(field('draft') as HTMLInputElement).checked = m.draft
    body.value = post.body
    tags = [...m.tags]
    renderTags()
    cover = m.cover ?? ''
    showCover()
    enterEditMode(post.slug)
    dirty = false
  }
  load().catch((err) => {
    // 拉不到这篇（删了 / 网断了）：退回「写新文章」态，别让 editing 挂着一个
    // 没加载出来的 slug —— 否则下面 save() 会把它当编辑态，改了 slug 也进不了编辑模式
    editing = ''
    etag = ETAG_ABSENT
    report(err)
  })

  /**
   * 新建时先探一下 slug 有没有被占，好在动手前就问清楚 ——「保存会把它整篇覆盖，确定？」
   * 比事后 409 友好。真正的护栏是 PUT 带的 If-Match=ETAG_ABSENT（服务端那道），
   * 所以这里探测失败（多半是网断了）也照常放行：覆盖不会静默发生。
   */
  async function slugTaken(slug: string): Promise<boolean> {
    try {
      await api(`/api/overview/posts/${encodeURIComponent(slug)}`)
      return true
    } catch {
      return false
    }
  }

  async function save() {
    const slug = slugInput.value.trim()
    if (!SLUG_RE.test(slug)) {
      toast('slug 只能是小写字母、数字和短横线，例如 my-first-post', false)
      slugInput.focus()
      return
    }
    // 明确同意覆盖：把 If-Match 松掉，否则服务端会拿 ETAG_ABSENT 拦下这次写
    let force = false
    if (!editing && (await slugTaken(slug))) {
      if (!confirm(`已经有一篇 slug 为「${slug}」的文章，保存会把它整篇覆盖。确定？`)) {
        slugInput.focus()
        return
      }
      force = true
    }
    addTag() // 输入框里敲了一半没回车的标签也带上
    const meta: PostMeta = {
      title: field('title').value.trim(),
      description: field('description').value.trim() || undefined,
      date: field('date').value,
      updated: field('updated').value || undefined,
      tags,
      category: field('category').value.trim() || undefined,
      cover: cover || undefined,
      draft: (field('draft') as HTMLInputElement).checked,
    }
    if (!meta.title) {
      toast('标题不能为空', false)
      return
    }
    try {
      const saved = await apiRead(`/api/overview/posts/${encodeURIComponent(slug)}`, {
        method: 'PUT',
        body: { meta, body: body.value },
        etag: force ? null : etag,
      })
      etag = saved.etag ?? etag
      dirty = false
      // 文章列表与概览页缓存里还是旧标题/旧篇数，作废掉让它们下次现拉
      cacheDrop('posts', 'overview')
      if (!editing) enterEditMode(slug)
      toast('已保存')
    } catch (err) {
      if (isConflict(err)) {
        // 别自动重载：编辑器里是用户写了半天的正文，宁可让他复制走再刷新
        toast((err as Error).message, false)
        return
      }
      report(err)
    }
  }

  $('[data-save]').addEventListener('click', save)
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault()
      save()
    }
  })
</script>
