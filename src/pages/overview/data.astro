      desc: '首页中栏末位的「在用」工具行，一行四件正好。',
      kind: 'array',
      item: [
        { key: 'name', label: '名称' },
        { key: 'meta', label: '说明' },
        { key: 'icon', label: '图标', hint: ICON_HINT },
      ],
    },
    reading: {
      label: '最近在读',
      desc: '首页右栏的「最近在读」卡。progress 是读完的百分比。',
      kind: 'array',
      item: [
        { key: 'title', label: '书名' },
        { key: 'author', label: '作者' },
        { key: 'progress', label: '进度 %', input: 'number' },
        { key: 'accent', label: '进度条颜色', input: 'select', options: ['brand', 'gold'], hint: 'brand 橙 / gold 金' },
      ],
    },
    now: {
      label: '此刻',
      desc: '首页中栏的「此刻」卡（移动端也用）。改完记得把更新日期拨到今天。',
      kind: 'object',
      listKey: 'items',
      fields: [
        { key: 'updated', label: '更新日期', input: 'date' },
        { key: 'statement', label: '一句话（在做什么）', wide: true },
        { key: 'note', label: '补充说明', input: 'textarea', wide: true },
        { key: 'aside', label: '移动端小字', wide: true },
      ],
      item: [
        { key: 'kind', label: '标签（在做/在啃…）' },
        { key: 'detail', label: '内容', wide: true },
        { key: 'icon', label: '图标', hint: ICON_HINT },
        { key: 'active', label: '高亮（橙点）', input: 'checkbox' },
      ],
    },
    playlist: {
      label: '正在听',
      desc: '首页播放器与听歌页（/my-music）共用的歌单，按顺序播、到底循环。勾选一首「首次加载默认播放」，用户第一次点击播放时就从它开始（浏览器不会无手势自动播放）。音频先用下方工具上传，再把地址填进来。至少留一首。',
      kind: 'array',
      minItems: 1,
      upload: 'music',
      item: [
        { key: 'title', label: '曲名' },
        { key: 'artist', label: '歌手' },
        { key: 'default', label: '首次加载默认播放', input: 'checkbox' },
        { key: 'src', label: '音频地址', hint: '/music/xxx.mp3' },
        { key: 'lrc', label: '歌词地址（可空）', optional: true, hint: '/music/xxx.lrc，没有就不显示歌词' },
        {
          key: 'cover',
          label: '专辑封面（可空）',
          optional: true,
          hint: '/music/xxx.jpg，听歌页 CD 盘面上转的就是它；pnpm covers 会批量抓',
        },
        {
          key: 'offset',
          label: '歌词偏移·秒（可空）',
          input: 'number',
          optional: true,
          hint: '这首歌词整体快/慢时微调：正值=歌词推迟出现，负值=提前，如 0.5 或 -1',
        },
      ],
    },
  }

  // ---- 状态 ----

  type Item = Record<string, unknown>

  let current = 'site'
  let value: unknown = null
  let dirty = false

  // 条目分页：数组页签（歌单 / 分享 / 友链…）条目多时分页显示，省得一屏拖很长。
  // 关键：卡片的 data-idx / data-scope 始终是「整个数组里的真实下标」，不是本页下标 ——
  // 上移/下移/删除/编辑都按真实下标操作，翻页只影响「显示哪一段」。
  const ITEMS_PER_PAGE = 10
  let itemPage = 1

  /*
   * 译文编辑态。curLocale = ''（中文基准，走原有的整套表单）或某个语种码
   * （en / ja…，走 renderTr 的翻译视图）。译文在内存里存成「输入框表示法」：
   * 一律字符串（lines 用 \n 连接、csv 用逗号），保存时再转回 JSON 形状 ——
   * trTop 对应对象顶层字段，trItems 与基准条目按下标严格对齐。
   */
  let curLocale: '' | Locale = ''
  let trTop: Record<string, string> = {}
  let trItems: Record<string, string>[] = []

  const tabs = $('[data-tabs]')
  const editor = $('[data-editor]')
  const langRow = $('[data-lang-row]')

  const spec = () => SPECS[current]!
  /** 这一组有没有「条目列表」：纯 object（站点信息 / 关于页）没有 */
  const hasList = (sp: Spec) => sp.kind === 'array' || !!sp.listKey
  const list = (): Item[] => {
    const sp = spec()
    if (!hasList(sp)) return []
    return (sp.kind === 'array' ? value : (value as Item)?.[sp.listKey!]) as Item[]
  }

  // ---- 可翻译字段的判定 ----

  /*
   * 译文只碰文本：数字 / 颜色 / 日期 / 勾选 / 下拉 / 图片位都是结构，三语共用。
   * 文本里也有结构字段（地址、图标名、日期串、语言名这类专名），按键名排除。
   * playlist 不给翻（曲名歌手是专有名词，且 config.ts 读的是原始 JSON、
   * 覆盖文件根本不会生效）；theme 全是颜色，本来就轮不到。
   */
  const NO_TR_SPECS = new Set(['playlist', 'theme'])
  const NO_TR_KEYS = new Set([
    'href', 'domain', 'repo', 'icon', 'src', 'lrc', 'initial', 'initialColor',
    'email', 'date', 'pushed', 'stack',
  ])
  const trFields = (fields: Field[] = []): Field[] =>
    fields.filter(
      (f) =>
        !f.virtual &&
        !NO_TR_KEYS.has(f.key) &&
        (!f.input || f.input === 'text' || f.input === 'textarea' || f.input === 'lines' || f.input === 'csv'),
    )
  const specTranslatable = (name: string) => {
    const sp = SPECS[name]!
    return !NO_TR_SPECS.has(name) && trFields(sp.fields).length + trFields(sp.item).length > 0
  }

  /** 数组译文的配对主键 —— 与 src/i18n/merge.ts 的 IDENTITY_KEYS 同一份约定 */
  const IDENTITY = ['repo', 'href', 'domain'] as const
  const identKeyOf = (items: Item[]): string | null => {
    if (items.length === 0) return null
    for (const k of IDENTITY) if (items.every((it) => typeof it[k] === 'string')) return k
    return null
  }

  /** JSON 值 ⇄ 输入框字符串（译文视图里 lines 用换行、csv 用逗号，与基准表单同款） */
  const toInput = (f: Field, v: unknown): string =>
    v == null ? '' : Array.isArray(v) ? v.join(f.input === 'lines' ? '\n' : ', ') : String(v)
  const fromInput = (f: Field, s: string): unknown => {
    const t = s.trim()
    if (!t) return undefined
    if (f.input === 'lines')
      return t.split('\n').map((x) => x.trim()).filter(Boolean)
    if (f.input === 'csv')
      return t.split(/[,，]/).map((x) => x.trim()).filter(Boolean)
    return t
  }

  window.addEventListener('beforeunload', (e) => {
    if (dirty) e.preventDefault()
  })

  // ---- 值的两头转换 ----

  const pad2 = (n: number) => String(n).padStart(2, '0')

  /** JSON 里的 ISO（UTC，如 2026-08-19T15:06:27Z）→ datetime-local 要的本地时间串 */
  function isoToLocal(iso: string): string {
    if (!iso) return ''
    const d = new Date(iso)
    if (Number.isNaN(d.getTime())) return ''
    return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`
  }

  /** datetime-local → ISO（UTC Z）；空或没填完先原样留着 */
  function localToIso(v: string): string {
    if (!v) return ''
    const d = new Date(v)
    if (Number.isNaN(d.getTime())) return v
    return d.toISOString().replace(/\.\d{3}Z$/, 'Z')
  }

  /** 粘贴的 GitHub 网址收敛成 作者/仓库名；不像网址就原样返回 */
  function normalizeRepo(input: string): string {
    const s = input.trim()
    const m = s.match(/^https?:\/\/(?:www\.)?github\.com\/([^/\s]+\/[^/\s#?]+)/i)
    if (!m) return s
    return m[1]!.replace(/\.git$/, '').replace(/\/+$/, '')
  }

  const REPO_RE = /^[\w.-]+\/[\w.-]+$/

  // ---- 渲染 ----

  function fieldHtml(f: Field, v: unknown, scope: string): string {
    const attrs = `data-k="${f.key}" data-scope="${scope}"`
    const s = v == null ? '' : String(v)
    const hint = f.hint ? `<span class="ad-hint">${esc(f.hint)}</span>` : ''
    let control: string
    switch (f.input) {
      case 'textarea':
        control = `<textarea class="ad-textarea" rows="2" ${attrs}>${esc(s)}</textarea>`
        break
      case 'lines':
        control = `<textarea class="ad-textarea" rows="3" ${attrs}>${esc(
          Array.isArray(v) ? v.join('\n') : s,
        )}</textarea>`
        break
      case 'number':
        control = `<input class="ad-input" type="number" ${attrs} value="${esc(s)}">`
        break
      case 'date':
        control = `<input class="ad-input" type="date" ${attrs} value="${esc(s)}">`
        break
      case 'datetime':
        control = `<input class="ad-input" type="datetime-local" ${attrs} value="${esc(isoToLocal(s))}">`
        break
      case 'color':
        control = `<input class="ad-input" type="color" ${attrs} value="${esc(s || '#d9812b')}">`
        break
      case 'checkbox':
        return `<label class="flex items-center gap-[8px] self-end pb-[9px] text-[13px] text-ink">
          <input type="checkbox" class="ad-check" ${attrs} ${v ? 'checked' : ''}> ${esc(f.label)}
        </label>`
      case 'select':
        control = `<select class="ad-select" ${attrs}>${(f.options ?? [])
          .map((o) => `<option value="${esc(o)}" ${o === s ? 'selected' : ''}>${esc(o)}</option>`)
          .join('')}</select>`
        break
      case 'csv':
        control = `<input class="ad-input" ${attrs} value="${esc(Array.isArray(v) ? v.join(', ') : s)}">`
        break
      case 'avatar':
        // 操作控件：图按域名/仓库名/固定名传给服务端，不往 JSON 写值
        return `<div class="flex flex-col gap-[4px]">
          <span class="ad-label">${esc(f.label)}</span>
          <button type="button" class="ad-btn-ghost" data-act="avatar" data-idx="${scope}" data-from="${esc(f.nameFrom ?? 'domain')}" data-fixed="${esc(f.fixedName ?? '')}" data-kind="${esc(f.uploadKind ?? 'avatar')}">上传图片</button>
          ${hint}
        </div>`
      default:
        control = `<input class="ad-input" ${attrs} value="${esc(s)}">`
    }
    return `<label class="flex flex-col gap-[4px] ${f.wide ? 'ad-field--wide' : ''}">
      <span class="ad-label">${esc(f.label)}</span>${control}${hint}
    </label>`
  }

  function render() {
    const sp = spec()
    $('[data-desc]').textContent = sp.desc
    $('[data-add]').hidden = !hasList(sp)
    $('[data-upload-box]').hidden = sp.upload !== 'music'

    for (const btn of tabs.querySelectorAll('button')) {
      btn.setAttribute('aria-current', btn.dataset.name === current ? 'page' : 'false')
    }

    let html = ''
    if (sp.kind === 'object' && sp.fields) {
      // 图片位不进字段网格 —— 单独一排预览瓦片（有图显图、点击更换），
      // 站标/头像/画卡/三张快照排同一行，长说明收进悬停提示
      const textFields = sp.fields.filter((f) => f.input !== 'avatar')
      const imgFields = sp.fields.filter((f) => f.input === 'avatar')
      html += `<div class="ad-card p-[20px]"><div class="ad-item-grid">${textFields
        .map((f) => fieldHtml(f, (value as Item)[f.key], 'top'))
        .join('')}</div>`
      if (imgFields.length > 0) {
        html += `<div class="ad-imgtiles">${imgFields
          .map(
            (f) => `<button type="button" class="ad-imgtile" title="${esc(f.hint ?? '')}"
              data-act="avatar" data-idx="top" data-from="${esc(f.nameFrom ?? 'domain')}"
              data-fixed="${esc(f.fixedName ?? '')}" data-kind="${esc(f.uploadKind ?? 'avatar')}">
              <span class="ad-imgtile-pic" data-pic="${esc(f.fixedName ?? '')}" data-pickind="${esc(f.uploadKind ?? '')}">
                <span class="ad-imgtile-empty">＋</span>
              </span>
              <span class="ad-imgtile-label">${esc(f.label)}</span>
            </button>`,
          )
          .join('')}</div>`
      }
      html += `</div>`
    }
    if (hasList(sp)) {
      const items = list()
      const total = items.length
      const pages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE))
      if (itemPage > pages) itemPage = pages
      if (itemPage < 1) itemPage = 1
      const start = (itemPage - 1) * ITEMS_PER_PAGE
      // 只渲染本页那一段，但下标用 start + 本页序号 = 数组真实下标（操作按它走）
      html += items
        .slice(start, start + ITEMS_PER_PAGE)
        .map((item, k) => {
          const i = start + k
          return `<div class="ad-item" data-idx="${i}">
            <div class="ad-item-grid">${sp.item.map((f) => fieldHtml(f, item[f.key], String(i))).join('')}</div>
            <div class="ad-item-tools">
              ${(sp.itemTools ?? [])
                .map((t) => `<button type="button" data-act="${t.act}" data-idx="${i}">${esc(t.label)}</button>`)
                .join('')}
              <button type="button" data-act="up" data-idx="${i}">上移</button>
              <button type="button" data-act="down" data-idx="${i}">下移</button>
              <button type="button" data-act="del" data-idx="${i}" class="ad-danger">删除</button>
            </div>
          </div>`
        })
        .join('')
      // 超过一页才出翻页条（短列表不打扰）
      if (pages > 1) {
        html += `<div class="flex items-center justify-center gap-[12px] pt-[8px]">
          <button type="button" data-page="prev" class="ad-btn-ghost"${itemPage <= 1 ? ' disabled' : ''}>← 上一页</button>
          <span class="ad-hint">第 ${itemPage} / ${pages} 页 · 共 ${total} 条</span>
          <button type="button" data-page="next" class="ad-btn-ghost"${itemPage >= pages ? ' disabled' : ''}>下一页 →</button>
        </div>`
      }
    }
    editor.innerHTML = html
    loadTilePreviews()
  }

  // ---- 译文视图 ----

  /** 把已有的译文文件摊进 trTop / trItems（与基准对齐；对不上的条目忽略） */
  function distributeTr(patch: unknown) {
    const sp = spec()
    trTop = {}
    trItems = list().map(() => ({}))
    const fill = (src: Item | undefined | null, fields: Field[], into: Record<string, string>) => {
      if (!src || typeof src !== 'object') return
      for (const f of trFields(fields)) if (f.key in src) into[f.key] = toInput(f, src[f.key])
    }
    if (sp.kind === 'object' && sp.fields) fill(patch as Item, sp.fields, trTop)
    const patchList =
      sp.kind === 'array'
        ? Array.isArray(patch)
          ? (patch as Item[])
          : undefined
        : sp.listKey
          ? ((patch as Item)?.[sp.listKey] as Item[] | undefined)
          : undefined
    if (!Array.isArray(patchList)) return
    const base = list()
    const ik = identKeyOf(base)
    if (ik && patchList.every((p) => p && typeof p[ik] === 'string')) {
      const byId = new Map(base.map((b, i) => [String(b[ik]), i]))
      for (const p of patchList) {
        const i = byId.get(String(p[ik]))
        if (i != null) fill(p, sp.item, trItems[i]!)
      }
    } else {
      // 下标配对（与 merge.ts 的回退口径一致）
      patchList.forEach((p, i) => {
        if (i < trItems.length) fill(p, sp.item, trItems[i]!)
      })
    }
  }

  /** trTop / trItems → 覆盖文件的 JSON；整组为空时返回 null（= 该删文件了） */
  function collectTr(): unknown {
    const sp = spec()
    const gather = (src: Record<string, string>, fields: Field[]): Item => {
      const out: Item = {}
      for (const f of trFields(fields)) {
        const v = fromInput(f, src[f.key] ?? '')
        if (v !== undefined) out[f.key] = v
      }
      return out
    }
    const base = list()
    const perItem = base.map((_, i) => gather(trItems[i] ?? {}, sp.item))
    const ik = identKeyOf(base)
    let items: Item[] | null = null
    if (base.length > 0) {
      if (ik) {
        // 有配对主键：只写翻过的条目，每条带上主键（merge.ts 按它认亲）
        const withId = perItem
          .map((o, i) => (Object.keys(o).length ? { [ik]: base[i]![ik], ...o } : null))
          .filter((x): x is Item => x !== null)
        items = withId.length ? withId : null
      } else {
        // 下标配对：位置就是身份 —— 中间没翻的写 {} 占位，尾部的空位裁掉
        let last = -1
        perItem.forEach((o, i) => {
          if (Object.keys(o).length) last = i
        })
        items = last === -1 ? null : perItem.slice(0, last + 1)
      }
    }
    if (sp.kind === 'array') return items
    const top = sp.fields ? gather(trTop, sp.fields) : {}
    if (sp.listKey && items) top[sp.listKey] = items
    return Object.keys(top).length ? top : null
  }

  function renderTr() {
    const sp = spec()
    const lang = localeMeta[curLocale as Locale]?.label ?? curLocale
    $('[data-desc]').textContent =
      `正在编辑「${sp.label}」的 ${lang} 译文。只列文本字段：留空 = 该字段回落中文；` +
      `数字、颜色、日期、图标、链接这类结构字段三语共用，不用翻。条目的增删排序请回「中文」做。`
    $('[data-add]').hidden = true
    $('[data-upload-box]').hidden = true
    for (const btn of tabs.querySelectorAll('button')) {
      btn.setAttribute('aria-current', btn.dataset.name === current ? 'page' : 'false')
    }

    const row = (f: Field, baseVal: unknown, trVal: string, scope: string) => {
      const baseStr = toInput(f, baseVal)
      const attrs = `data-tk="${f.key}" data-tscope="${scope}"`
      // 原文多行或较长就给 textarea，翻译时好对照
      const area = f.input === 'textarea' || f.input === 'lines' || baseStr.length > 48
      const control = area
        ? `<textarea class="ad-textarea" rows="2" placeholder="${esc(baseStr)}" ${attrs}>${esc(trVal)}</textarea>`
        : `<input class="ad-input" placeholder="${esc(baseStr)}" ${attrs} value="${esc(trVal)}">`
      return `<label class="flex flex-col gap-[4px] ad-field--wide">
        <span class="ad-label">${esc(f.label)}</span>
        <span class="ad-hint">中文：${esc(baseStr) || '—'}</span>
        ${control}
      </label>`
    }

    let html = ''
    const topFields = trFields(sp.fields)
    if (topFields.length > 0) {
      html += `<div class="ad-card p-[20px]"><div class="ad-item-grid">${topFields
        .map((f) => row(f, (value as Item)[f.key], trTop[f.key] ?? '', 'top'))
        .join('')}</div></div>`
    }
    const itemFields = trFields(sp.item)
    if (itemFields.length > 0) {
      html += list()
        .map((item, i) => {
          // 条目标题：拿第一个可翻字段的原文当锚，翻的时候知道自己在哪一条
          const head = toInput(itemFields[0]!, item[itemFields[0]!.key]) || `第 ${i + 1} 条`
          return `<div class="ad-item">
            <div class="ad-hint" style="margin-bottom:6px">◇ ${esc(head)}</div>
            <div class="ad-item-grid">${itemFields
              .map((f) => row(f, item[f.key], trItems[i]?.[f.key] ?? '', String(i)))
              .join('')}</div>
          </div>`
        })
        .join('')
    }
    editor.innerHTML = html
  }

  // ---- 图片瓦片的当前图回填 ----
  // 站点图片存在 Astro 资产目录（无公开 URL），走管理台预览接口 fetch 转 blob；
  // 站标本来就在 public/，直接引（带时间戳防缓存住旧图）
  function setTileImg(pic: HTMLElement, url: string) {
    // 换图前把上一张的 blob URL 释放掉：站点图预览每次都是新 blob，不 revoke 就一直占内存
    const prev = pic.querySelector('img')?.src
    if (prev?.startsWith('blob:')) URL.revokeObjectURL(prev)
    pic.innerHTML = `<img src="${url}" alt="">`
  }
  // 五张瓦片并行拉（服务端 no-store，每次都回源；串行要等五个往返）；
  // 请求发出后表单可能已经切到别的页签，回来时瓦片不在了就作废
  function loadTilePreviews() {
    for (const pic of editor.querySelectorAll<HTMLElement>('[data-pic]')) {
      if (pic.dataset.pickind === 'favicon') {
        setTileImg(pic, `/favicon.svg?t=${Date.now()}`)
        continue
      }
      siteAssetUrl(pic.dataset.pic!)
        .then((url) => {
          if (!url) return
          if (pic.isConnected) setTileImg(pic, url)
          else URL.revokeObjectURL(url)
        })
        .catch(() => {})
    }
  }

  // ---- 输入回写（事件委托，结构不变不重渲染）----

  editor.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement
    // 译文视图的输入走 data-tk（与基准表单的 data-k 分开，互不惊扰）
    const tk = el.dataset.tk
    if (tk) {
      const scope = el.dataset.tscope!
      if (scope === 'top') trTop[tk] = el.value
      else (trItems[Number(scope)] ??= {})[tk] = el.value
      dirty = true
      return
    }
    const key = el.dataset.k
    if (!key) return
    const sp = spec()
    const scope = el.dataset.scope!
    const fields = scope === 'top' ? sp.fields! : sp.item
    const f = fields.find((x) => x.key === key)!
    const target: Item = scope === 'top' ? (value as Item) : list()[Number(scope)]!

    let v: unknown = el.value
    if (f.input === 'checkbox') v = el.checked
    else if (f.input === 'number') v = el.value === '' ? 0 : Number(el.value)
    else if (f.input === 'datetime') v = localToIso(el.value)
    else if (f.input === 'csv')
      v = el.value
        .split(/[,，]/)
        .map((t) => t.trim())
        .filter(Boolean)
    else if (f.input === 'lines')
      v = el.value
        .split('\n')
        .map((t) => t.trim())
        .filter(Boolean)
    // 项目的 GitHub 链接：粘贴完整网址自动收敛成 作者/仓库名
    if (current === 'repos' && key === 'repo' && typeof v === 'string') v = normalizeRepo(v)
    target[key] = v
    // 默认曲目是单选语义：勾上一首时，连同未渲染分页里的旧默认项一起取消。
    if (current === 'playlist' && key === 'default' && v === true) {
      const selected = Number(scope)
      list().forEach((item, index) => {
        if (index === selected || item.default !== true) return
        item.default = false
        const checkbox = editor.querySelector<HTMLInputElement>(
          `[data-k="default"][data-scope="${index}"]`,
        )
        if (checkbox) checkbox.checked = false
      })
    }
    dirty = true
  })

  // 失焦时把收敛后的值写回输入框（打字过程中不动它，免得光标乱跳）
  editor.addEventListener(
    'change',
    (e) => {
      const el = e.target as HTMLInputElement
      if (current === 'repos' && el.dataset.k === 'repo') {
        const item = list()[Number(el.dataset.scope)]
        if (item) el.value = String(item.repo ?? '')
      }
    },
    true,
  )

  // ---- 条目操作（上移 / 下移 / 删除 / GitHub 同步 / 头像）----

  editor.addEventListener('click', async (e) => {
    // 翻页条：换页只改显示段，不动数据
    const pageBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-page]')
    if (pageBtn) {
      const pages = Math.max(1, Math.ceil(list().length / ITEMS_PER_PAGE))
      if (pageBtn.dataset.page === 'prev' && itemPage > 1) itemPage -= 1
      else if (pageBtn.dataset.page === 'next' && itemPage < pages) itemPage += 1
      render()
      editor.scrollIntoView({ block: 'start' })
      return
    }

    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')
    if (!btn) return
    const i = Number(btn.dataset.idx)
    const act = btn.dataset.act

    if (act === 'avatar') {
      pickAvatar(i, btn.dataset.from || 'domain', btn.dataset.kind || 'avatar', btn.dataset.fixed || '')
      return
    }
    if (act === 'gh') {
      await syncFromGitHub(i, btn)
      return
    }

    const items = list()
    if (act === 'del') {
      if (items.length <= (spec().minItems ?? 0)) {
        toast(`这一组至少要留 ${spec().minItems} 条`, false)
        return
      }
      items.splice(i, 1)
    } else {
      const j = act === 'up' ? i - 1 : i + 1
      if (j < 0 || j >= items.length) return
      ;[items[i], items[j]] = [items[j]!, items[i]!]
    }
    dirty = true
    render()
  })

  $('[data-add]').addEventListener('click', () => {
    const item: Item = {}
    for (const f of spec().item) {
      if (f.virtual) continue
      if (f.input === 'checkbox') item[f.key] = false
      else if (f.input === 'number') item[f.key] = 0
      else if (f.input === 'csv' || f.input === 'lines') item[f.key] = []
      else if (f.input === 'select') item[f.key] = f.options?.[0] ?? ''
      else if (f.input === 'color') item[f.key] = '#d9812b'
      else if (f.input === 'date') item[f.key] = today()
      else item[f.key] = ''
    }
    list().push(item)
    dirty = true
    itemPage = Math.max(1, Math.ceil(list().length / ITEMS_PER_PAGE)) // 跳到最后一页看新增那条
    render()
    editor.querySelector('.ad-item:last-of-type')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
  })

  // ---- GitHub 同步：一键拉星数 / 推送时间 / 主语言 ----

  async function syncFromGitHub(i: number, btn: HTMLElement) {
    const item = list()[i]
    if (!item) return
    const repo = normalizeRepo(String(item.repo ?? ''))
    if (!REPO_RE.test(repo)) {
      toast('先把 GitHub 链接填好 —— 仓库网址或 作者/仓库名 都行', false)
      return
    }
    const original = btn.textContent
    btn.textContent = '同步中…'
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`)
      if (res.status === 404) throw new Error(`GitHub 上没有 ${repo}（私有仓库拉不到）`)
      if (res.status === 403) throw new Error('GitHub 限流了，过几分钟再试')
      if (!res.ok) throw new Error(`GitHub 拒绝了（HTTP ${res.status}）`)
      const gh = (await res.json()) as {
        name?: string
        stargazers_count?: number
        pushed_at?: string
        language?: string | null
        description?: string | null
      }
      item.repo = repo
      if (typeof gh.stargazers_count === 'number') item.stars = gh.stargazers_count
      if (gh.pushed_at) item.pushed = gh.pushed_at
      if (gh.language) item.stack = gh.language
      if (!String(item.name ?? '').trim() && gh.name) item.name = gh.name
      if (!String(item.desc ?? '').trim() && gh.description) item.desc = gh.description
      dirty = true
      render()
      toast(`已同步 ${repo}：★ ${gh.stargazers_count ?? '?'} · 最后推送 ${gh.pushed_at?.slice(0, 10) ?? '?'}，记得保存`)
    } catch (err) {
      btn.textContent = original
      report(err)
    }
  }

  // ---- 按名图片上传（友链头像按域名 / 项目配图按仓库名）----

  const avFile = $<HTMLInputElement>('[data-avatar-file]')
  let avName = ''
  let avKind = 'avatar'

  function pickAvatar(i: number, nameFrom: string, kind: string, fixed: string) {
    let name = fixed // 站点图片这类固定名位置不依赖条目
    if (!name) {
      const item = list()[i]
      if (!item) return
      // 项目配图的来源字段是 owner/repo：取仓库名段；域名不含斜杠，不受影响
      name = String(item[nameFrom] ?? '').trim().toLowerCase().split('/').pop() ?? ''
      if (!name) {
        toast(`先把${kind === 'project' ? ' GitHub 链接' : '域名'}填好 —— 图片按它命名`, false)
        return
      }
    }
    avName = name
    avKind = kind
    avFile.click()
  }

  avFile.addEventListener('change', async () => {
    const file = avFile.files?.[0]
    if (!file) return
    if (avKind === 'favicon' && !/\.(svg|png)$/i.test(file.name)) {
      toast('站标只收 svg 或 png', false)
      avFile.value = ''
      return
    }
    const fd = new FormData()
    fd.append('kind', avKind)
    fd.append('name', avName)
    fd.append('file', file)
    try {
      const res = await api<{ path: string }>('/api/overview/upload', { method: 'POST', body: fd })
      // 对应的预览瓦片立即换上新图（直接用本地文件，不再回源）
      // 名字来自用户填的域名/仓库名，进选择器前转义 —— 带引号的怪名字会让 querySelector
      // 抛 SyntaxError，被同一个 try 兜住，上传明明成功了却 toast 报错
      const pic = editor.querySelector<HTMLElement>(`[data-pic="${CSS.escape(avName)}"]`)
      if (pic) setTileImg(pic, URL.createObjectURL(file))
      toast(`图片已存进 ${res.path} —— dev 站热更新，正式站要重新构建`)
    } catch (err) {
      report(err)
    } finally {
      avFile.value = ''
    }
  })

  // ---- 存取 ----

  function cleaned(): unknown {
    // 从原条目整份拷起，再对 spec 认识的字段做收敛 —— spec 之外的键原样保留。
    // 曾经是按 spec 白名单重建：歌单的 cover（fetch-covers 入库、听歌页 CD 盘面用）
    // 没进 spec，在「正在听」页签改一个歌词偏移再保存，24 首歌的封面全被静默剥掉。
    // 表单只会写 spec 里的键（input 走 data-k），所以条目上的未知键一定来自文件本身，
    // 保留它们不会把 UI 临时状态写进 JSON
    const strip = (item: Item, fields: Field[]) => {
      const out: Item = { ...item }
      for (const f of fields) {
        if (f.virtual) {
          delete out[f.key]
          continue
        }
        const v = item[f.key]
        if (f.optional && (v == null || (typeof v === 'string' && v.trim() === ''))) {
          delete out[f.key]
          continue
        }
        out[f.key] = typeof v === 'string' ? v.trim() : v
      }
      return out
    }
    const sp = spec()
    if (sp.kind === 'object' && !sp.listKey) return strip(value as Item, sp.fields!)
    const items = list().map((it) => strip(it, sp.item))
    if (sp.kind === 'array') return items
    const top = strip(value as Item, sp.fields!)
    top[sp.listKey!] = items
    return top
  }

  // 请求代际：连点两个页签时先发的应答可能后到 —— current 已经是 B、value 却被填成
  // A 的数据，再用 B 的 spec 渲染；顺手一存就把 A 的条目写进 B 的文件（数组对数组时
  // 服务端校验全过）。GitHub 直连模式每个 GET 都是一次几百毫秒的往返，很容易乱序。
  // 应答回来先核对代际，不是最新那次就整个丢掉
  let loadGen = 0

  async function load(name: string) {
    const gen = ++loadGen
    current = name
    itemPage = 1 // 换页签回到第一页
    // 这一组没有可翻字段时把语种拨回中文（theme/playlist 页签不该停在译文态）
    if (curLocale && !specTranslatable(name)) curLocale = ''
    if (curLocale === '') {
      const next = await api(`/api/overview/data/${name}`)
      if (gen !== loadGen) return
      value = next
      dirty = false
      render()
    } else {
      // 译文视图要基准 + 覆盖两份：基准当对照原文，覆盖是编辑对象（没有时是 null）
      const [base, patch] = await Promise.all([
        api(`/api/overview/data/${name}`),
        api(`/api/overview/data/${name}?locale=${curLocale}`),
      ])
      if (gen !== loadGen) return
      value = base
      distributeTr(patch)
      dirty = false
      renderTr()
    }
    updateLangRow()
  }

  $('[data-save]').addEventListener('click', async () => {
    try {
      if (curLocale !== '') {
        const lang = localeMeta[curLocale].label
        const patch = collectTr()
        if (patch === null) {
          // 整组全空 = 这门语言不再覆盖任何字段，文件留着只会误导，删掉
          if (!confirm(`「${spec().label}」的 ${lang} 译文全为空 —— 保存将删除译文文件，该组整体回落中文。继续？`))
            return
          await api(`/api/overview/data/${current}?locale=${curLocale}`, { method: 'DELETE' })
          toast(`${lang} 译文文件已删除，该组回落中文 —— 正式站要重新构建`)
        } else {
          await api(`/api/overview/data/${current}?locale=${curLocale}`, { method: 'PUT', body: patch })
          toast(`${lang} 译文已保存 —— dev 站会热更新，正式站要重新构建`)
        }
        dirty = false
        return
      }
      const next = cleaned()
      if (current === 'playlist') {
        const items = next as Item[]
        const defaults = items.filter((item) => item.default === true).length
        if (items.length > 0 && defaults !== 1) {
          toast('请为歌单勾选且仅勾选一首「首次加载默认播放」', false)
          return
        }
      }
      await api(`/api/overview/data/${current}`, { method: 'PUT', body: next })
      dirty = false
      toast('已保存 —— dev 站会热更新，正式站要重新构建')
    } catch (err) {
      report(err)
    }
  })

  // ---- 内容语言切换 ----

  const LOCALE_CHOICES: readonly ['' | Locale, string][] = [
    ['', '中文'],
    ...prefixedLocales.map((l): ['' | Locale, string] => [l, localeMeta[l].label]),
  ]
  for (const [loc, label] of LOCALE_CHOICES) {
    const btn = document.createElement('button')
    btn.type = 'button'
    btn.className = 'ad-tab'
    btn.dataset.loc = loc
    btn.textContent = label
    langRow.append(btn)
  }
  function updateLangRow() {
    langRow.hidden = !specTranslatable(current)
    for (const btn of langRow.querySelectorAll('button')) {
      btn.setAttribute('aria-current', btn.dataset.loc === curLocale ? 'page' : 'false')
    }
  }
  /*
   * 旧版数据服务不认 ?locale= —— GET 会把基准当译文端上来，保存又写回基准文件，
   * 等于拿半份译文覆盖整份中文数据。用 ?locale=zh 探一次：新服务必答 400
   * （zh 被显式拒绝），旧服务无视参数答 200 —— 答 200 就说明服务是旧的，不放行。
   * 只有这两种应答能下结论：连不上 / 5xx 什么都说明不了，既不放行也不缓存，
   * 原样抛给调用方去报错（早先 catch 一律当「新服务」——探测那一瞬断网就形同虚设）。
   * GitHub 直连模式的合同层和页面一起发版，永远是新的，不必探。
   */
  let localeApiOk: boolean | null = null
  async function ensureLocaleApi(): Promise<boolean> {
    if (ghMode) return true
    if (localeApiOk !== null) return localeApiOk
    try {
      await api(`/api/overview/data/site?locale=zh`)
      localeApiOk = false // 居然成功了 = 旧服务在无视 locale 参数
      return false
    } catch (err) {
      if (err instanceof ApiError && err.status === 400) {
        localeApiOk = true
        return true
      }
      throw err
    }
  }

  langRow.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-loc]')
    if (!btn || btn.dataset.loc === curLocale) return
    if (dirty && !confirm('这一组还有没保存的修改，切换语言会丢掉。继续？')) return
    if (btn.dataset.loc !== '') {
      let ok = false
      try {
        ok = await ensureLocaleApi()
      } catch (err) {
        report(err)
        return
      }
      if (!ok) {
        toast('数据服务还是旧版本，不认识译文接口 —— 先重新编译并重启 server/ 再来改译文', false)
        return
      }
    }
    curLocale = btn.dataset.loc as '' | Locale
    load(current).catch(report)
  })

  // ---- 页签 ----

  tabs.innerHTML = Object.entries(SPECS)
    .map(([name, sp]) => `<button type="button" class="ad-tab" data-name="${name}">${sp.label}</button>`)
    .join('')
  tabs.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-name]')
    if (!btn || btn.dataset.name === current) return
    if (dirty && !confirm('这一组还有没保存的修改，切换会丢掉。继续？')) return
    load(btn.dataset.name!).catch(report)
  })

  load('site').catch(report)

  // ---- 音乐上传 ----

  if (ghMode) {
    // GitHub 直连模式不收音乐：版权物不该进公开仓库，上传按钮换成说明
    $('[data-upload-box]').querySelector('p')!.textContent =
      'GitHub 直连模式不提供音乐上传：版权物不该进公开仓库。歌单清空后播放卡会自动隐藏；想托管音乐需要服务器形态（README 方式 A/B）。'
    $('[data-upload-pick]').hidden = true
  }

  const upFile = $<HTMLInputElement>('[data-upload-file]')
  const upPath = $('[data-upload-path]')
  const upCopy = $('[data-upload-copy]')
  $('[data-upload-pick]').addEventListener('click', () => upFile.click())
  upFile.addEventListener('change', async () => {
    const file = upFile.files?.[0]
    if (!file) return
    const fd = new FormData()
    fd.append('kind', 'music')
    fd.append('file', file)
    try {
      const res = await api<{ path: string }>('/api/overview/upload', { method: 'POST', body: fd })
      upPath.textContent = res.path
      upCopy.hidden = false
      // 顺手填进歌单：.lrc 进第一个缺歌词的条目，音频进第一个缺地址的条目（没有就新增一条）
      if (current === 'playlist') {
        const isLrc = res.path.endsWith('.lrc')
        const key = isLrc ? 'lrc' : 'src'
        let target = list().find((it) => !String(it[key] ?? '').trim())
        if (!target && !isLrc) {
          target = { title: '', artist: '', src: '', lrc: '', default: list().length === 0 }
          list().push(target)
        }
        if (target) {
          target[key] = res.path
          dirty = true
          render()
          toast(`已上传并填进歌单的「${isLrc ? '歌词' : '音频'}地址」，补好曲名记得保存`)
          return
        }
      }
      toast('已上传，把地址填进歌单里')
    } catch (err) {
      report(err)
    } finally {
      upFile.value = ''
    }
  })
  upCopy.addEventListener('click', async () => {
    // 纯 HTTP 直连时 navigator.clipboard 不存在，copyText 有 execCommand 兜底
    toast((await copyText(upPath.textContent ?? '')) ? '已复制' : '复制失败，请手动选择复制')
  })
</script>
