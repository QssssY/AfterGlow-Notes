---
import Footer from '~/components/Footer.astro'
import Sidebar from '~/components/Sidebar.astro'
import AboutMe from '~/components/about/AboutMe.astro'
import BuildPanel from '~/components/about/BuildPanel.astro'
import ChangelogCard from '~/components/about/ChangelogCard.astro'
import FriendsPanel from '~/components/about/FriendsPanel.astro'
import PrivacyPanel from '~/components/about/PrivacyPanel.astro'
import SideStack from '~/components/about/SideStack.astro'
import { email } from '~/config'
import BaseLayout from '~/layouts/BaseLayout.astro'

// 设计稿 About 页自带的数据，暂放页面文件里（见 report：建议之后并入 src/config.ts）
const paragraphs = [
  '白天写业务代码，晚上折腾三维和画布。喜欢那种「先做出来看看」的工作方式，所以这里大部分文章都是过程记录，而不是结论。',
  '不太擅长长期计划，但擅长在半途发现更有意思的岔路。如果你也在做类似的事，欢迎写信来聊。',
]

const chips = ['TypeScript', 'Three.js', 'Astro', 'Blender', 'Python']

/**
 * About Me 里 chips 下方新加的两列清单（设计稿这轮加的）。
 *
 * 设计稿原文是 Neovim / Blender 4.2 / Obsidian，和首页「在用」那条对不上。
 * 两处说的是同一件事，写成两套迟早互相打脸，所以这里跟着 config.tools 的口径，
 * 只写这个仓库里真能查到的东西。想换成你自己的，改这里和 config.tools。
 */
const lists = [
  {
    label: '我在用的东西',
    items: ['Astro 7 + Tailwind 4，全站静态', 'Pencil 画设计稿，代码照着还原', 'pnpm + Git，部署还没定'],
  },
  {
    label: '我关心的方向',
    items: ['把设计稿一比一还原成代码', '中文排版里那些小细节', '静态站的构建与字体体积'],
  },
]

const stats = [
  { value: '69', label: '篇文章' },
  { value: '12', label: '个项目' },
  { value: '20,118', label: '次喜欢' },
]

const contacts = [
  { icon: 'mail', value: email, href: `mailto:${email}` },
  { icon: 'github', value: 'github.com/QssssY', href: 'https://github.com/QssssY' },
  // 域名还没定，先写站内路径；定了域名后这里显示完整地址更好看
  { icon: 'rss', value: '订阅 RSS（/rss.xml）', href: '/rss.xml' },
]

const changelog = [
  {
    title: '重写为语义化画布',
    date: '2026.08',
    desc: '把文章、项目和实验都放进同一套节点描述里，界面开始能自己生长。',
    current: true,
    badge: '当前',
  },
  {
    title: '加入 Live2D 与音乐卡片',
    date: '2025.02',
    desc: '首页变成了一块桌面，可以随手摆放喜欢的小组件。',
  },
  {
    title: '迁移到 Astro',
    date: '2024.06',
    desc: '抛弃了自己写的构建脚本，换来干净的部署流程和更快的首屏。',
  },
  {
    title: '第一次部署',
    date: '2023.10',
    desc: '一个只有三篇文章的静态页面，托管在免费额度上。',
  },
]

/**
 * 关于页的友链面板 —— 图标和浅色渐变是本页独有的（友链页那份用首字 + 饱和渐变），
 * 所以两处数据分开存，跟设计稿一致。这里取友链页六条里的四条，换真实站点占位。
 */
const friends = [
  { name: '阮一峰', desc: '周刊与入门教程', icon: 'terminal', href: 'https://www.ruanyifeng.com/blog/', from: '#E3D2B4', to: '#C9E0D8' },
  { name: '哔哩哔哩', desc: '技术区与纪录片', icon: 'camera', href: 'https://www.bilibili.com', from: '#C6E0D6', to: '#E6D6BC' },
  { name: '张鑫旭', desc: 'CSS 与前端细节', icon: 'app-window', href: 'https://www.zhangxinxu.com', from: '#E7D6B8', to: '#D6D2BE' },
  { name: '知乎', desc: '专栏与长文', icon: 'book-open', href: 'https://www.zhihu.com', from: '#CFE0D2', to: '#E7D8C0' },
]
---

<BaseLayout title="关于网站" rail={false}>
  <div class="flex w-full flex-col items-start gap-[24px] xl:flex-row xl:gap-[48px]">
    <div class="hidden w-[280px] shrink-0 flex-col items-start gap-[24px] xl:flex">
      <Sidebar />
      <BuildPanel />
      <PrivacyPanel />
    </div>

    <div class="flex h-fit w-full flex-col items-start gap-[24px] xl:flex-1">
      <!-- Page Head -->
      <div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[10px] rounded-[30px] px-[30px] py-[28px]">
        <span class="font-display text-[28px]/[36px] font-normal text-ink">关于这个站点</span>
        <span class="w-full text-[13px]/[22px] font-normal text-ink-soft">
          一个用来记录、研究并延伸我所遇见、观察和思考的地方。没有排期，也没有 KPI。
        </span>
      </div>

      <!-- Row 1 -->
      <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[24px] xl:flex-row">
        <AboutMe
          role="前端 / 图形 / 偶尔做点没用的东西"
          paragraphs={paragraphs}
          chips={chips}
          lists={lists}
        />
        <SideStack stats={stats} contacts={contacts} />
      </div>

      <ChangelogCard entries={changelog} />
      <FriendsPanel note="欢迎交换 · 邮件里说一声就好" friends={friends} />
    </div>
  </div>

  <div class="mt-[30px] hidden w-full xl:block">
    <Footer license="本站由 Astro 构建 · 托管在 Vercel · 萤火录" />
  </div>
</BaseLayout>
