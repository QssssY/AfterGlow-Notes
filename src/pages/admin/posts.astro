---
import AdminLayout from '~/layouts/AdminLayout.astro'
---

<AdminLayout title="文章" active="posts">
  <div class="flex flex-wrap items-center gap-[12px]">
    <h1 class="font-display text-[22px] text-ink">文章</h1>
    <span class="flex-1"></span>
    <input
      data-search
      class="ad-input w-[220px]"
      type="search"
      placeholder="搜标题 / 标签 / slug…"
    />
    <label class="flex items-center gap-[6px] text-[13px] text-ink">
      <input type="checkbox" class="ad-check" data-drafts-only />
      只看草稿
    </label>
    <a href="/admin/editor" class="ad-btn-primary">写新文章</a>
  </div>

  <div data-list class="flex flex-col gap-[12px]">
    <span class="ad-hint">加载中…</span>
  </div>

  <div data-pager hidden class="flex items-center justify-center gap-[12px]">
    <button type="button" data-page-prev class="ad-btn-ghost">‹ 上一页</button>
    <span data-page-info class="ad-hint"></span>
    <button type="button" data-page-next class="ad-btn-ghost">下一页 ›</button>
  </div>
</AdminLayout>

<script>
  import { $, api, cachePut, esc, report, swrAdmin, toast } from '~/scripts/admin'
  import type { PostListItem } from '~/scripts/admin'

  const list = document.querySelector<HTMLElement>('[data-list]')!
  const searchInput = document.querySelector<HTMLInputElement>('[data-search]')!
  const draftsOnly = document.querySelector<HTMLInputElement>('[data-drafts-only]')!

  function row(p: PostListItem): string {
    const tags = p.tags.map((t) => `<span class="ad-chip">${esc(t)}</span>`).join('')
    const draft = p.draft ? '<span class="ad-chip ad-chip--draft">草稿</span>' : ''
    return `<div class="ad-card flex flex-wrap items-center gap-x-[16px] gap-y-[10px] p-[18px]" data-slug="${esc(p.slug)}">
      <div class="flex min-w-0 flex-1 flex-col gap-[6px]">
        <div class="flex flex-wrap items-center gap-[8px]">
          <span class="truncate text-[15px] font-medium text-ink">${esc(p.title)}</span>
          ${draft}
        </div>
        <div class="flex flex-wrap items-center gap-[8px] text-[12px] text-ink-muted">
          <span>${esc(p.date)}</span>
          <span class="font-mono">${esc(p.slug)}</span>
          ${tags}
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-[8px]">
        <a class="ad-btn-ghost" href="/posts/${esc(p.slug)}" target="_blank" rel="noopener">看</a>
        <a class="ad-btn-ghost" href="/admin/editor?slug=${encodeURIComponent(p.slug)}">编辑</a>
        <button type="button" class="ad-btn-danger" data-del>删除</button>
      </div>
    </div>`
  }

  let posts: PostListItem[] = []

  // 分页：和归档页同款每页 10 篇；筛选变化时回到第一页
  const PAGE_SIZE = 10
  let page = 1
  const pager = $('[data-pager]')
  const pageInfo = $('[data-page-info]')
  const prevBtn = $<HTMLButtonElement>('[data-page-prev]')
  const nextBtn = $<HTMLButtonElement>('[data-page-next]')

  function show() {
    const q = searchInput.value.trim().toLowerCase()
    const filtered = posts.filter((p) => {
      if (draftsOnly.checked && !p.draft) return false
      if (!q) return true
      return (
        p.title.toLowerCase().includes(q) ||
        p.slug.includes(q) ||
        (p.category ?? '').toLowerCase().includes(q) ||
        p.tags.some((t) => t.toLowerCase().includes(q))
      )
    })
    if (!filtered.length) {
      list.innerHTML = posts.length
        ? '<span class="ad-hint">没有匹配的文章。</span>'
        : '<span class="ad-hint">还没有文章，点右上角写第一篇。</span>'
      pager.hidden = true
      return
    }
    const pages = Math.ceil(filtered.length / PAGE_SIZE)
    page = Math.min(Math.max(1, page), pages)
    list.innerHTML = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map(row).join('')
    pager.hidden = pages <= 1
    pageInfo.textContent = `第 ${page} / ${pages} 页 · 共 ${filtered.length} 篇`
    prevBtn.disabled = page <= 1
    nextBtn.disabled = page >= pages
  }

  prevBtn.addEventListener('click', () => {
    page -= 1
    show()
    scrollTo({ top: 0, behavior: 'smooth' })
  })
  nextBtn.addEventListener('click', () => {
    page += 1
    show()
    scrollTo({ top: 0, behavior: 'smooth' })
  })

  searchInput.addEventListener('input', () => {
    page = 1
    show()
  })
  draftsOnly.addEventListener('change', () => {
    page = 1
    show()
  })

  // 缓存回放秒出列表，网络应答再校正（swrAdmin 见 scripts/admin.ts）
  swrAdmin('posts', () => api<PostListItem[]>('/api/admin/posts'), (p) => {
    posts = p
    show()
  }).catch((err) => {
    list.innerHTML = ''
    report(err)
  })

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-del]')
    if (!btn) return
    const card = btn.closest<HTMLElement>('[data-slug]')!
    const slug = card.dataset.slug!
    if (!confirm(`确定删除「${slug}」？文件会从仓库里移除（git 里还能找回来）。`)) return
    try {
      await api(`/api/admin/posts/${encodeURIComponent(slug)}`, { method: 'DELETE' })
      posts = posts.filter((p) => p.slug !== slug)
      cachePut('posts', posts) // 同步缓存，别让删掉的行在下次回放里诈尸
      show() // 整页重排：删掉末页最后一条时页码自动回夹
      toast('已删除')
    } catch (err) {
      report(err)
    }
  })
</script>
