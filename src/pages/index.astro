---
import { getCollection } from 'astro:content'
import Footer from '~/components/Footer.astro'
import RepoStars from '~/components/RepoStars.astro'
import Sidebar from '~/components/Sidebar.astro'
import ArtCard from '~/components/home/ArtCard.astro'
import GreetingCard from '~/components/home/GreetingCard.astro'
import LikeWidget from '~/components/home/LikeWidget.astro'
import NowCard from '~/components/home/NowCard.astro'
import NowPlayingCard from '~/components/home/NowPlayingCard.astro'
import ProjectsSection from '~/components/home/ProjectsSection.astro'
import ReadingCard from '~/components/home/ReadingCard.astro'
import SnapshotStrip from '~/components/home/SnapshotStrip.astro'
import TagCloudCard from '~/components/home/TagCloudCard.astro'
import ToolsBar from '~/components/home/ToolsBar.astro'
import UptimeCard from '~/components/home/UptimeCard.astro'
import FeaturedCard from '~/components/mobile/FeaturedCard.astro'
import MobileNowCard from '~/components/mobile/NowCard.astro'
import SocialRow from '~/components/mobile/SocialRow.astro'
import TopBar from '~/components/mobile/TopBar.astro'
import { site } from '~/config'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { postStats } from '~/utils/post'
import artBg from '../../images/bg.png'
import avatar from '../../images/cat001.jpg'
import snapDusk from '../../images/snapshot-dusk.png'
import snapField from '../../images/snapshot-field.png'
import snapLantern from '../../images/snapshot-lantern.png'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const enriched = posts.map((post) => {
  const stats = postStats(post.body ?? '')
  return {
    title: post.data.title,
    excerpt: post.data.description ?? '',
    href: `/posts/${post.id}`,
    date: post.data.date,
    category: post.data.category ?? '未分类',
    minutes: stats.minutes,
    wordsLabel: stats.wordsLabel,
    cover: post.data.cover,
  }
})

// 首页不再有文章列表（设计稿这轮换成了 此刻 Card），只有移动端末尾那张主推卡用得到
const featured = enriched[0]

const counts = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1)
}
const tags = [...counts].map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count)

// 桌面区块间距：Body 顶 48（设计稿是 72，用户嫌顶上空得慌，全站统一收到 48）；
// Body 底 → Projects 34；Projects 底 → Footer 30（取自设计稿绝对坐标差）
---

<BaseLayout title={site.title}>
  {/* ── 桌面：1440 三栏 ──────────────────────────────────
      设计稿这轮删掉了右上角那排 Social Button，社交入口挪进了侧栏 Social Row。 */}
  <div class="hidden w-full flex-row items-start gap-[48px] xl:flex">
    <div class="flex h-fit w-[280px] shrink-0 flex-col items-start gap-[24px]">
      <Sidebar />
      <UptimeCard />
    </div>

    {/* 三栏底边一条线：行高由左栏（Sidebar+Uptime = 798）定，
        中、右两栏 self-stretch 拉到同高，差值分别由画卡和问候卡吸收 */}
    <div class="flex flex-1 flex-col items-start gap-[24px] self-stretch">
      <ArtCard src={artBg} alt="三国演义 —— 大笑名场面" grow />
      <NowCard />
      <TagCloudCard tags={tags} />
      <ToolsBar />
    </div>

    <div class="flex w-[392px] shrink-0 flex-col items-start gap-[24px] self-stretch">
      {/* 爱心缩成迷你圆钮挂在问候卡右上角，原 Widget Row 整行让给音乐卡 */}
      <div class="relative flex w-full flex-1 flex-col self-stretch">
        <GreetingCard avatar={avatar} grow />
        {/* 位置往内收：角标探出按钮右上 6px，太贴边数字就顶到卡框了 */}
        <div class="absolute top-[22px] right-[26px]"><LikeWidget /></div>
      </div>
      <NowPlayingCard />
      <ReadingCard />
      <SnapshotStrip images={[snapDusk, snapField, snapLantern]} />
    </div>
  </div>

  <div class="mt-[34px] hidden w-full xl:block"><ProjectsSection /></div>
  <div class="mt-[30px] hidden w-full xl:block"><Footer /></div>

  {/* ── 移动：390 单栏，顶栏 + 底部 Tab Bar，无 Footer ──── */}
  <div class="flex w-full flex-col items-start gap-[14px] xl:hidden">
    <TopBar />
    <GreetingCard avatar={avatar} compact />
    <SocialRow />
    <ArtCard src={artBg} alt="三国演义 —— 大笑名场面" compact />
    <MobileNowCard />
    {
      featured && (
        <FeaturedCard
          date={featured.date}
          category={featured.category}
          title={featured.title}
          href={featured.href}
          minutes={featured.minutes}
          wordsLabel={featured.wordsLabel}
        />
      )
    }
  </div>

  <RepoStars />
</BaseLayout>
