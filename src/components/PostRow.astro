---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

interface Props {
  /** 设计是两位数序号，如 07 */
  index: number | string
  date: Date
  category: string
  title: string
  excerpt: string
  /** 标题与摘要的语种，与页面语种不一致时传（见 ArchivePost.titleLang） */
  titleLang?: string | undefined
  href?: string | undefined
  readMinutes: number
  /** 原始字数；「1.2k 字 / 1.2k words」的写法由 fmt 按语种给 */
  words: number
  /** 真实封面图；没有时退回设计的渐变底 + 图标 */
  cover?: ImageMetadata | undefined
  coverIcon?: string
}

const {
  index,
  date,
  category,
  title,
  excerpt,
  titleLang,
  href,
  readMinutes,
  words,
  cover,
  coverIcon = 'feather',
} = Astro.props
const { t, fmt } = useI18n(Astro)

const pad = (n: number) => String(n).padStart(2, '0')
const dateLabel = fmt.dateDots(date)
const indexLabel = typeof index === 'number' ? pad(index) : index
---

<!-- Post Row -->
<a
  href={href ?? '#'}
  class="glass-row box-border flex w-full flex-row items-center gap-[18px] rounded-[22px] p-[14px]"
>
  <span class="flex h-fit w-[38px] shrink-0 flex-col items-center justify-center gap-[6px]">
    <span class="font-display text-[21px] font-normal whitespace-nowrap text-ink-muted">
      {indexLabel}
    </span>
    <span class="h-[2px] w-[14px] shrink-0 rounded-[1px] bg-hairline"></span>
  </span>

  <span class="h-[64px] w-[2px] shrink-0 rounded-[1px] bg-leaf"></span>

  <span class="flex h-fit flex-1 flex-col items-start gap-[9px]">
    <span class="flex h-[20px] w-fit shrink-0 flex-row items-center gap-[9px]">
      <span class="size-[6px] shrink-0 rounded-full bg-brand shadow-[0_0_7px_0_var(--glow-fire)]"
      ></span>
      <time datetime={date.toISOString()} class="text-[13px] font-normal whitespace-nowrap text-ink-muted">
        {dateLabel}
      </time>
      <span class="text-[13px] font-normal whitespace-nowrap text-hairline">/</span>
      <span class="text-[13px] font-bold whitespace-nowrap text-leaf-deep">{category}</span>
    </span>

    <span lang={titleLang} class="w-full text-[23px]/[32px] font-bold text-ink">{title}</span>

    <span lang={titleLang} class="w-full text-[15px]/[26px] font-normal text-ink-soft">
      {excerpt}
    </span>

    <span class="flex h-[19px] w-fit shrink-0 flex-row items-center gap-[16px]">
      <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[5px]">
        <Icon name="lucide:clock-3" class="size-[13px] shrink-0 text-ink-muted" />
        <span class="text-[12.5px] font-normal whitespace-nowrap text-ink-muted">
          {t('common.readMinutes', { n: readMinutes })}
        </span>
      </span>
      <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[5px]">
        <Icon name="lucide:file-text" class="size-[13px] shrink-0 text-ink-muted" />
        <span class="text-[12.5px] font-normal whitespace-nowrap text-ink-muted">
          {fmt.wordsLabel(words)}
        </span>
      </span>
    </span>
  </span>

  <!-- 236px 定宽封面在窄屏会把整行撑出视口，所以 xl 以下不渲染。
       曾与文章页大图共享 transition:name 做变形飞行，已撤：236×162 和 1016×300
       宽高比差太远，交叉淡化对不上 —— 飞行中是一块盖住正文的半透明残板 -->
  <span
    class="img-sheen relative hidden h-[162px] w-[236px] shrink-0 flex-row items-center justify-center overflow-hidden rounded-[22px] bg-[linear-gradient(-124.467deg,#E8D3AE_14.645%,#C9DED6_85.355%)] xl:flex"
  >
    <!--
      没有封面时的占位图标：52px、节点透明度 0.92。填色两个主题不同色相
      （浅色 #5B423F、深色 #F2A94EC7），所以走 cover-glyph 这个主题变量。
    -->
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          width={472}
          height={324}
          widths={[236, 472]}
          sizes="236px"
          class="size-full object-cover"
        />
      ) : (
        <Icon
          name={`lucide:${coverIcon}`}
          class="size-[52px] shrink-0 text-cover-glyph opacity-[0.92]"
        />
      )
    }
  </span>
</a>
