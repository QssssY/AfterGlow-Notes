---
import { Icon } from 'astro-icon/components'

interface Props {
  /** 设计稿是 08-19 这种月-日 */
  date: string
  title: string
  href?: string | undefined
  readMinutes: number
  tags?: string[]
}

const { date, title, href, readMinutes, tags = [] } = Astro.props
---

<!-- Timeline Row · blog.pen jKPjc -->
<a href={href ?? '#'} class="box-border flex w-full flex-row items-center gap-[12px] py-[12px]">
  <span class="w-[44px] shrink-0 text-[13px] font-medium text-ink-soft">{date}</span>

  <span class="flex h-[16px] w-[8px] shrink-0 flex-row items-center justify-center">
    <span class="size-[5px] shrink-0 rounded-full bg-ink-muted"></span>
  </span>

  <span class="min-w-0 flex-1 text-[14px] font-medium break-words text-ink">{title}</span>

  <span class="flex h-[19px] w-fit shrink-0 flex-row items-center gap-[5px]">
    <Icon name="lucide:clock-3" class="size-[12px] shrink-0 text-ink-muted" />
    <span class="w-[44px] shrink-0 text-right text-[12px] font-normal text-ink-muted">
      {readMinutes} 分钟
    </span>
  </span>

  {
    tags.length > 0 && (
      <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[10px]">
        {tags.map((tag) => (
          <span class="text-[13px] font-normal whitespace-nowrap text-ink-muted">#{tag}</span>
        ))}
      </span>
    )
  }
</a>
