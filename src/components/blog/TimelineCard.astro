---
import { useI18n } from '~/i18n'
import type { ArchivePost } from '~/utils/posts'
import TimelineEntry from './TimelineEntry.astro'

interface Props {
  groups: { year: number; posts: ArchivePost[] }[]
  /** 高亮的文章 id（最新一篇），只在第一页出现 */
  highlightId?: string | undefined
}

const { groups, highlightId } = Astro.props
const { t, fmt, path } = useI18n(Astro)

/*
 * 分组切换（日/周/月/年/分类）是客户端就地重排的，组头文案得脚本自己拼 ——
 * 带占位符的模板与「未分类」由服务端写进 data-t-*，日 / 月 的日期由脚本用 Intl
 * 按 <html lang> 排。这样三种语言下的组头都是地道写法，而不是套中文模板。
 */
const scriptText = {
  'data-t-year': t('blog.yearLabel', { year: '{year}' }),
  'data-t-week': t('blog.weekLabel', { year: '{year}', week: '{week}' }),
  'data-t-count': t('common.postsCount', { n: '{n}' }),
  'data-t-uncat': t('common.uncategorized'),
}
---

<!--
  Timeline Card

  服务端只渲染「年」分组（也是无 JS 时的兜底）。List Header 那排 日/周/月/年/分类
  由下面的脚本接管：条目行原样搬运，只重建组头 —— 所以每行的视觉与设计保持一致。
  组头带 id="y-年份"，年表面板的锚点跳的就是它。
-->
<div
  data-timeline
  {...scriptText}
  class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[2px] rounded-[32px] max-xl:px-[18px] max-xl:py-[20px] xl:px-[28px] xl:py-[26px]"
>
  {
    groups.map((group, i) => (
      <>
        {i > 0 && <span data-tl-sep class="h-[1px] w-full shrink-0 bg-hairline" />}

        <div
          data-tl-header
          id={`y-${group.year}`}
          class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px] py-[8px]"
        >
          <span data-tl-title class="text-[16px] font-medium whitespace-nowrap text-ink">
            {t('blog.yearLabel', { year: group.year })}
          </span>
          <span class="size-[7px] shrink-0 rounded-full bg-dot-idle" />
          <span data-tl-count class="flex-1 text-[13px] font-normal text-ink-soft">
            {t('common.postsCount', { n: group.posts.length })}
          </span>
          <a
            href={path('/rss.xml')}
            data-astro-prefetch="false"
            class="text-[12px] font-normal whitespace-nowrap text-brand-ink"
          >
            RSS
          </a>
        </div>

        {group.posts.map((post) => (
          <TimelineEntry
            date={fmt.monthDayNumeric(post.date)}
            title={post.title}
            titleLang={post.titleLang}
            href={post.href}
            readMinutes={post.minutes}
            tags={post.tagLabels}
            highlight={post.id === highlightId}
            dateIso={post.date.toISOString()}
            category={post.category}
          />
        ))}
      </>
    ))
  }
</div>

<script>
  import { fill } from '~/scripts/i18n'

  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    /**
     * List Header 的 日/周/月/年/分类 分组切换。
     *
     * 条目 <a data-entry> 是同一批节点换个顺序挂（本来就按时间倒序，
     * 各种分组都不用重排），只有组头和分隔线是克隆/新建的。
     * 只作用于当前分页的条目 —— 翻页后各页各自分组，和「年」视图口径一致。
     */
    const root = document.querySelector<HTMLElement>('[data-timeline]')
    const pills = [...document.querySelectorAll<HTMLElement>('[data-group]')]

    if (root && pills.length > 0) {
      const entries = [...root.querySelectorAll<HTMLElement>('[data-entry]')]
      const headerTpl = root.querySelector<HTMLElement>('[data-tl-header]')?.cloneNode(true) as
        | HTMLElement
        | undefined

      if (entries.length > 0 && headerTpl) {
        // 文章日期是 frontmatter 里的「日历日」（2026-08-22，没有时分），data-date 是它按
        // UTC 零点序列化的 ISO 串 —— 客户端一律按 UTC 取年月日、Intl 也钉在 UTC：
        // 按访客本地时区取的话，美洲读者在 UTC-5 看到的是前一天（Aug 21），日/月分组
        // 和服务端渲的「年」视图口径对不上
        const isoWeek = (d: Date): [number, number] => {
          const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()))
          const day = t.getUTCDay() || 7
          t.setUTCDate(t.getUTCDate() + 4 - day)
          const yearStart = Date.UTC(t.getUTCFullYear(), 0, 1)
          return [t.getUTCFullYear(), Math.ceil(((t.getTime() - yearStart) / 86_400_000 + 1) / 7)]
        }

        // 组头文案：模板由服务端写在 [data-timeline] 上，日/月的日期交给 Intl
        const T = root.dataset
        const tag = document.documentElement.lang || 'zh-CN'
        const dayFmt = new Intl.DateTimeFormat(tag, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        })
        const monthFmt = new Intl.DateTimeFormat(tag, { year: 'numeric', month: 'long', timeZone: 'UTC' })

        const keyAndLabel = (mode: string, el: HTMLElement): [string, string] => {
          const d = new Date(el.dataset.date ?? 0)
          const y = d.getUTCFullYear()
          switch (mode) {
            case 'day':
              return [`${y}-${d.getUTCMonth()}-${d.getUTCDate()}`, dayFmt.format(d)]
            case 'week': {
              const [wy, w] = isoWeek(d)
              return [`${wy}-w${w}`, fill(T.tWeek, { year: wy, week: w })]
            }
            case 'month':
              return [`${y}-${d.getUTCMonth()}`, monthFmt.format(d)]
            case 'cat': {
              // data-cat 存的已经是当前语种的分类显示名（见 utils/posts.ts）
              const cat = el.dataset.cat || (T.tUncat ?? '')
              return [cat, cat]
            }
            default:
              return [String(y), fill(T.tYear, { year: y })]
          }
        }

        const regroup = (mode: string) => {
          // 桶按条目出现顺序建（条目本身是时间倒序）
          const buckets = new Map<string, { label: string; items: HTMLElement[] }>()
          for (const el of entries) {
            const [key, label] = keyAndLabel(mode, el)
            const bucket = buckets.get(key)
            if (bucket) bucket.items.push(el)
            else buckets.set(key, { label, items: [el] })
          }

          const next: HTMLElement[] = []
          let i = 0
          for (const [key, bucket] of buckets) {
            if (i > 0) {
              const sep = document.createElement('span')
              sep.dataset.tlSep = ''
              sep.className = 'h-[1px] w-full shrink-0 bg-hairline'
              next.push(sep)
            }
            const header = headerTpl.cloneNode(true) as HTMLElement
            // 锚点 id 只在「年」视图有意义（年表面板跳的就是它）
            header.id = mode === 'year' ? `y-${key}` : ''
            header.querySelector('[data-tl-title]')!.textContent = bucket.label
            header.querySelector('[data-tl-count]')!.textContent = fill(T.tCount, {
              n: bucket.items.length,
            })
            next.push(header, ...bucket.items)
            i += 1
          }
          root.replaceChildren(...next)
        }

        for (const pill of pills) {
          pill.addEventListener('click', () => {
            for (const p of pills) p.setAttribute('aria-pressed', String(p === pill))
            regroup(pill.dataset.group!)
          })
        }
      }
    }
  })
</script>
