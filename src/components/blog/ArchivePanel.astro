---
import Panel from './Panel.astro'

interface Props {
  years: { year: number; count: number; percent: number }[]
}

const { years } = Astro.props
---

<Panel caption="年 表 ARCHIVE">
  {
    years.map((entry) => (
      <a
        href={`/archive?year=${entry.year}`}
        class="flex h-[20px] w-full shrink-0 flex-row items-center gap-[10px]"
      >
        <span class="text-[12.5px] font-bold whitespace-nowrap text-ink-soft">{entry.year}</span>
        <span class="flex h-[6px] flex-1 flex-row overflow-hidden rounded-[3px] bg-hairline">
          <span
            class="h-[6px] shrink-0 rounded-[3px] bg-brand"
            style={`width:${entry.percent}%`}
          />
        </span>
        <span class="w-[22px] shrink-0 text-right text-[12px] font-normal text-ink-muted">
          {entry.count}
        </span>
      </a>
    ))
  }
</Panel>
