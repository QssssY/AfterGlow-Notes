---
import Panel from './Panel.astro'

interface Props {
  tags: { name: string; count: number }[]
}

const { tags } = Astro.props
---

<Panel caption="标 签 TAGS">
  <!-- 设计稿是三行定宽（gap 7），这里用 flex-wrap 自动折行 -->
  <div class="flex w-full shrink-0 flex-row flex-wrap items-start gap-[7px]">
    {
      tags.map((tag) => (
        <a
          href={`/tags/${tag.name}`}
          class="hairline-box box-border flex h-fit w-fit shrink-0 flex-row rounded-[12px] px-[10px] py-[6px]"
        >
          <span class="text-[12.5px] font-normal whitespace-nowrap text-ink-soft">{tag.name}</span>
        </a>
      ))
    }
  </div>
</Panel>
