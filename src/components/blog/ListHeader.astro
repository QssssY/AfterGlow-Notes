---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

interface Props {
  /** 文章总数，用于搜索框占位文案 */
  total: number
}

const { total } = Astro.props
const { t } = useI18n(Astro)

/**
 * 分组切换「日 / 周 / 月 / 年 / 分类」。默认「年」，与服务端渲染的分组一致；
 * 点击后由 TimelineCard 里的脚本就地重排组头。选中态样式由 aria-pressed 驱动。
 */
const GROUPS = [
  { key: 'day', label: t('blog.groupDay') },
  { key: 'week', label: t('blog.groupWeek') },
  { key: 'month', label: t('blog.groupMonth') },
  { key: 'year', label: t('blog.groupYear') },
  { key: 'cat', label: t('blog.groupCat') },
] as const
const ACTIVE = 'year'
---

<div class="flex h-[40px] w-full shrink-0 flex-row items-center justify-between gap-[12px]">
  <div
    role="group"
    aria-label={t('blog.groupAria')}
    class="glass box-border flex h-fit w-fit shrink-0 flex-row items-center gap-[4px] rounded-[16px] p-[4px]"
  >
    {
      GROUPS.map((group) => (
        <button
          type="button"
          data-group={group.key}
          aria-pressed={group.key === ACTIVE}
          class="box-border flex h-fit w-fit shrink-0 cursor-pointer flex-row rounded-[12px] px-[13px] py-[6px] text-[12px] font-medium whitespace-nowrap text-ink-soft transition-colors hover:bg-card aria-pressed:bg-brand aria-pressed:font-semibold aria-pressed:text-on-brand"
        >
          {group.label}
        </button>
      ))
    }
  </div>

  <button
    type="button"
    data-search-open
    class="hairline-box box-border hidden h-fit w-[236px] shrink-0 cursor-pointer flex-row items-center gap-[8px] rounded-[12px] px-[12px] py-[9px] text-left sm:flex"
  >
    <Icon name="lucide:search" class="size-[15px] shrink-0 text-ink-muted" />
    <!-- 设计这个搜索框里没有 ⌘K 角标（快捷键照旧能用，见 SearchOverlay） -->
    <span class="flex-1 truncate text-[13px] font-normal text-ink-muted">
      {t('blog.searchPlaceholder', { n: total })}
    </span>
  </button>
</div>
