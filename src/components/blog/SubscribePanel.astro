---
import { Icon } from 'astro-icon/components'
import { email } from '~/config'
import Panel from '~/components/Panel.astro'
---

<!--
  Subscribe Panel · blog.pen 归档页左栏
  没有后端：提交时打开访客自己的邮件客户端，收件人、主题、正文都预填好。
  等以后接了订阅服务（Buttondown / Listmonk 之类），把下面的 submit 处理换掉即可。
-->
<Panel caption="订 阅 SUBSCRIBE">
  <p class="w-full text-[12px]/[19px] font-normal text-ink-soft">
    新文章发布时收到通知，不含广告。
  </p>

  <form class="flex w-full shrink-0 flex-col gap-[12px]" data-subscribe data-to={email}>
    <label
      class="hairline-box box-border flex h-[36px] w-full shrink-0 flex-row items-center gap-[8px] rounded-[12px] px-[12px]"
    >
      <Icon name="lucide:mail" class="size-[14px] shrink-0 text-ink-muted" />
      <input
        type="email"
        name="email"
        required
        placeholder="你的邮箱"
        class="w-full min-w-0 bg-transparent text-[12.5px] font-normal text-ink placeholder:text-ink-muted focus:outline-none"
      />
    </label>

    <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
      <button
        type="submit"
        class="flex h-[34px] flex-1 flex-row items-center justify-center rounded-[12px] bg-brand text-[12.5px] font-bold text-on-brand outline-1 -outline-offset-[0.5px] outline-brand"
      >
        订阅
      </button>
    </div>
  </form>
</Panel>

<script>
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    for (const form of document.querySelectorAll<HTMLFormElement>('[data-subscribe]')) {
      form.addEventListener('submit', (event) => {
        // 不让它按原生方式提交（那会刷新页面且什么也不发生）
        event.preventDefault()

        const to = form.dataset.to
        const input = form.querySelector<HTMLInputElement>('input[name="email"]')
        if (!to || !input) return

        const subject = encodeURIComponent('订阅余晖录')
        const body = encodeURIComponent(`请把这个邮箱加入订阅：${input.value}`)
        location.href = `mailto:${to}?subject=${subject}&body=${body}`
      })
    }
  })
</script>
