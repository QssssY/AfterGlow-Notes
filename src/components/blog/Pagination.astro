---
import { useI18n } from '~/i18n'

interface Props {
  current: number
  totalPages: number
  total: number
  /** 生成某一页的链接；第一页是 /archive */
  hrefFor: (page: number) => string
}

const { current, totalPages, total, hrefFor } = Astro.props
const { t } = useI18n(Astro)

/** 首页、末页、当前页 ±1，中间断开处用 … */
function pageList(current: number, totalPages: number): (number | 'gap')[] {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1)
  const keep = new Set([1, totalPages, current, current - 1, current + 1])
  const out: (number | 'gap')[] = []
  let gap = false
  for (let page = 1; page <= totalPages; page += 1) {
    if (keep.has(page)) {
      out.push(page)
      gap = false
    } else if (!gap) {
      out.push('gap')
      gap = true
    }
  }
  return out
}

const pages = pageList(current, totalPages)
const box =
  'flex size-[38px] shrink-0 flex-row items-center justify-center rounded-[12px] text-[13.5px] font-bold'
const idle = 'bg-card text-ink-soft outline-[1.5px] -outline-offset-[0.75px] outline-card-border'
// 只有真链接有悬浮/按压反馈，禁用箭头和 … 是 span、保持不动
const tap =
  'transition-[translate,background-color,scale] hover:-translate-y-[1px] hover:bg-card-solid active:scale-95'
---

{
  totalPages > 1 && (
    <nav
      aria-label={t('blog.paginationAria')}
      class="flex h-[52px] w-full shrink-0 flex-row items-center justify-center gap-[8px]"
    >
      {current > 1 ? (
        <a href={hrefFor(current - 1)} rel="prev" aria-label={t('blog.prevPage')} class:list={[box, idle, tap]}>
          ‹
        </a>
      ) : (
        <span aria-hidden="true" class:list={[box, idle, 'opacity-[0.4]']}>
          ‹
        </span>
      )}

      {pages.map((page) =>
        page === 'gap' ? (
          <span class:list={[box, idle]}>…</span>
        ) : page === current ? (
          <span
            aria-current="page"
            class:list={[
              box,
              'bg-brand text-on-brand outline-[1.5px] -outline-offset-[0.75px] outline-brand',
            ]}
          >
            {page}
          </span>
        ) : (
          <a href={hrefFor(page)} class:list={[box, idle, tap]}>
            {page}
          </a>
        ),
      )}

      {current < totalPages ? (
        <a href={hrefFor(current + 1)} rel="next" aria-label={t('blog.nextPage')} class:list={[box, idle, tap]}>
          ›
        </a>
      ) : (
        <span aria-hidden="true" class:list={[box, idle, 'opacity-[0.4]']}>
          ›
        </span>
      )}
    </nav>
  )
}

<div class="flex h-[20px] w-full shrink-0 flex-row items-center justify-center gap-[8px]">
  <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
    {t('blog.pageInfo', { total, current, pages: totalPages })}
  </span>
</div>
