---
import { useI18n } from '~/i18n'

interface Props {
  /** name 是原始标签（网址用），label 是当前语种的显示名 */
  tags: { name: string; label: string; count: number }[]
}

const { tags } = Astro.props
const { t, path } = useI18n(Astro)
---

<!--
  Tags

  设计这轮把标签从左栏面板挪成了内容栏的横带：1016×58 · r28 · p[14,18] ·
  caption 在左，标签一行排开（gap 8）。标签砖本身和原来左栏那版一样
  （chip 底 + hairline 描边 + p[6,10] + r12 + 12.5px）。

  设计只画了 8 个标签、正好一行放得下。真实标签数不定，所以让它折行：
  窄屏 caption 换到标签上方，宽屏还是左右并排。
-->
<div
  class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[16px] rounded-[28px] px-[18px] py-[14px] xl:flex-row xl:items-center"
>
  <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
    {t('blog.tagsCaption')}
  </span>

  <div
    class="flex h-fit w-full min-w-0 flex-row flex-wrap items-center gap-[8px] xl:w-auto xl:flex-1"
  >
    {
      tags.map((tag) => (
        <a
          href={path(`/tags/${tag.name}`)}
          class="hairline-box box-border flex h-fit w-fit shrink-0 flex-row rounded-[12px] px-[10px] py-[6px]"
        >
          <span class="text-[12.5px] font-normal whitespace-nowrap text-ink-soft">{tag.label}</span>
        </a>
      ))
    }
  </div>
</div>
