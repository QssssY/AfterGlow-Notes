---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

interface Props {
  date: string
  title: string
  /** 标题语种与页面语种不一致时传（见 ArchivePost.titleLang） */
  titleLang?: string | undefined
  href: string
  readMinutes: number
  tags?: readonly string[]
  /**
   * 最新一篇的高亮态（设计里 13 行只有第一行是这样）：
   * 圆点变成 5×14 的品牌色长条，标题也是品牌色。
   */
  highlight?: boolean
  /** 分组切换脚本要的原始数据（见 TimelineCard）：ISO 日期与分类名 */
  dateIso?: string | undefined
  category?: string | undefined
}

const {
  date,
  title,
  titleLang,
  href,
  readMinutes,
  tags = [],
  highlight = false,
  dateIso,
  category,
} = Astro.props
const { t } = useI18n(Astro)
---

{/* 预取降为 hover：归档一页 10 行，全局的 viewport 策略会把 10 篇整页 HTML
    一口气全预取；悬停/聚焦（键盘 Tab）再取，点开依旧秒进 */}
<a
  href={href}
  data-entry
  data-date={dateIso}
  data-cat={category}
  data-astro-prefetch="hover"
  class="group/entry flex h-fit w-full shrink-0 flex-row items-center gap-[12px] py-[12px]"
>
  <span class="w-[44px] shrink-0 text-[13px] font-medium text-ink-soft">{date}</span>

  <span class="flex h-[16px] w-[8px] shrink-0 flex-row items-center justify-center">
    <span
      class:list={[
        'w-[5px] shrink-0 rounded-full',
        highlight ? 'h-[14px] bg-brand' : 'h-[5px] bg-ink-muted',
      ]}></span>
  </span>

  <span
    lang={titleLang}
    class:list={[
      'flex-1 text-[14px] font-medium transition-colors',
      highlight ? 'text-brand' : 'text-ink group-hover/entry:text-brand-ink',
    ]}
    >{title}</span
  >

  <span class="flex h-[19px] w-fit shrink-0 flex-row items-center gap-[5px]">
    <Icon name="lucide:clock-3" class="size-[12px] shrink-0 text-ink-muted" />
    {/* 宽度从 44 放到 fit-content 下限 44：英文的「12 min」比中文「12 分钟」略宽，
        写死 44 会把字挤掉一半 */}
    <span class="min-w-[44px] shrink-0 text-right text-[12px] font-normal whitespace-nowrap text-ink-muted">
      {t('common.readMinutes', { n: readMinutes })}
    </span>
  </span>

  {
    tags.length > 0 && (
      <span class="hidden h-fit w-fit shrink-0 flex-row items-center gap-[10px] md:flex">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-[13px] font-normal whitespace-nowrap text-ink-muted">#{tag}</span>
        ))}
      </span>
    )
  }
</a>
