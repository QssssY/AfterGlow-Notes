---
import { useI18n } from '~/i18n'

const { t, c } = useI18n(Astro)
const { reading } = c
---

<!-- Reading Card -->
<div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[14px] rounded-[30px] p-[24px]">
  <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">{t('home.reading')}</span>

  {
    reading.map((book) => (
      <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[8px]">
        <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
          <span class="flex-1 text-[13px] font-medium text-ink">{book.title}</span>
          <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">{book.author}</span>
        </div>
        <div class="flex h-[4px] w-full shrink-0 flex-row rounded-[2px] bg-hairline">
          <span
            class:list={[
              'h-[4px] shrink-0 rounded-[2px] opacity-[0.7]',
              book.accent === 'gold' ? 'bg-gold' : 'bg-brand',
            ]}
            style={`width:${book.progress}%`}
          />
        </div>
      </div>
    ))
  }
</div>
