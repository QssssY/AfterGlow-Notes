---
import { uptime } from '~/config'
import { useI18n } from '~/i18n'
import { calendarDaysSince } from '~/utils/post'

interface Props {
  /** 首页左栏用：时钟挪去右栏后左栏偏短，这张卡拉伸吃掉差值，三栏底线平齐 */
  grow?: boolean
}
const { grow = false } = Astro.props

const { t, fmt } = useI18n(Astro)
const days = fmt.number(calendarDaysSince(uptime.since))
---

<!-- Uptime Card -->
<div
  class:list={[
    'glass box-border flex w-full shrink-0 flex-col items-start gap-[10px] rounded-[26px] p-[20px]',
    grow ? 'flex-1 justify-center' : 'h-fit',
  ]}
>
  <span class="text-[12px] font-normal whitespace-nowrap text-ink-soft">
    {t('home.uptimeLabel')}
  </span>

  <span class="flex h-fit w-fit shrink-0 flex-row items-end gap-[6px]">
    <span data-countup data-uptime-days={uptime.since.getTime()} class="font-display text-[26px]/[26px] font-normal whitespace-nowrap text-ink"
      >{days}</span
    >
    <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">
      {t('home.uptimeUnit')}
    </span>
  </span>

  <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">
    {t('uptime.since', { date: fmt.dateFull(uptime.since) })}
  </span>
</div>

<script>
  // 天数实时化：见 ~/scripts/uptime（Astro 会去重，两个组件只打包一份）
  import '~/scripts/uptime'
</script>
