---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

const { t, c } = useI18n(Astro)
const { tools } = c

/**
 * 在用 Card
 *
 * 规格：576×59 · r22（radius-row，比同栏其他卡浅一档，因为这条矮）
 * padding 20/22 · 横向 gap14 · 居中对齐
 * 「在用」13px text-secondary + 1×18 竖线 + Items（gap18）
 * 每件工具 gap7：14px 图标 text-muted + 名称 13px/500 + 小字 11px text-muted
 */
---

<section
  class="glass box-border flex h-fit w-full shrink-0 flex-row items-center gap-[14px] rounded-[22px] px-[22px] py-[20px]"
>
  <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">{t('home.tools')}</span>

  <span class="h-[18px] w-[1px] shrink-0 bg-hairline"></span>

  {/* 可换行：设计宽度（中栏 576）恰好单行；1280~1439 中栏缩到 416 起步，
      不换行的话整栏会被这条的 min-content 顶宽、右栏挤出视口 */}
  <ul class="flex h-fit min-w-0 flex-1 list-none flex-row flex-wrap items-center gap-x-[18px] gap-y-[10px]">
    {
      tools.map((tool) => (
        <li class="flex h-fit w-fit shrink-0 flex-row items-center gap-[7px]">
          <Icon name={`lucide:${tool.icon}`} class="size-[14px] shrink-0 text-ink-muted" />
          <span class="text-[13px] font-medium whitespace-nowrap text-ink">{tool.name}</span>
          <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">{tool.meta}</span>
        </li>
      ))
    }
  </ul>
</section>
