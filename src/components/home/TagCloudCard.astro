---
interface Props {
  tags: { name: string; count: number }[]
}

const { tags } = Astro.props
---

<!-- Tag Cloud · blog.pen Home / Column A（设计稿是两行定宽，这里用 flex-wrap 自动折行） -->
<div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[14px] rounded-[30px] p-[24px]">
  <span class="text-[13px] font-normal whitespace-nowrap text-ink-soft">常写的标签</span>

  <div class="flex w-full shrink-0 flex-row flex-wrap items-center gap-[8px]">
    {
      tags.map((tag) => (
        <a
          href={`/tags/${tag.name}`}
          class="box-border flex h-fit w-fit shrink-0 flex-row items-center gap-[6px] rounded-[14px] bg-chip px-[12px] py-[6px] outline-1 -outline-offset-[0.5px] outline-card-border"
        >
          <span class="text-[12px] font-normal whitespace-nowrap text-ink">#{tag.name}</span>
          <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">{tag.count}</span>
        </a>
      ))
    }
  </div>
</div>
