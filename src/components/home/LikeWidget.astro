---
import { Icon } from 'astro-icon/components'
---

<!--
  站点点赞 —— 迷你圆钮，挂在问候卡右上角。
  设计稿 Widget Row 里那颗 76px 的大爱心让位给了整行的音乐卡（用户拍板），
  交互原样保留：服务端计数、已赞实心心、心形爆裂。
  注意不能用 fill：astro-icon 渲染成 symbol + use，路径自带 fill="none" 属性，
  外部 CSS 选不进 use 的影子树 —— 已赞态靠叠一颗内联实心路径。

  计数是真实数据：Go 后端在的话显示全站总数；不在就只显示访客本机的 0/1。
  设计稿里的 20118 是虚构基数，已删 —— 不编数字。
-->
<div class="relative shrink-0">
  <button
    type="button"
    data-like
    data-like-site
    aria-pressed="false"
    aria-label="喜欢这个站点"
    title="喜欢这个站点"
    class="glass group/like flex size-[40px] cursor-pointer flex-row items-center justify-center rounded-full"
  >
    <span data-like-burst aria-hidden="true" class="pointer-events-none absolute inset-0"></span>
    <span class="relative size-[19px] shrink-0 transition-transform group-active/like:scale-90">
      <Icon
        name="lucide:heart"
        class="absolute inset-0 size-[19px] text-like-fill transition-colors group-aria-pressed/like:text-like-ink"
      />
      <!-- 已赞态的实心心：lucide 的 use 影子树填不了色，叠同形内联路径 -->
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        class="absolute inset-0 size-[19px] scale-50 fill-like-ink text-like-ink opacity-0 transition-[opacity,scale] duration-300 group-aria-pressed/like:scale-100 group-aria-pressed/like:opacity-100"
      >
        <path
          d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
        ></path>
      </svg>
    </span>
  </button>

  <span
    class="pointer-events-none absolute -top-[6px] left-[26px] flex h-fit w-fit flex-row items-center justify-center rounded-[10px] bg-fire-tint px-[6px] py-[2px]"
  >
    <span data-like-count class="text-[10px] font-bold whitespace-nowrap text-brand-ink">0</span>
  </span>
</div>

<script>
  import { getLikes, postLike } from '~/scripts/api'
  import { likeBurst } from '~/scripts/like-burst'
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    const KEY = 'hearth:liked'

    // localStorage 在隐私模式或禁用 cookie 时会抛，包起来后点赞退化成本次会话有效
    const read = () => {
      try {
        return localStorage.getItem(KEY) === '1'
      } catch {
        return false
      }
    }
    const write = (liked: boolean) => {
      try {
        if (liked) localStorage.setItem(KEY, '1')
        else localStorage.removeItem(KEY)
      } catch {
        // 存不了就算了，不打断交互
      }
    }

    // 全站点赞可能有多颗按钮（桌面迷你圆钮 + 移动端 Social Row 胶囊），
    // 共享同一份状态：点任意一颗，所有按钮的点亮态和所有计数一起更新
    const buttons = [...document.querySelectorAll<HTMLElement>('[data-like][data-like-site]')]
    if (buttons.length === 0) return
    const counts = [...document.querySelectorAll<HTMLElement>('[data-like-count]')]

    let liked = read()
    // 服务端总数；null = 后端没配或没应答，只显示访客自己的 0/1 —— 不编数字
    let total: number | null = null

    const render = () => {
      const value = String(total ?? (liked ? 1 : 0))
      for (const button of buttons) button.setAttribute('aria-pressed', String(liked))
      for (const count of counts) count.textContent = value
    }
    render()

    // 后端在的话，以它为准（'site' 是全站点赞的固定 slug）
    getLikes('site').then((state) => {
      if (!state) return
      liked = state.liked
      total = state.count
      write(liked)
      render()
    })

    for (const button of buttons) {
      button.addEventListener('click', () => {
        liked = !liked
        write(liked)
        if (total !== null) total += liked ? 1 : -1 // 乐观更新，应答后校正
        render()
        if (liked) likeBurst(button)

        postLike('site', liked ? 'like' : 'unlike').then((state) => {
          if (!state) return
          liked = state.liked
          total = state.count
          write(liked)
          render()
        })
      })
    }
  })
</script>
