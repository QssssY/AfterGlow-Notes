---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** 设计稿这里是 Unsplash 占位图，等提供真实作品图 */
  src?: ImageMetadata | undefined
  alt?: string
  /** 移动端：h152 / p6 / 圆角 28+22（桌面 h268 / p8 / 圆角 36+29） */
  compact?: boolean
}

const { src, alt = '', compact = false } = Astro.props
---

<!-- Art Card · blog.pen Home / Column A（移动端同名帧） -->
<div
  class:list={[
    'glass box-border flex w-full shrink-0 flex-row',
    compact ? 'h-[152px] rounded-[28px] p-[6px]' : 'h-[268px] rounded-[36px] p-[8px]',
  ]}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        class:list={['h-full flex-1 object-cover', compact ? 'rounded-[22px]' : 'rounded-[29px]']}
      />
    ) : (
      <span
        class:list={[
          'h-full flex-1 bg-avatar-bg',
          compact ? 'rounded-[22px]' : 'rounded-[29px]',
        ]}
      />
    )
  }
</div>
