---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src?: ImageMetadata | undefined
  alt?: string
  /** 移动端：h152 / p6 / 圆角 28+22（桌面 h268 / p8 / 圆角 36+29） */
  compact?: boolean
  /**
   * 桌面中栏用：以 268 为最小高度向下生长，吃掉真实内容比设计稿短出来的差值，
   * 让中栏底边和两侧栏对齐（列上要配 self-stretch）。
   */
  grow?: boolean
}

const { src, alt = '', compact = false, grow = false } = Astro.props
---

<!-- Art Card · blog.pen Home / Column A（移动端同名帧） -->
<div
  class:list={[
    'glass group box-border flex w-full flex-row',
    compact
      ? 'h-[152px] shrink-0 rounded-[28px] p-[6px]'
      : 'rounded-[36px] p-[8px]',
    !compact && (grow ? 'min-h-[268px] flex-1' : 'h-[268px] shrink-0'),
  ]}
>
  {
    /*
     * 图挂在一层 relative 容器里、自身 absolute 铺满：
     * 绝对定位的图不参与卡片高度计算，否则 grow 模式下图片的固有比例
     * （576 宽 → 约 400 高）会把卡撑得比两侧栏还高，中栏就「突下去」了。
     */
    src ? (
      <span
        class:list={[
          // overflow-hidden：hover 缓慢推近时不越出内格圆角
          'relative h-full min-w-0 flex-1 overflow-hidden',
          compact ? 'rounded-[22px]' : 'rounded-[29px]',
        ]}
      >
        <Image
          src={src}
          alt={alt}
          class:list={[
            'absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]',
            compact ? 'rounded-[22px]' : 'rounded-[29px]',
          ]}
        />
      </span>
    ) : (
      <span
        class:list={[
          'h-full flex-1 bg-avatar-bg',
          compact ? 'rounded-[22px]' : 'rounded-[29px]',
        ]}
      />
    )
  }
</div>
