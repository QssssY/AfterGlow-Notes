---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src?: ImageMetadata | undefined
  alt?: string
  /** 移动端：h152 / p6 / 圆角 28+22（桌面 h268 / p8 / 圆角 36+29） */
  compact?: boolean
  /**
   * 桌面中栏用：以 268 为最小高度向下生长，吃掉真实内容比设计短出来的差值，
   * 让中栏底边和两侧栏对齐（列上要配 self-stretch）。
   */
  grow?: boolean
}

const { src, alt = '', compact = false, grow = false } = Astro.props
---

<!-- Art Card -->
<div
  class:list={[
    'glass group box-border flex w-full flex-row',
    compact
      ? 'h-[152px] shrink-0 rounded-[28px] p-[6px]'
      : 'rounded-[36px] p-[8px]',
    !compact && (grow ? 'min-h-[268px] flex-1' : 'h-[268px] shrink-0'),
  ]}
>
  {
    /*
     * 图挂在一层 relative 容器里、自身 absolute 铺满：
     * 绝对定位的图不参与卡片高度计算，否则 grow 模式下图片的固有比例
     * （576 宽 → 约 400 高）会把卡撑得比两侧栏还高，中栏就「突下去」了。
     */
    src ? (
      <span
        class:list={[
          // overflow-hidden：hover 缓慢推近时不越出内格圆角；skeleton = 图渐显前的微光占位；
          // img-sheen = hover 一道斜向微光扫过（伪元素 ::before，::after 归骨架屏）
          'img-sheen skeleton relative h-full min-w-0 flex-1 overflow-hidden',
          compact ? 'rounded-[22px]' : 'rounded-[29px]',
        ]}
      >
        {/* 首页最大的一张图（LCP）：eager + 高优先级，默认的 lazy 会把它排到最后。
            srcset 三档：560 = 桌面中栏显示宽（1344-280-392-96），1120 = 其 2x；
            手机按视口挑小档，不再全员下载原宽大图 */}
        <Image
          src={src}
          alt={alt}
          loading="eager"
          fetchpriority="high"
          widths={[560, 1120, 1600]}
          sizes="(min-width: 1280px) 560px, calc(100vw - 60px)"
          class:list={[
            'absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]',
            compact ? 'rounded-[22px]' : 'rounded-[29px]',
          ]}
        />
      </span>
    ) : (
      <span
        class:list={[
          'h-full flex-1 bg-avatar-bg',
          compact ? 'rounded-[22px]' : 'rounded-[29px]',
        ]}
      />
    )
  }
</div>
