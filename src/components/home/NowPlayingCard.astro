---
import { Icon } from 'astro-icon/components'
import { nowPlaying } from '~/config'
---

<!-- Now Playing · blog.pen Home / Widget Row -->
<div class="glass box-border flex h-fit flex-1 flex-col items-start justify-center gap-[10px] rounded-[30px] p-[20px]">
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <Icon name="lucide:audio-lines" class="size-[18px] shrink-0 text-brand" />
    <span class="flex-1 text-[12px] font-normal text-ink-soft">正在听</span>
  </div>

  <span class="w-full text-[14px] font-medium text-ink">{nowPlaying.track}</span>

  <!-- 条形高度是设计稿定格的一帧；律动只做 scaleY 收缩，峰值仍是这些高度。
       节拍参数（时长三档、负延迟错相）内联给动效层的 eq 关键帧用。 -->
  <div data-eq class="flex h-[20px] w-fit shrink-0 flex-row items-end gap-[4px]">
    {
      nowPlaying.bars.map((h, i) => (
        <span
          class="w-[3px] shrink-0 rounded-[2px] bg-brand opacity-[0.55]"
          style={`height:${h}px;--eq-dur:${(0.8 + (i % 3) * 0.18).toFixed(2)}s;--eq-delay:${(-i * 0.13).toFixed(2)}s`}
        />
      ))
    }
  </div>
</div>
