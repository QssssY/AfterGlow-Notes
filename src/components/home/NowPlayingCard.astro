---
import { Icon } from 'astro-icon/components'
import { nowPlaying } from '~/config'

const tracks = nowPlaying.playlist
const first = tracks[0]!
const trackLabel = (t: { title: string; artist?: string }) =>
  t.artist ? `${t.title} — ${t.artist}` : t.title
---

<!--
  Now Playing · blog.pen Home / Widget Row —— 播放列表版播放器。

  视觉骨架照设计稿：音波 icon + 「正在听」 + 曲名 + 等化条。
  能力（都不改布局）：
  - 点卡播放 / 暂停；多于一首时右上角出现「下一首」；放完自动接下一首、到底循环
  - 播放时等化条由 Web Audio 实时频谱驱动，停下来回到设计稿的定格假谱
  - 曲名行播放时逐句显示 LRC 歌词，卡拉OK式从左往右点亮（唱到哪亮到哪）；
    渐变挂在贴文本宽的内层 span 上 —— 挂整行容器会按容器宽算，分界线跑得比人声快
  - 底部细进度线，点击 / 拖动调进度
-->
<div
  data-np
  role="button"
  tabindex="0"
  aria-pressed="false"
  aria-label={`播放 ${trackLabel(first)}`}
  title="点击播放 / 暂停"
  class="glass group/np relative box-border flex h-fit w-full shrink-0 cursor-pointer flex-col items-start justify-center gap-[10px] overflow-hidden rounded-[30px] p-[20px]"
>
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <Icon name="lucide:audio-lines" class="size-[18px] shrink-0 text-brand" />
    <span class="flex-1 text-[12px] font-normal text-ink-soft">正在听</span>
    {
      tracks.length > 1 && (
        <button
          type="button"
          data-np-next
          aria-label="下一首"
          title="下一首"
          class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
        >
          <Icon name="lucide:skip-forward" class="size-[13px] shrink-0" />
        </button>
      )
    }
    <!-- 播放/暂停的小提示角标，跟随状态换图标 -->
    <Icon
      name="lucide:play"
      class="size-[13px] shrink-0 text-ink-muted transition-opacity group-aria-pressed/np:hidden"
    />
    <Icon
      name="lucide:pause"
      class="hidden size-[13px] shrink-0 text-brand-ink group-aria-pressed/np:block"
    />
  </div>

  <!-- 外层管淡切与截断；内层贴文本宽，是卡拉OK渐变的载体 -->
  <span
    data-np-line
    class="w-full truncate text-[14px] font-medium text-ink transition-opacity duration-300"
  >
    <span data-np-text>{trackLabel(first)}</span>
  </span>

  <!-- 条形高度循环设计稿定格的那 12 个值（卡片占满整行后 12 根太稀，铺到 24 根）。
       未播放：CSS 假律动；播放（data-live）：JS 用实时频谱写 scaleY，见 global.css -->
  <div data-eq class="flex h-[20px] w-fit shrink-0 flex-row items-end gap-[4px]">
    {
      Array.from({ length: 24 }, (_, i) => nowPlaying.bars[i % nowPlaying.bars.length]!).map(
        (h, i) => (
          <span
            class="w-[3px] shrink-0 origin-bottom rounded-[2px] bg-brand opacity-[0.55]"
            style={`height:${h}px;--eq-dur:${(0.8 + (i % 3) * 0.18).toFixed(2)}s;--eq-delay:${(-i * 0.13).toFixed(2)}s`}
          />
        ),
      )
    }
  </div>

  <!-- 进度条：hover 或播放时出现；点击/拖动跳转。挡住卡片自身的播放切换 -->
  <div
    data-np-seek
    class="absolute inset-x-[20px] bottom-[8px] h-[10px] cursor-pointer opacity-0 transition-opacity duration-300 group-hover/np:opacity-100 group-aria-pressed/np:opacity-100"
  >
    <div class="absolute inset-x-0 top-[4px] h-[3px] overflow-hidden rounded-[2px] bg-hairline">
      <div data-np-progress class="h-full w-0 rounded-[2px] bg-brand"></div>
    </div>
  </div>
</div>

<script>
  import { nowPlaying } from '~/config'

  /**
   * 播放器控制层。音频实体是模块级的 new Audio() —— 不进 DOM：
   * Astro 换页 swap 后会重建 body 里所有媒体元素（reifyMediaElements），
   * 连 transition:persist 的都保不住；游离对象则完全不受影响，跨页不断播。
   * 模块级状态（曲目索引 / AudioContext / 频谱 / 各曲歌词缓存）同理跨页存活，
   * 每次 astro:page-load 只重绑当前页的 UI。
   *
   * 首页同时渲染两张卡（桌面右栏一张、移动端流里一张，断点互斥各显其一），
   * 所以 UI 引用是「绑定组」数组：所有卡共享这一个 Audio，状态全量广播 ——
   * 谁可见谁就是播放器，切设备宽度也不丢状态。
   */
  type LrcLine = { t: number; text: string }
  type Track = { title: string; artist?: string; src: string; lrc?: string }

  const tracks: readonly Track[] = nowPlaying.playlist
  const trackLabel = (t: Track) => (t.artist ? `${t.title} — ${t.artist}` : t.title)

  let cur = 0
  const player = new Audio(tracks[0]!.src)
  player.preload = 'none'

  let audioCtx: AudioContext | undefined
  let analyser: AnalyserNode | undefined
  let freq: Uint8Array<ArrayBuffer> | undefined
  let raf = 0

  // 当前页的 UI 绑定组（每次 page-load 刷新；不在首页时为空数组，各处自然 no-op）
  interface Bind {
    card: HTMLElement
    line: HTMLElement | null
    lineText: HTMLElement | null
    bars: HTMLElement[]
    progress: HTMLElement | null
  }
  let binds: Bind[] = []

  const audio = () => player

  /** 首次播放时才建立 Web Audio 链路（需要用户手势，正好在 click 里） */
  const ensureGraph = (el: HTMLAudioElement) => {
    if (audioCtx) {
      audioCtx.resume()
      return
    }
    audioCtx = new AudioContext()
    const source = audioCtx.createMediaElementSource(el)
    analyser = audioCtx.createAnalyser()
    analyser.fftSize = 128
    analyser.smoothingTimeConstant = 0.75
    source.connect(analyser)
    analyser.connect(audioCtx.destination)
    freq = new Uint8Array(analyser.frequencyBinCount)
  }

  // 歌词按曲缓存；lrcLines 始终是「当前曲」解析好的行，tick 每帧直接查
  const lrcCache = new Map<string, Promise<LrcLine[]>>()
  let lrcLines: LrcLine[] = []

  const loadLrc = (track: Track) => {
    if (!track.lrc) {
      lrcLines = []
      return Promise.resolve([] as LrcLine[])
    }
    if (!lrcCache.has(track.lrc)) {
      lrcCache.set(
        track.lrc,
        fetch(track.lrc)
          .then((res) => (res.ok ? res.text() : ''))
          .then((text) => {
            const lines: LrcLine[] = []
            for (const row of text.split('\n')) {
              const m = /^\[(\d+):(\d+(?:\.\d+)?)\](.*)$/.exec(row.trim())
              if (m && m[3]!.trim())
                lines.push({ t: Number(m[1]) * 60 + Number(m[2]), text: m[3]!.trim() })
            }
            return lines.sort((a, b) => a.t - b.t)
          })
          .catch(() => []),
      )
    }
    return lrcCache.get(track.lrc)!.then((lines) => {
      // 异步返回时可能已经切到别的歌了，别把旧歌词塞给新曲
      if (tracks[cur]!.lrc === track.lrc) lrcLines = lines
      return lines
    })
  }

  /**
   * 歌词淡切：先淡出，换字后淡入。
   * karaoke=true 时给内层文本挂「唱到哪亮到哪」的渐变（见 global.css），
   * 每换一句从 0% 重新涨；显示曲名时摘掉渐变回普通墨色。
   */
  let shownText = ''
  const swapLine = (text: string, karaoke = false) => {
    if (binds.length === 0 || shownText === text) return
    shownText = text
    for (const b of binds) if (b.line) b.line.style.opacity = '0'
    setTimeout(() => {
      for (const b of binds) {
        if (!b.line || !b.lineText) continue
        b.lineText.textContent = text
        b.lineText.style.setProperty('--sung', '0%')
        b.lineText.toggleAttribute('data-karaoke', karaoke)
        b.line.style.opacity = '1'
      }
    }, 200)
  }

  /**
   * 播放循环：每帧 ① 等化条映射低中频段 ② 歌词定位当前句、
   * 句内线性插值推进 --sung（LRC 只有句级时间轴，句首句尾精准、句中匀速）。
   */
  const tick = () => {
    const el = audio()
    if (el.paused) return
    if (analyser && freq) {
      analyser.getByteFrequencyData(freq)
      const usable = Math.floor(freq.length * 0.7) // 高频段基本是空的，砍掉
      // 每根条的电平先算一遍，再广播给各张卡（两张卡条数相同）
      const count = binds[0]?.bars.length ?? 0
      for (let i = 0; i < count; i += 1) {
        const start = Math.floor((i / count) * usable)
        const end = Math.max(start + 1, Math.floor(((i + 1) / count) * usable))
        let sum = 0
        for (let j = start; j < end; j += 1) sum += freq[j]!
        const level = sum / (end - start) / 255
        const transform = `scaleY(${(0.25 + level * 0.95).toFixed(3)})`
        for (const b of binds) if (b.bars[i]) b.bars[i]!.style.transform = transform
      }
    }

    if (binds.length > 0 && lrcLines.length > 0) {
      const now = el.currentTime
      let idx = -1
      for (let i = 0; i < lrcLines.length; i += 1) {
        if (lrcLines[i]!.t <= now) idx = i
        else break
      }
      if (idx >= 0) {
        const curLine = lrcLines[idx]!
        swapLine(curLine.text, true)
        // 只有正在展示这句时才推进度（淡切的 200ms 里 shownText 已是新句）
        if (shownText === curLine.text) {
          const next =
            lrcLines[idx + 1]?.t ?? (Number.isFinite(el.duration) ? el.duration : curLine.t + 8)
          const pct = Math.min(1, Math.max(0, (now - curLine.t) / Math.max(0.5, next - curLine.t)))
          for (const b of binds) b.lineText?.style.setProperty('--sung', `${(pct * 100).toFixed(1)}%`)
        }
      }
    }
    raf = requestAnimationFrame(tick)
  }

  const setLive = (on: boolean) => {
    for (const b of binds) {
      b.card.setAttribute('aria-pressed', String(on))
      b.card.querySelector('[data-eq]')?.toggleAttribute('data-live', on)
    }
    cancelAnimationFrame(raf)
    if (on) raf = requestAnimationFrame(tick)
    else {
      for (const b of binds) for (const bar of b.bars) bar.style.transform = ''
      swapLine(trackLabel(tracks[cur]!))
    }
  }

  /** 切到第 i 首（取模循环）。autoplay 用于自动接歌与「下一首」 */
  const setTrack = (i: number, autoplay: boolean) => {
    cur = ((i % tracks.length) + tracks.length) % tracks.length
    const track = tracks[cur]!
    lrcLines = []
    shownText = ''
    player.src = track.src
    for (const b of binds) {
      if (b.progress) b.progress.style.width = '0%'
      b.card.setAttribute('aria-label', `播放 ${trackLabel(track)}`)
    }
    swapLine(trackLabel(track))
    loadLrc(track)
    if (autoplay) player.play().catch(() => setLive(false))
  }

  const toggle = () => {
    const el = audio()
    if (el.paused) {
      ensureGraph(el)
      el.play().catch(() => setLive(false))
    } else {
      el.pause()
    }
  }

  document.addEventListener('astro:page-load', () => {
    binds = [...document.querySelectorAll<HTMLElement>('[data-np]')].map((card) => ({
      card,
      line: card.querySelector<HTMLElement>('[data-np-line]'),
      lineText: card.querySelector<HTMLElement>('[data-np-text]'),
      bars: [...card.querySelectorAll<HTMLElement>('[data-eq] > span')],
      progress: card.querySelector<HTMLElement>('[data-np-progress]'),
    }))
    shownText = ''

    if (binds.length === 0) return

    // 回到首页时同步一次正在播放的状态与当前曲名
    setLive(!player.paused)
    if (!player.paused) {
      swapLine(trackLabel(tracks[cur]!))
      loadLrc(tracks[cur]!)
    }

    for (const { card } of binds) {
      card.addEventListener('click', toggle)
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          toggle()
        }
      })

      card.querySelector<HTMLElement>('[data-np-next]')?.addEventListener('click', (e) => {
        e.stopPropagation()
        ensureGraph(player)
        setTrack(cur + 1, true)
      })

      // 进度条：点击与拖动都走 pointer 事件；阻止冒泡以免触发整卡的播放切换
      const seek = card.querySelector<HTMLElement>('[data-np-seek]')
      if (seek) {
        const seekTo = (clientX: number) => {
          const a = audio()
          if (!Number.isFinite(a.duration) || a.duration <= 0) return
          const rect = seek.getBoundingClientRect()
          const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width))
          a.currentTime = ratio * a.duration
        }
        seek.addEventListener('click', (e) => e.stopPropagation())
        seek.addEventListener('pointerdown', (e) => {
          e.stopPropagation()
          try {
            seek.setPointerCapture(e.pointerId)
          } catch {
            // 合成事件（测试）没有真实 pointerId，捕获不了也不影响点击跳转
          }
          seekTo(e.clientX)
          const move = (ev: PointerEvent) => seekTo(ev.clientX)
          const up = () => {
            seek.removeEventListener('pointermove', move)
            seek.removeEventListener('pointerup', up)
          }
          seek.addEventListener('pointermove', move)
          seek.addEventListener('pointerup', up)
        })
      }
    }
  })

  // 音频实体是模块级常驻对象，事件只在模块层挂一次
  player.addEventListener('play', () => {
    setLive(true)
    loadLrc(tracks[cur]!)
  })
  player.addEventListener('pause', () => setLive(false))
  player.addEventListener('ended', () => setTrack(cur + 1, true))
  // 歌词句切换和渐变推进都在 tick（rAF）里做；timeupdate 只管进度条 ——
  // 它在暂停状态下拖进度时也会触发，宽度不会失同步
  player.addEventListener('timeupdate', () => {
    if (!Number.isFinite(player.duration) || player.duration <= 0) return
    const width = `${(player.currentTime / player.duration) * 100}%`
    for (const b of binds) if (b.progress) b.progress.style.width = width
  })
</script>
