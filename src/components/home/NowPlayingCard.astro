---
import { Icon } from 'astro-icon/components'
import { nowPlaying } from '~/config'
import { useI18n } from '~/i18n'
import { playerScriptText } from '~/utils/player-text'

const { t } = useI18n(Astro)

const tracks = nowPlaying.playlist
// fork 没有歌源时 playlist.json 清成 [] —— 整张卡不渲染，别让空歌单炸构建
const first = tracks[nowPlaying.defaultIndex]
const trackLabel = (track: { title: string; artist?: string }) =>
  track.artist ? `${track.title} — ${track.artist}` : track.title

/*
 * 脚本要用的文案（换曲时重算 aria-label、切模式时报当前模式、纯音乐提示）
 * 由服务端写进 data-* 交给脚本，见 utils/player-text.ts —— 听歌页那张播放台
 * 用的是同一份，所以抽成了函数。
 */
const scriptText = playerScriptText(t)
---

<!--
  Now Playing

  视觉骨架照设计：音波 icon + 「正在听」 + 曲名 + 等化条。
  能力（都不改布局）：
  - 点卡播放 / 暂停；多于一首时出现 上一首 / 下一首 / 播放模式 / 播放列表 钮，
    音量钮常驻；播放模式 顺序（列表循环）→ 随机 → 单曲循环 点击轮换、跨页记忆；
    放完按模式接歌；列表和音量是卡下方的玻璃弹层（互斥），点歌即切即播、面板自动收起
  - 播放时等化条由 Web Audio 实时频谱驱动，停下来回到设计的定格假谱
  - 曲名行播放时逐句显示 LRC 歌词，卡拉OK式从左往右点亮（唱到哪亮到哪）；
    渐变挂在贴文本宽的内层 span 上 —— 挂整行容器会按容器宽算，分界线跑得比人声快；
    句子长过卡宽时学 QQ 音乐横向跑马：唱过的字往左让位，位移量按句内进度算；
    同步学 APlayer 双入口：播放中 rAF 每帧对时 + seeked 事件兜底（暂停拖条也跟）
  - 底部细进度线，点击 / 拖动调进度；音量记 localStorage
-->
{first && (
<div
  data-np
  data-np-glow
  role="button"
  tabindex="0"
  aria-pressed="false"
  aria-label={t('player.play', { title: trackLabel(first) })}
  title={t('player.toggle')}
  {...scriptText}
  class="glass group/np relative box-border flex h-fit w-full shrink-0 cursor-pointer flex-col items-start justify-center gap-[10px] rounded-[30px] p-[20px]"
>
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <!-- lucide audio-lines 的 HTML span 等价形（六根圆帽竖线，逐线错相位律动，
         见 global.css 的 np-icon-dance）。不用 SVG：path 的 transform 动画在
         Blink 里走布局，每帧拖着全页重排 —— span 版才能上合成器。
         比例照原图 24 单位系：线宽 2、圆帽两端各加 1、线心距 4 -->
    <span data-np-icon aria-hidden="true" class="flex size-[18px] shrink-0 flex-row items-center justify-between px-[0.75px] text-brand">
      {[5, 13, 20, 9, 15, 5].map((h) => (
        <span class="w-[1.5px] shrink-0 rounded-full bg-current" style={`height:${((h / 24) * 100).toFixed(2)}%`} />
      ))}
    </span>
    <span class="flex-1 text-[12px] font-normal text-ink-soft">{t('player.caption')}</span>
    {
      tracks.length > 1 && (
        <>
          <button
            type="button"
            data-np-prev
            aria-label={t('player.prev')}
            title={t('player.prev')}
            class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
          >
            <Icon name="lucide:skip-back" class="size-[13px] shrink-0" />
          </button>
          <button
            type="button"
            data-np-next
            aria-label={t('player.next')}
            title={t('player.next')}
            class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
          >
            <Icon name="lucide:skip-forward" class="size-[13px] shrink-0" />
          </button>
          <button
            type="button"
            data-np-mode
            aria-label={t('player.mode')}
            title={t('player.mode')}
            class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
          >
            <Icon name="lucide:repeat" data-np-mode-order class="size-[13px] shrink-0" />
            <Icon name="lucide:shuffle" data-np-mode-shuffle class="hidden size-[13px] shrink-0" />
            <Icon name="lucide:repeat-1" data-np-mode-one class="hidden size-[13px] shrink-0" />
          </button>
          <button
            type="button"
            data-np-toggle-list
            aria-label={t('player.playlist')}
            title={t('player.playlistCount', { n: tracks.length })}
            class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
          >
            <Icon name="lucide:list-music" class="size-[13px] shrink-0" />
          </button>
        </>
      )
    }
    <button
      type="button"
      data-np-vol-btn
      aria-label={t('player.volume')}
      title={t('player.volume')}
      class="flex size-[22px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[8px] text-ink-muted opacity-0 transition-opacity group-hover/np:opacity-100 hover:bg-chip max-xl:opacity-100"
    >
      <Icon name="lucide:volume-2" data-np-vol-on class="size-[13px] shrink-0" />
      <Icon name="lucide:volume-x" data-np-vol-off class="hidden size-[13px] shrink-0" />
    </button>
    <!-- 播放/暂停的小提示角标，跟随状态换图标 -->
    <Icon
      name="lucide:play"
      class="size-[13px] shrink-0 text-ink-muted transition-opacity group-aria-pressed/np:hidden"
    />
    <Icon
      name="lucide:pause"
      class="hidden size-[13px] shrink-0 text-brand-ink group-aria-pressed/np:block"
    />
  </div>

  <!-- 外层管淡切与截断（歌词溢出时切成 clip + 两端羽化，见 global.css）；
       内层贴文本宽 inline-block：卡拉OK渐变 + 跑马位移都挂它身上 -->
  <span
    data-np-line
    class="w-full truncate text-[14px] font-medium text-ink transition-opacity duration-150"
  >
    <span data-np-text class="inline-block">{trackLabel(first)}</span>
  </span>

  <!-- 条形高度循环设计定格的那 12 个值。48 根 + justify-between 铺满整行
       （此前 24 根定宽只到卡一半，右边空着难受——用户点名）。
       不播放就静止在这套定格谱形（用户点名：波浪只在放歌时动）；
       播放（data-live）：JS 用实时频谱逐条写 scaleY —— 律动跟歌走，见 global.css -->
  <div data-eq class="flex h-[20px] w-full shrink-0 flex-row items-end justify-between">
    {
      Array.from({ length: 48 }, (_, i) => nowPlaying.bars[i % nowPlaying.bars.length]!).map(
        (h) => (
          <span
            class="w-[3px] shrink-0 origin-bottom rounded-[2px] bg-brand opacity-[0.55]"
            style={`height:${h}px`}
          />
        ),
      )
    }
  </div>

  <!-- 进度条：hover 或播放时出现；点击/拖动跳转。挡住卡片自身的播放切换 -->
  <div
    data-np-seek
    class="absolute inset-x-[20px] bottom-[8px] h-[10px] cursor-pointer opacity-0 transition-opacity duration-300 group-hover/np:opacity-100 group-aria-pressed/np:opacity-100"
  >
    <div class="absolute inset-x-0 top-[4px] h-[3px] overflow-hidden rounded-[2px] bg-hairline">
      {/* 进度走 transform: scaleX（width 变化要布局+整卡重绘）；初始值必须
          内联 —— Tailwind v4 的 scale-x-0 走 scale 属性，会和 JS 写的
          transform 相乘（ReadingProgress 踩过的同一个坑） */}
      <div data-np-progress class="h-full w-full origin-left rounded-[2px] bg-brand" style="transform:scaleX(0)"></div>
    </div>
  </div>

  <!-- 播放列表弹层：悬浮在卡下方（卡不再 overflow-hidden 才探得出去），
       玻璃底 + 内滚动；点行切歌不关面板，方便连着试听。打开时 JS 给卡提 z-index，
       不然后面卡片的 backdrop-filter 层叠上下文会压住它 -->
  {
    tracks.length > 1 && (
      <div
        data-np-list
        hidden
        class="glass absolute inset-x-[6px] top-[calc(100%+10px)] z-10 box-border max-h-[272px] cursor-default overflow-y-auto rounded-[24px] p-[8px] shadow-[var(--glass-ring),0_26px_52px_-22px_var(--shadow-soft)]"
      >
        {/* 循环变量原先叫 t，会遮蔽 i18n 的取词函数 —— 改名 track，别让下次加一句
            译文时踩到「t 是歌还是翻译函数」的坑 */}
        {tracks.map((track, i) => (
          <button
            type="button"
            data-np-item={i}
            class="flex w-full cursor-pointer flex-row items-center gap-[10px] rounded-[16px] px-[12px] py-[8px] text-left text-[13px] text-ink-soft transition-colors hover:bg-chip data-current:bg-chip data-current:text-brand-ink"
          >
            <span class="w-[20px] shrink-0 text-[11px] tabular-nums opacity-60">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0 flex-1 truncate font-medium">{track.title}</span>
            {track.artist && (
              <span class="max-w-[45%] shrink-0 truncate text-[11px] text-ink-muted">
                {track.artist}
              </span>
            )}
          </button>
        ))}
      </div>
    )
  }

  <!-- 音量弹层：与播放列表同款、互斥（实底也走 global.css 的同色双叠，
       嵌套 backdrop-filter 糊不动）；音量记在 localStorage，跨页跨曲不丢 -->
  <div
    data-np-vol
    hidden
    class="glass absolute inset-x-[6px] top-[calc(100%+10px)] z-10 box-border cursor-default rounded-[20px] px-[16px] py-[13px] shadow-[var(--glass-ring),0_26px_52px_-22px_var(--shadow-soft)]"
  >
    <div class="flex w-full flex-row items-center gap-[12px]">
      <Icon name="lucide:volume-1" class="size-[14px] shrink-0 text-ink-muted" />
      <input
        data-np-vol-range
        type="range"
        min="0"
        max="100"
        step="1"
        aria-label={t('player.volume')}
        class="min-w-0 flex-1 cursor-pointer"
      />
      <span data-np-vol-pct class="w-[36px] shrink-0 text-right text-[11px] tabular-nums text-ink-muted"></span>
    </div>
  </div>
</div>
)}

<!--
  控制层搬到了 src/scripts/player.ts —— 听歌页（/music）那张最大化播放台要用同一套：
  同一个 Audio 单例、同一份曲目/歌词/音量状态，两页之间来回走不断播。
  引擎按 [data-np] 找卡、把状态广播给页面上所有绑定组，所以这里只要引一下。
-->
<script>
  import '~/scripts/player'
</script>
