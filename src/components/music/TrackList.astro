---
import { Icon } from 'astro-icon/components'
import { nowPlaying } from '~/config'
import { useI18n } from '~/i18n'

const { t } = useI18n(Astro)

/*
 * 歌单 + 搜索
 *
 * 行的点击由引擎接（scripts/player.ts 按 [data-np-item] 绑定，索引 = 数组下标），
 * 所以搜索只做「隐藏不匹配的行」，绝不重排、不重建 —— 下标和曲目永远对得上。
 * 外层刻意不叫 data-np-list：那是首页弹层的名字，引擎会在点页面别处时把它收起来。
 *
 * 搜索的三处动态文案（计数 / 无结果）是模板，服务端写在 data-tpl 上，
 * 脚本用 fill() 填 —— 客户端不引字典（见 scripts/i18n.ts）。
 */
const tracks = nowPlaying.playlist
---

<!-- 桌面：撑满所在列（列高来自右栏拉伸，见 MusicView），列表区吃掉多出的高度内滚 -->
<section
  class="glass-panel box-border flex h-fit w-full shrink-0 flex-col items-start gap-[12px] rounded-[28px] p-[16px] xl:h-full"
>
  <div class="flex w-full shrink-0 flex-row items-center gap-[10px]">
    <span class="flex-1 text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
      {t('music.listCaption')}
    </span>
    <span
      data-track-count
      data-tpl={t('music.searchCount', { n: '{n}', total: '{total}' })}
      class="shrink-0 text-[11.5px] font-normal tabular-nums text-ink-muted"
    >
      {t('music.searchCount', { n: tracks.length, total: tracks.length })}
    </span>
  </div>

  <label
    class="hairline-box box-border flex w-full shrink-0 cursor-text flex-row items-center gap-[9px] rounded-full px-[14px] py-[9px]"
  >
    <Icon name="lucide:search" class="size-[15px] shrink-0 text-ink-muted" />
    <input
      data-track-search
      type="search"
      placeholder={t('music.searchPlaceholder')}
      aria-label={t('music.searchAria')}
      autocomplete="off"
      class="min-w-0 flex-1 bg-transparent text-[13px] font-normal text-ink outline-none placeholder:text-ink-muted"
    />
    <button
      type="button"
      data-track-clear
      hidden
      aria-label={t('music.searchClear')}
      title={t('music.searchClear')}
      class="flex size-[20px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-chip hover:text-ink"
    >
      <Icon name="lucide:x" class="size-[13px] shrink-0" />
    </button>
  </label>

  {/* 高度三档：移动端 300 封顶；原版模式不封顶（列高由左栏撑，与歌词严格平齐，
      见 MusicView）；紧凑模式没有左栏可撑，就自己定高 —— 740 = 20 行 × 37
      （实测单行 37px，用户点名要「一屏 20 首」），歌词面板绝对填充同一行高，
      于是左边歌词也跟着长到同样高度 */}
  <div
    data-track-list
    class="flex max-h-[300px] w-full shrink-0 flex-col items-start overflow-y-auto xl:min-h-0 xl:flex-1 xl:shrink compact:xl:max-h-[740px] classic:xl:max-h-none"
  >
    {
      tracks.map((track, i) => (
        <button
          type="button"
          data-np-item={i}
          data-track-row
          data-search={`${track.title} ${track.artist ?? ''}`.toLowerCase()}
          class="flex w-full shrink-0 cursor-pointer flex-row items-center gap-[10px] rounded-[16px] px-[12px] py-[9px] text-left text-[13px] text-ink-soft transition-colors hover:bg-chip data-current:bg-chip data-current:text-brand-ink"
        >
          <span class="w-[20px] shrink-0 text-[11px] tabular-nums opacity-60">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="min-w-0 flex-1 truncate font-medium">{track.title}</span>
          {track.artist && (
            <span class="max-w-[45%] shrink-0 truncate text-[11px] text-ink-muted">
              {track.artist}
            </span>
          )}
        </button>
      ))
    }
  </div>

  <p
    data-track-empty
    hidden
    data-tpl={t('music.searchEmpty', { q: '{q}' })}
    class="w-full shrink-0 px-[12px] py-[6px] text-[12.5px]/[20px] font-normal text-ink-muted"
  >
  </p>
</section>
