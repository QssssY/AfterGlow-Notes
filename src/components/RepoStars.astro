---
/**
 * 浏览器端拉 GitHub star 数。只放脚本，不渲染任何东西。
 *
 * 为什么不在构建时拉：GitHub 匿名接口按 IP 限流 60 次/时，构建机是单 IP，
 * 而放到访客浏览器里每人各占自己的配额，反而不容易撞限流（Firefly 的做法）。
 * 代价是数字要等一个往返才刷新，所以构建时先渲染 config 里的兜底值。
 *
 * 契约：带 data-gh="owner/repo" 的元素内，[data-gh-stars] 收 star 数，
 * 页面上的 [data-gh-total] 收所有仓库的 star 总和。
 */
---

<script>
  const fmt = new Intl.NumberFormat('en-US', { notation: 'compact' })

  /**
   * localStorage 两级缓存，治 403 刷屏：
   * - 拉到的数字存 1 小时：F5 / 换页 / 新开标签都不再发请求；
   * - 失败也记 15 分钟（负缓存）。之前失败不缓存，撞了限流后每次换页
   *   重试 3 个仓库，控制台被红色 403 刷满（用户报过）。
   * 记录含义是「最近一次检查时间 + 已知的最好数字」：失败时保留旧成功值，
   * 显示上比退回构建兜底更接近真相。
   */
  const OK_TTL = 3_600_000
  const FAIL_TTL = 900_000
  interface Hit {
    stars: number | null
    at: number
  }

  const read = (repo: string): Hit | null => {
    try {
      const raw = localStorage.getItem(`firefly:gh:${repo}`)
      return raw ? (JSON.parse(raw) as Hit) : null
    } catch {
      return null
    }
  }
  const write = (repo: string, hit: Hit) => {
    try {
      localStorage.setItem(`firefly:gh:${repo}`, JSON.stringify(hit))
    } catch {
      // 隐私模式存不了：退化成每次整页加载拉一轮
    }
  }

  const fetchOne = async (repo: string) => {
    const hit = read(repo)
    if (hit && Date.now() - hit.at < (hit.stars === null ? FAIL_TTL : OK_TTL)) {
      return hit.stars === null ? null : { repo, stars: hit.stars }
    }
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`, {
        referrerPolicy: 'no-referrer',
      })
      if (!res.ok) throw new Error(String(res.status))
      const data = (await res.json()) as { stargazers_count: number }
      const stars = Number(data.stargazers_count)
      write(repo, { stars, at: Date.now() })
      return { repo, stars }
    } catch {
      // 限流、离线、仓库转私有都到这里：负缓存 15 分钟，带上旧值（可能为 null）
      const stale = hit?.stars ?? null
      write(repo, { stars: stale, at: Date.now() })
      return stale === null ? null : { repo, stars: stale }
    }
  }

  document.addEventListener('astro:page-load', () => {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-gh]')]
    if (cards.length === 0) return

    const names = [...new Set(cards.map((card) => card.dataset.gh!))]

    Promise.all(names.map(fetchOne)).then((results) => {
      let total = 0
      let ok = 0

      for (const result of results) {
        if (!result) continue
        ok++
        total += result.stars
        for (const card of cards) {
          if (card.dataset.gh !== result.repo) continue
          const slot = card.querySelector<HTMLElement>('[data-gh-stars]')
          if (slot) slot.textContent = fmt.format(result.stars)
        }
      }

      // 只有全部拉到才改总数。少拉一个就写总和，会显示成比真实值更小的数字，
      // 那比干脆不动更糟 —— 单张卡拉失败只是那张卡不刷新，总数仍然自洽。
      if (ok === names.length) {
        for (const slot of document.querySelectorAll<HTMLElement>('[data-gh-total]')) {
          slot.textContent = fmt.format(total)
        }
      }
    })
  })
</script>
