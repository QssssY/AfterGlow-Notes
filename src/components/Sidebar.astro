---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { email } from '~/config'
import { useI18n } from '~/i18n'
import { siteAvatar as avatarSrc } from '~/utils/site-images'
import { handleOf } from '~/utils/social'
import BilibiliIcon from './BilibiliIcon.astro'
import LangSwitch from './LangSwitch.astro'
import NavItem from './NavItem.astro'

const { t, c, nav, path } = useI18n(Astro)
const { site, socials } = c

// 社交按钮从管理端可改的 socials 里挑：第一颗深色款进 GitHub 位、
// 第一颗玻璃款进 bilibili 位；对应款式缺席时按顺序兜底，不让构建崩
const github = socials.find((s) => s.variant === 'dark') ?? socials[0]!
const bilibili = socials.find((s) => s.variant === 'glass') ?? socials[socials.length - 1]!

// 外观三档 —— 值是写进 localStorage 的键（与语言无关），文案按语种取
const themeChoices = [
  { value: 'light', label: t('theme.light') },
  { value: 'dark', label: t('theme.dark') },
  { value: 'auto', label: t('theme.auto') },
] as const
---

<!-- Sidebar
     不挂任何 View Transitions 共享元素名（历史上 site-sidebar / nav-avatar 都试过）：
     带 backdrop-filter 的玻璃卡被拍成过渡快照会渲染成一块模糊空板（「神秘小方块」）。
     换页动效照搬 YYsuni：瞬时切换，本卡随 panel-enter 弹入。 -->
<aside
  data-sidebar
  class="glass box-border flex w-[280px] flex-col items-start gap-[26px] rounded-[36px] p-[24px]"
>
  <!-- Brand -->
  <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[13px]">
    <div class="flex h-fit w-full shrink-0 flex-row items-center justify-between gap-[10px]">
      <a href={path('/')} class="flex h-fit w-fit shrink-0 flex-row items-center gap-[9px]">
        <span
          class="flex size-[26px] shrink-0 flex-row items-center justify-center rounded-[13px] bg-fire-tint"
        >
          <span
            class="site-dot size-[9px] shrink-0 rounded-full bg-brand shadow-[0_0_10px_0_var(--glow-fire)]"
          ></span>
        </span>
        <span class="font-display text-[19px]/[19px] font-normal whitespace-nowrap text-ink">
          {site.title}
        </span>
      </a>
      <a
        href={path('/rss.xml')}
        aria-label={t('common.rss')}
        title={t('common.rss')}
        class="hairline-box flex h-[28px] w-[30px] shrink-0 flex-row items-center justify-center rounded-[12px]"
      >
        <Icon name="lucide:rss" class="size-[14px] shrink-0 text-ink-soft" />
      </a>
    </div>

    <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[10px]">
      <span class="flex size-[34px] shrink-0">
        <Image
          src={avatarSrc}
          alt={site.author}
          width={68}
          height={68}
          class="size-[34px] shrink-0 rounded-[17px] object-cover shadow-[0_10px_18px_-4px_var(--color-dot-idle)]"
        />
      </span>
      <span class="font-display text-[18px]/[18px] font-medium whitespace-nowrap text-ink">
        {site.author}
      </span>
      <span class="text-[11px] font-medium whitespace-nowrap text-brand-ink">
        {site.authorBadge}
      </span>
    </div>
  </div>

  <!-- General Group -->
  <nav data-nav class="relative flex h-fit w-full shrink-0 flex-col items-start gap-[8px]">
    <span class="text-[12px] font-normal tracking-[1.2px] whitespace-nowrap text-ink-soft">
      {t('sidebar.general')}
    </span>
    <!-- 滑动高亮：跟着指针在条目间弹跳（YYsuni nav-hover 胶囊的 CSS 版），
         位置由下面的脚本摆，键盘 focus 一并跟随；不动激活态那块 glass-solid -->
    <span
      data-nav-glow
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-0 w-full rounded-[26px] bg-card opacity-0 outline-1 -outline-offset-[0.5px] outline-card-border"></span>
    <!-- 激活胶囊（换页果冻滑动）：脚本接管后条目自己的 glass-solid 摘掉，
         高亮由这颗从上一页的位置弹簧滑过来；无 JS 时条目类名兜底 -->
    <span
      data-nav-active
      aria-hidden="true"
      class="glass-solid pointer-events-none absolute top-0 left-0 w-full rounded-[26px] opacity-0"></span>
    {
      nav.map((item) => (
        <NavItem label={item.label} icon={item.icon} href={item.href} active={item.active} full />
      ))
    }
  </nav>

  {/*
    Social Row —— 设计这轮新加的一行，首页顶部那排大按钮挪到了这里。
    Github 是 Social Button 组件的深色实例，但尺寸另一套（h30 / r12 / 图标 16 /
    Averia 14），所以没复用 SocialButton.astro（那份是 h42 / r14 / 图标 22）。

    按钮的 title 从 socials.json 的地址现推（形如「GitHub · 账号名」），不写死账号 ——
    fork 的人在管理台「社交链接」改完地址，这里要跟着变。
    这里用 JSX 注释而不是 HTML 注释：后者会原样进产物，而这段是给读代码的人看的。
  */}
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <a
      href={github.href}
      target="_blank"
      rel="noopener noreferrer"
      title={`${github.label} · ${handleOf(github.href)}`}
      class="flex h-[30px] flex-1 flex-row items-center justify-center gap-[8px] rounded-[12px] bg-btn-dark px-[12px] outline-[1.5px] -outline-offset-[0.75px] outline-sheen shadow-[0_24px_44px_-16px_var(--shadow-soft),0_0_20px_0_var(--sheen)] backdrop-blur-[4px]"
    >
      <Icon name="lucide:github" class="size-[16px] shrink-0 text-white" />
      <span class="font-display text-[14px] font-normal whitespace-nowrap text-white">
        {github.label}
      </span>
    </a>

    <a
      href={bilibili.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('sidebar.bilibili')}
      title={t('sidebar.bilibili')}
      class="hairline-box flex h-[30px] w-fit shrink-0 flex-row items-center justify-center rounded-[12px] px-[8px]"
    >
      <BilibiliIcon class="size-[15px] shrink-0 text-ink-soft" />
    </a>

    <!-- 点击复制邮箱（用户点名，比拉起邮件客户端友好）；复制成功图标换对勾 1.6s，
         剪贴板不可用（非 HTTPS / 被拒）时退回 mailto 老行为 -->
    <button
      type="button"
      data-copy-mail
      aria-label={t('sidebar.copyMail')}
      title={t('sidebar.copyMailTitle', { email })}
      class="hairline-box flex h-[30px] w-fit shrink-0 cursor-pointer flex-row items-center justify-center rounded-[12px] px-[8px]"
    >
      <Icon name="lucide:mail" data-mail-icon class="size-[15px] shrink-0 text-ink-soft" />
      <Icon name="lucide:check" data-mail-ok class="hidden size-[15px] shrink-0 text-brand-ink" />
    </button>
  </div>

  <script>
  import { email } from '~/config'
  import { copyText } from '~/scripts/clipboard'

  // 激活胶囊的上一页位置 —— 模块级跨页存活，换页滑动全靠它记路
  let lastNavActive: { top: number; height: number } | null = null

  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
      // 邮件钮 = 复制邮箱：成功换对勾 1.6s；剪贴板不可用退回 mailto
      for (const btn of document.querySelectorAll<HTMLElement>('[data-copy-mail]')) {
        const mailIcon = btn.querySelector<HTMLElement>('[data-mail-icon]')
        const okIcon = btn.querySelector<HTMLElement>('[data-mail-ok]')
        let timer = 0
        btn.addEventListener('click', async () => {
          // 纯 HTTP 下 navigator.clipboard 不存在，copyText 里有 execCommand 兜底；
          // 两条路都失败才退回 mailto
          if (!(await copyText(email))) {
            location.href = `mailto:${email}`
            return
          }
          mailIcon?.classList.add('hidden')
          okIcon?.classList.remove('hidden')
          clearTimeout(timer)
          timer = window.setTimeout(() => {
            okIcon?.classList.add('hidden')
            mailIcon?.classList.remove('hidden')
          }, 1600)
        })
      }

      // 滑动高亮：hover / focus 到哪个条目，胶囊就弹到哪；离开整组淡出
      for (const navEl of document.querySelectorAll<HTMLElement>('[data-nav]')) {
        const glow = navEl.querySelector<HTMLElement>('[data-nav-glow]')
        const items = [...navEl.querySelectorAll<HTMLElement>('a')]
        if (!glow || items.length === 0) continue

        // 激活胶囊的果冻滑动：底盘跨页连续（data-enter-static）且记着上一页的
        // 位置时，先无过渡落在旧位置、下一帧弹簧滑到新激活项 —— YYsuni 的
        // layoutId 手感；首载或底盘刚现身就直接落位
        const activePill = navEl.querySelector<HTMLElement>('[data-nav-active]')
        const activeItem = navEl.querySelector<HTMLElement>('a[aria-current="page"]')
        if (activePill && activeItem && navEl.offsetWidth > 0) {
          activeItem.classList.remove('glass-solid') // 高亮交给胶囊，别双份
          // 位移走 transform（top 过渡是布局动画，弹簧的每一帧都要整页样式
          // 重算+布局+重绘，正撞上换页入场窗 —— 2026-08-29 掉帧复盘）；
          // height 不过渡直接落值：导航条目等高，跳变不可见
          const place = (p: { top: number; height: number }) => {
            activePill.style.transform = `translateY(${p.top}px)`
            activePill.style.height = `${p.height}px`
            activePill.style.opacity = '1'
          }
          const target = { top: activeItem.offsetTop, height: activeItem.offsetHeight }
          const continuous = navEl.closest('[data-sidebar]')?.hasAttribute('data-enter-static')
          if (continuous && lastNavActive && lastNavActive.top !== target.top) {
            activePill.style.transition = 'none'
            place(lastNavActive)
            void activePill.offsetWidth // 先在旧位置落定，再恢复过渡滑过去
            activePill.style.transition = ''
            requestAnimationFrame(() => place(target))
          } else {
            activePill.style.transition = 'none'
            place(target)
            void activePill.offsetWidth
            activePill.style.transition = ''
          }
          lastNavActive = target
        }

        const moveTo = (item: HTMLElement) => {
          glow.style.transform = `translateY(${item.offsetTop}px)`
          glow.style.height = `${item.offsetHeight}px`
          glow.style.opacity = '1'
        }
        const hide = () => {
          glow.style.opacity = '0'
        }

        for (const item of items) {
          item.addEventListener('mouseenter', () => moveTo(item))
          item.addEventListener('focus', () => moveTo(item))
          item.addEventListener('blur', hide)
        }
        navEl.addEventListener('mouseleave', hide)
      }
  })
</script>

  <!-- Appearance Group -->
  <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[10px]">
    <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
      {t('sidebar.appearance')}
    </span>
    <div
      role="radiogroup"
      aria-label={t('theme.aria')}
      data-theme-switch
      class="hairline-box flex h-fit w-full shrink-0 flex-row items-center gap-[2px] rounded-[12px] p-[3px]"
    >
      {
        themeChoices.map((choice) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-theme-choice={choice.value}
            class="group flex h-[26px] flex-1 flex-row items-center justify-center gap-[5px] rounded-[6px] outline-1 -outline-offset-[0.5px] outline-transparent aria-checked:bg-card-solid aria-checked:outline-hairline"
          >
            <Icon
              name="lucide:sun-moon"
              class="hidden size-[12px] shrink-0 text-brand-ink group-aria-checked:block"
            />
            <span class="text-[11.5px] font-normal whitespace-nowrap text-ink-muted group-aria-checked:font-bold group-aria-checked:text-brand-ink">
              {choice.label}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Layout Group —— 布局双模式（用户点名要的开关）：
       原版 = 完整侧栏；紧凑 = YYsuni 式图标条 + 短栏。
       控件样式复用上面外观切换那套；绑定在 BaseLayout（data-layout-choice）。 -->
  <div class="flex h-fit w-full shrink-0 flex-col items-start gap-[10px]">
    <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
      {t('sidebar.layout')}
    </span>
    <div
      role="radiogroup"
      aria-label={t('layout.aria')}
      class="hairline-box flex h-fit w-full shrink-0 flex-row items-center gap-[2px] rounded-[12px] p-[3px]"
    >
      {
        [
          { value: 'classic', label: t('layout.classic'), hint: t('layout.classicHint') },
          { value: 'compact', label: t('layout.compact'), hint: t('layout.compactHint') },
        ].map((choice) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-layout-choice={choice.value}
            title={choice.hint}
            class="group flex h-[26px] flex-1 flex-row items-center justify-center gap-[5px] rounded-[6px] outline-1 -outline-offset-[0.5px] outline-transparent aria-checked:bg-card-solid aria-checked:outline-hairline"
          >
            <Icon
              name="lucide:layout-template"
              class="hidden size-[12px] shrink-0 text-brand-ink group-aria-checked:block"
            />
            <span class="text-[11.5px] font-normal whitespace-nowrap text-ink-muted group-aria-checked:font-bold group-aria-checked:text-brand-ink">
              {choice.label}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Language Group —— 与上面两组同款分段控件，摆在最后一格：
       语言是最少改动的一项，放外观和布局之后符合「越常用越靠上」 -->
  <LangSwitch variant="segment" />
</aside>
