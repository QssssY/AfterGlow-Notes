---
import { useI18n } from '~/i18n'

interface Entry {
  title: string
  date: string
  desc: string
  /** 当前版本：左侧竖线与圆点用品牌橙，并显示「当前」角标 */
  current?: boolean
  badge?: string
}

interface Props {
  entries: readonly Entry[]
}

const { entries } = Astro.props
const { t } = useI18n(Astro)
---

<!-- Changelog Card
     圆点用 2px 的 cream 描边把左侧竖线「打穿」，所以描边色必须跟随页面底色。 -->
<div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start rounded-[30px] px-[30px] py-[28px]">
  <span class="text-[12px] font-normal whitespace-nowrap text-ink-soft">
    {t('about.changelogTitle')}
  </span>

  {
    entries.map((entry, i) => (
      <div
        class:list={[
          'relative flex h-fit w-full shrink-0 flex-col items-start gap-[6px] border-l-[1.5px] pt-[16px] pl-[22px]',
          // 末项没有下内边距：设计里左侧竖线到这里就收住，不再多留一段
          i === entries.length - 1 ? 'pb-0' : 'pb-[16px]',
          entry.current ? 'border-brand' : 'border-hairline',
        ]}
      >
        <span
          class:list={[
            'absolute top-[20px] left-[-4.5px] z-0 size-[9px] rounded-full outline-2 -outline-offset-1 outline-cream',
            entry.current ? 'bg-brand' : 'bg-dot-idle',
          ]}
        />

        {/*
          窄屏把「徽章 + 日期」整组挪到第二行：它们是固定宽且 shrink-0，留在同一行会把
          标题的可用宽压到 158px，英文首条（带 current 徽章那条）要 246px，直接吞掉 36%。
          设计稿是定宽画布、标题 nowrap，没有规定窄屏怎么办 —— 所以 sm 以上照设计一行排。
        */}
        <span class="relative z-[1] flex h-fit w-full shrink-0 flex-col items-start gap-[4px] sm:flex-row sm:items-center sm:gap-[10px]">
          {/* 标题超宽省略号：320 宽下 nowrap 标题会把右侧日期顶出视口 */}
          <span class="w-full min-w-0 truncate text-[15px] font-medium text-ink sm:w-auto">
            {entry.title}
          </span>

          <span class="flex h-fit w-full shrink-0 flex-row items-center gap-[10px] sm:w-auto sm:flex-1">
            {entry.badge && (
              <span class="flex h-fit w-fit shrink-0 flex-row rounded-[10px] bg-fire-tint px-[8px] py-[3px]">
                <span class="text-[10px] font-medium whitespace-nowrap text-brand-ink">
                  {entry.badge}
                </span>
              </span>
            )}
            <span class="hidden h-[1px] flex-1 sm:block" />
            <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{entry.date}</span>
          </span>
        </span>

        <span class="relative z-[2] w-full text-[13px]/[23px] font-normal text-ink-soft">
          {entry.desc}
        </span>
      </div>
    ))
  }
</div>
