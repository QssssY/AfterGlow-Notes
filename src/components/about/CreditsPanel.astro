---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

const { t } = useI18n(Astro)

/**
 * 致谢 CREDITS · 关于页内容流，站点更新日志之下（用户定位）。
 *
 * 全宽玻璃卡（外壳对齐 ChangelogCard）：声明个人学习项目身份，
 * 致谢两个借鉴的开源博客 —— 界面雏形与静态站基础设施参考 CuteLeaf/Firefly，
 * 紧凑布局、粘性策略和首页大时钟学的 YYsuni/2025-blog-public。
 * 两条链接做成 chip 行卡，样式与下方友链面板的朋友卡同款。
 */
const credits = [
  {
    name: 'CuteLeaf / Firefly',
    note: t('about.creditsNoteA'),
    href: 'https://github.com/CuteLeaf/Firefly',
  },
  {
    name: 'YYsuni / 2025-blog-public',
    note: t('about.creditsNoteB'),
    href: 'https://github.com/YYsuni/2025-blog-public',
  },
]
---

<!-- Credits · 关于页 -->
<div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[14px] rounded-[30px] px-[30px] py-[28px]">
  <div class="flex h-fit w-full shrink-0 flex-row items-center justify-between gap-[10px]">
    <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
      {t('about.creditsCaption')}
    </span>
    <span class="text-[12px] font-normal text-ink-muted">{t('about.creditsBadge')}</span>
  </div>

  <p class="w-full text-[13px]/[22px] font-normal text-ink-soft">{t('about.creditsBlurb')}</p>

  <div class="flex h-fit w-full shrink-0 flex-col items-stretch gap-[12px] xl:flex-row">
    {
      credits.map((credit) => (
        <a
          href={credit.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group box-border flex w-full flex-row items-center gap-[12px] rounded-[22px] bg-chip px-[16px] py-[13px] outline-1 -outline-offset-[0.5px] outline-hairline xl:flex-1"
        >
          <span class="flex size-[34px] shrink-0 flex-row items-center justify-center rounded-[12px] bg-fire-tint">
            <Icon name="lucide:github" class="size-[16px] shrink-0 text-brand-ink" />
          </span>
          <span class="flex h-fit min-w-0 flex-1 flex-col items-start gap-[2px]">
            <span class="w-full truncate text-[13.5px]/[18px] font-medium text-ink">
              {credit.name}
            </span>
            <span class="w-full truncate text-[11.5px]/[15px] font-normal text-ink-muted">
              {credit.note}
            </span>
          </span>
          <Icon
            name="lucide:arrow-up-right"
            class="size-[14px] shrink-0 text-brand-ink transition-transform group-hover:-translate-y-[1px] group-hover:translate-x-[1px]"
          />
        </a>
      ))
    }
  </div>
</div>
