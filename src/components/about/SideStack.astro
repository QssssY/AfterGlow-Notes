---
import { Icon } from 'astro-icon/components'

interface Props {
  /** live 的那条（次喜欢）由浏览器端向 Go 后端现查，查不到保持占位 — 不编数字 */
  stats: readonly { value: string; label: string; live?: boolean }[]
  contacts: readonly { icon: string; value: string; href: string }[]
}

const { stats, contacts } = Astro.props
---

<!-- Side Stack -->
<div class="flex h-fit w-full shrink-0 flex-col items-start gap-[24px] xl:w-[320px]">
  <!-- Stats Card -->
  <div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[16px] rounded-[30px] p-[26px]">
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-soft">站点数据</span>
    {
      stats.map((stat, i) => (
        <>
          {i > 0 && <span class="h-[1px] w-full shrink-0 bg-hairline" />}
          <span class="flex h-fit w-full shrink-0 flex-row items-end gap-[8px]">
            <span
              class="font-display flex-1 text-[22px]/[22px] font-normal text-ink"
              data-countup
              data-stat-likes={stat.live ? '' : undefined}
            >
              {stat.value}
            </span>
            <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{stat.label}</span>
          </span>
        </>
      ))
    }
  </div>

  <!-- Contact Card -->
  <div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[12px] rounded-[30px] p-[26px]">
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-soft">写信给我</span>
    {
      contacts.map((contact) => (
        <a
          href={contact.href}
          class="group flex h-fit w-full shrink-0 flex-row items-center gap-[10px]"
        >
          <Icon
            name={`lucide:${contact.icon}`}
            class="size-[17px] shrink-0 text-ink-muted transition-colors group-hover:text-brand-ink"
          />
          <span class="flex-1 text-[13px] font-normal text-ink transition-colors group-hover:text-brand-ink">
            {contact.value}
          </span>
        </a>
      ))
    }
  </div>
</div>

<script>
  import { getLikes, swr } from '~/scripts/api'
  // 「次喜欢」的真实数字：后端在就现查回填，不在就保持 — 占位。
  // swr 先回放上次的数字（秒出），网络应答到了再校正
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-stat-likes]')
    if (!el) return
    swr('likes:site', () => getLikes('site'), (state) => {
      el.textContent = String(state.count)
    })
  })
</script>
