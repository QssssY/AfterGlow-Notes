---
import Panel from '~/components/Panel.astro'
import { uptime } from '~/config'
import { useI18n } from '~/i18n'
import { buildInfo } from '~/utils/build'
import { calendarDaysSince } from '~/utils/post'

const { t, c, fmt } = useI18n(Astro)
const { build } = c

/**
 * 构建 BUILD
 *
 * 四行键值的值用等宽字（设计写的是 $--font-primary = JetBrains Mono），
 * 和站内其他数字/技术文本一致。
 *
 * 设计把版本号和时间都写死了。这里只有「托管」是静态的（还没定平台），
 * 框架 / 样式从 package.json 读，上次构建是构建时刻，天数实时算 —— 都不会过期。
 * 设计 Status Row 里还有一行「构建耗时 18s」：同一次构建没法自报总耗时，删了。
 */
const rows = [
  { key: t('about.buildFramework'), value: buildInfo.framework },
  { key: t('about.buildStyling'), value: buildInfo.styling },
  { key: t('about.buildHosting'), value: build.hosting },
  { key: t('about.buildLastBuild'), value: buildInfo.builtAt },
]

const since = fmt.yearMonth(uptime.since)
---

<Panel caption={t('about.buildCaption')}>
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <span class="size-[6px] shrink-0 rounded-full bg-leaf"></span>
    <span class="text-[12.5px] font-bold whitespace-nowrap text-leaf-deep">{build.status}</span>
  </div>

  <dl class="flex h-fit w-full shrink-0 flex-col items-start gap-[8px]">
    {
      rows.map((row) => (
        <div class="flex h-fit w-full shrink-0 flex-row items-center justify-between gap-[8px]">
          <dt class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{row.key}</dt>
          <dd class="font-mono text-[11.5px] font-normal whitespace-nowrap text-ink">
            {row.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <span class="h-[1px] w-full shrink-0 bg-hairline"></span>

  {/*
    「第 N 天」是序数口径：动工当天就是第 1 天，所以日历差 +1（data-uptime-ordinal
    这个标记让 scripts/uptime 按访客时区实时重算）。
    整句必须是一个语法单位（中文「自…动工，第 N 天」、英文「Started …, day N.」，
    语序完全不同），所以用 set:html 把带标记的数字塞进译文的占位符里 ——
    拆成「前半句 + 数字 + 后半句」三段拼的话，某个语种一定会被拼出病句。
  */}
  <span
    class="w-full text-[11.5px]/[1.55] font-normal text-ink-muted"
    set:html={t('about.buildSince', {
      since,
      n: `<span data-uptime-days="${uptime.since.getTime()}" data-uptime-ordinal>${calendarDaysSince(uptime.since) + 1}</span>`,
    })}
  />
</Panel>

<script>
  // 天数实时化：见 ~/scripts/uptime（Astro 会去重，两个组件只打包一份）
  import '~/scripts/uptime'
</script>
