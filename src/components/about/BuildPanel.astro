---
import Panel from '~/components/Panel.astro'
import { build, uptime } from '~/config'
import { buildInfo } from '~/utils/build'
import { daysSince } from '~/utils/post'

/**
 * 构建 BUILD · blog.pen About 关于网站 / Left Column（x7QTJQ）
 *
 * 四行键值的值用等宽字（设计稿写的是 $--font-primary = JetBrains Mono），
 * 和站内其他数字/技术文本一致。
 *
 * 设计稿把版本号和时间都写死了。这里只有「托管」是静态的（还没定平台），
 * 框架 / 样式从 package.json 读，上次构建是构建时刻，天数实时算 —— 都不会过期。
 * 设计稿 Status Row 里还有一行「构建耗时 18s」：同一次构建没法自报总耗时，删了。
 */
const rows = [
  { key: '框架', value: buildInfo.framework },
  { key: '样式', value: buildInfo.styling },
  { key: '托管', value: build.hosting },
  { key: '上次构建', value: buildInfo.builtAt },
]

const since = `${uptime.since.getFullYear()} 年 ${uptime.since.getMonth() + 1} 月`
---

<Panel caption="构 建  BUILD">
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <span class="size-[6px] shrink-0 rounded-full bg-leaf"></span>
    <span class="text-[12.5px] font-bold whitespace-nowrap text-leaf-deep">{build.status}</span>
  </div>

  <dl class="flex h-fit w-full shrink-0 flex-col items-start gap-[8px]">
    {
      rows.map((row) => (
        <div class="flex h-fit w-full shrink-0 flex-row items-center justify-between gap-[8px]">
          <dt class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{row.key}</dt>
          <dd class="font-mono text-[11.5px] font-normal whitespace-nowrap text-ink">
            {row.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <span class="h-[1px] w-full shrink-0 bg-hairline"></span>

  <span class="w-full text-[11.5px]/[1.55] font-normal text-ink-muted">
    {/* 还没部署上线，说「动工」才是真话；uptime.since = 仓库首次提交 */}
    自 {since}动工，第 <span data-uptime-days={uptime.since.getTime()}>{daysSince(uptime.since)}</span> 天。
  </span>
</Panel>

<script>
  // 天数实时化：见 ~/scripts/uptime（Astro 会去重，两个组件只打包一份）
  import '~/scripts/uptime'
</script>
