---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'

interface Friend {
  name: string
  desc: string
  icon: string
  href: string
  // 头像渐变逐人不同，设计里是手调的，不走 token
  from: string
  to: string
  /** 各站真实头像（images/blogroll/）；没有时退回 icon + 渐变 */
  avatar?: ImageMetadata | undefined
}

interface Props {
  note: string
  friends: readonly Friend[]
}

const { note, friends } = Astro.props

// 设计是两行各两位；移动端收成单列
const rows = [friends.slice(0, 2), friends.slice(2)]
---

<!-- Friends Panel -->
<div class="glass-panel box-border flex h-fit w-full shrink-0 flex-col items-start gap-[14px] rounded-[28px] p-[20px]">
  <div class="flex h-fit w-full shrink-0 flex-row items-center justify-between gap-[10px] xl:h-[22px]">
    <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
      友 链 FRIENDS
    </span>
    <span class="text-[12px] font-normal text-ink-muted">{note}</span>
  </div>

  {
    rows.map(
      (row) =>
        row.length > 0 && (
          <div class="flex h-fit w-full shrink-0 flex-col items-stretch gap-[12px] xl:flex-row">
            {row.map((friend) => (
              <a
                href={friend.href}
                target="_blank"
                rel="noopener noreferrer"
                class="box-border flex h-fit w-full flex-row items-center gap-[12px] rounded-[22px] bg-chip px-[14px] py-[12px] outline-1 -outline-offset-[0.5px] outline-hairline xl:flex-1"
              >
                {friend.avatar ? (
                  <Image
                    src={friend.avatar}
                    alt={friend.name}
                    width={76}
                    height={76}
                    class="size-[38px] shrink-0 rounded-full object-cover outline-1 -outline-offset-[0.5px] outline-sheen"
                  />
                ) : (
                  <span
                    class="flex size-[38px] shrink-0 flex-row items-center justify-center rounded-full"
                    style={`background-image:linear-gradient(-135deg,${friend.from} 14.645%,${friend.to} 85.355%)`}
                  >
                    <Icon
                      name={`lucide:${friend.icon}`}
                      class="size-[16px] shrink-0 text-ink opacity-[0.55]"
                    />
                  </span>
                )}
                <span class="flex h-fit flex-1 flex-col items-start gap-[3px]">
                  <span class="text-[14px] font-bold whitespace-nowrap text-ink">{friend.name}</span>
                  <span class="w-full text-[12.5px] font-normal text-ink-soft">{friend.desc}</span>
                </span>
                <Icon name="lucide:arrow-up-right" class="size-[14px] shrink-0 text-ink-muted" />
              </a>
            ))}
          </div>
        ),
    )
  }
</div>
