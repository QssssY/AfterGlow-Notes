---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'
import { siteAvatar as avatarSrc } from '~/utils/site-images'
import LangSwitch from './LangSwitch.astro'

const { t, c, nav, path } = useI18n(Astro)
const { site } = c
---

<!--
  紧凑导航条（桌面内容页顶部）—— 结构照搬 YYsuni：完整 Sidebar 只留在首页，
  内容页的导航缩成一条图标横条，且和他的 .card（absolute）一样随页面滚走，不钉。
  视觉走本站语言：玻璃条 + 36px 图标位；右端补 主题切换 + RSS。
  不挂 View Transitions 共享元素名（玻璃条快照是块模糊空板）。
  激活/hover 高亮是一颗跟手胶囊（data-nav-pill，照搬他 nav-card 的 spring 胶囊）：
  弹簧跟随 hover，离手 1.5s 弹回当前页；图标颜色跟着胶囊走（data-pill-on）。
-->
<nav
  data-navbar
  aria-label={t('nav.aria')}
  class="glass relative box-border flex h-fit w-fit flex-row items-center gap-[4px] rounded-[18px] p-[8px]"
>
  <span
    data-nav-pill
    aria-hidden="true"
    class="pointer-events-none absolute rounded-[12px] bg-fire-tint opacity-0"></span>

  <a
    href={path('/')}
    title={t('nav.backHome', { title: site.title })}
    class="relative mr-[4px] flex size-[36px] shrink-0 flex-row items-center justify-center"
  >
    <span class="flex size-[30px] shrink-0">
      <Image
        src={avatarSrc}
        alt={site.title}
        width={60}
        height={60}
        class="size-[30px] shrink-0 rounded-full object-cover shadow-[0_8px_14px_-4px_var(--color-dot-idle)]"
      />
    </span>
  </a>

  {
    nav.map((item) => (
      <a
        href={item.href}
        title={item.label}
        aria-current={item.active ? 'page' : undefined}
        data-pill-target
        class:list={[
          'relative flex size-[36px] shrink-0 flex-row items-center justify-center rounded-[12px] transition-colors',
          item.active ? 'text-brand-ink' : 'text-ink-soft',
        ]}
      >
        <Icon name={`lucide:${item.icon}`} class="size-[19px] shrink-0" />
      </a>
    ))
  }

  <span class="mx-[4px] h-[22px] w-[1px] shrink-0 bg-hairline"></span>

  <button
    type="button"
    data-theme-cycle
    data-pill-target
    title={t('common.toggleTheme')}
    aria-label={t('common.toggleTheme')}
    class="relative flex size-[36px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[12px] text-ink-soft transition-colors"
  >
    <Icon name="lucide:sun-moon" class="size-[19px] shrink-0" />
  </button>

  {/* 语言钮也进跟手胶囊的目标组，和相邻两颗手感一致 */}
  <LangSwitch variant="menu" align="right" />

  <a
    href={path('/rss.xml')}
    title={t('common.rss')}
    aria-label={t('common.rss')}
    data-pill-target
    class="relative flex size-[36px] shrink-0 flex-row items-center justify-center rounded-[12px] text-ink-soft transition-colors"
  >
    <Icon name="lucide:rss" class="size-[17px] shrink-0" />
  </a>
</nav>

<style>
  /* 胶囊所在项亮成品牌色（图标 stroke 走 currentColor） */
  [data-pill-target][data-pill-on] {
    color: var(--brand-ink);
  }
</style>

<script>
  // 跟手胶囊（照搬 YYsuni nav-card）：mouseenter 就位，1.5s 后弹回激活项 ——
  // 连「悬停不动 1.5s 也会先弹回去」的小脾气都和他一致（他的 effect 就这么写的）。
  // 弹簧在 CSS（global.css 的 [data-nav-pill] transition + --spring）。

  // 激活项的上一页位置 —— 模块级跨页存活：底盘连续时（data-enter-static，
  // 上一页也可见），新页的胶囊从旧位置弹簧滑到新激活项（YYsuni layoutId 手感）
  let lastActive: { left: number; top: number; width: number; height: number } | null = null

  document.addEventListener('astro:page-load', () => {
    for (const bar of document.querySelectorAll<HTMLElement>('[data-navbar]')) {
      const pill = bar.querySelector<HTMLElement>('[data-nav-pill]')
      if (!pill) continue
      const targets = [...bar.querySelectorAll<HTMLElement>('[data-pill-target]')]
      const activeEl = bar.querySelector<HTMLElement>('a[aria-current="page"]')
      let snapTimer: ReturnType<typeof setTimeout> | undefined

      const moveTo = (el: HTMLElement, instant = false) => {
        if (instant) pill.style.transition = 'none'
        pill.style.left = `${el.offsetLeft}px`
        pill.style.top = `${el.offsetTop}px`
        pill.style.width = `${el.offsetWidth}px`
        pill.style.height = `${el.offsetHeight}px`
        pill.style.opacity = '1'
        for (const t of targets) t.toggleAttribute('data-pill-on', t === el)
        if (instant) {
          void pill.offsetWidth // 先落位再恢复过渡，避免从 (0,0) 飞进来
          pill.style.transition = ''
        }
      }

      // classic 模式下条是 display:none（量不到尺寸），跳过初始落位，
      // 切到紧凑后第一次 hover 会以 instant 落位补上
      if (bar.offsetWidth > 0 && activeEl) {
        const target = {
          left: activeEl.offsetLeft,
          top: activeEl.offsetTop,
          width: activeEl.offsetWidth,
          height: activeEl.offsetHeight,
        }
        if (lastActive && bar.hasAttribute('data-enter-static') && lastActive.left !== target.left) {
          // 换页果冻：先无过渡落在上一页的激活位，下一帧弹簧滑到新激活项
          pill.style.transition = 'none'
          pill.style.left = `${lastActive.left}px`
          pill.style.top = `${lastActive.top}px`
          pill.style.width = `${lastActive.width}px`
          pill.style.height = `${lastActive.height}px`
          pill.style.opacity = '1'
          void pill.offsetWidth
          pill.style.transition = ''
          requestAnimationFrame(() => moveTo(activeEl))
        } else {
          moveTo(activeEl, true)
        }
        lastActive = target
      }

      for (const t of targets) {
        t.addEventListener('mouseenter', () => {
          clearTimeout(snapTimer)
          moveTo(t, pill.style.opacity !== '1')
          if (activeEl && t !== activeEl) snapTimer = setTimeout(() => moveTo(activeEl), 1500)
        })
      }
    }
  })
</script>
