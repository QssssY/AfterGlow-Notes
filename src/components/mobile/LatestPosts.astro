---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

interface Article {
  title: string
  href: string
  date: Date
  cover?: ImageMetadata | undefined
}

interface Props {
  articles: Article[]
}

const { articles } = Astro.props
const { t, fmt, path } = useI18n(Astro)
---

<!-- 最新文章 Card -->
<div class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[12px] rounded-[28px] p-[18px]">
  <div class="flex h-fit w-full shrink-0 flex-row items-center gap-[8px]">
    <span class="flex-1 text-[12px] font-normal text-ink-soft">{t('mobile.latest')}</span>
    <a href={path('/archive')} class="text-[11px] font-medium whitespace-nowrap text-brand-ink">
      {t('common.all')}
    </a>
  </div>

  {
    articles.map((article, i) => (
      <>
        {i > 0 && <span class="h-[1px] w-full shrink-0 bg-hairline" />}
        <a href={article.href} class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px]">
          {article.cover ? (
            <Image
              src={article.cover}
              alt=""
              width={88}
              height={88}
              class="size-[44px] shrink-0 rounded-[12px] object-cover outline-1 -outline-offset-[0.5px] outline-hairline"
            />
          ) : (
            <span class="size-[44px] shrink-0 rounded-[12px] bg-avatar-bg outline-1 -outline-offset-[0.5px] outline-hairline" />
          )}

          <span class="flex h-fit flex-1 flex-col items-start gap-[4px]">
            <span class="w-full text-[14px] font-medium text-ink">{article.title}</span>
            <time
              datetime={article.date.toISOString()}
              class="text-[11px] font-normal whitespace-nowrap text-ink-muted"
            >
              {fmt.monthDayNumeric(article.date)}
            </time>
          </span>

          <Icon name="lucide:chevron-right" class="size-[16px] shrink-0 text-ink-muted" />
        </a>
      </>
    ))
  }
</div>
