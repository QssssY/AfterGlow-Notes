---
import { Icon } from 'astro-icon/components'
import BilibiliIcon from '~/components/BilibiliIcon.astro'
import { useI18n } from '~/i18n'

const { t, c } = useI18n(Astro)
const { socials } = c

// 款式缺席时按顺序兜底（socials 可在管理端增删），不让构建崩
const github = socials.find((s) => s.variant === 'dark') ?? socials[0]!
const second = socials.find((s) => s.variant === 'glass') ?? socials[socials.length - 1]!
---

<!-- Social Row -->
<div class="flex h-fit w-full shrink-0 flex-row items-center gap-[10px]">
  <a
    href={github.href}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-fit flex-1 flex-row items-center justify-center gap-[7px] rounded-[13px] bg-btn-dark px-[13px] py-[8px] outline-[1.5px] -outline-offset-[0.75px] outline-sheen shadow-[0_24px_44px_-16px_var(--shadow-soft),0_0_20px_0_var(--sheen)] backdrop-blur-[4px]"
  >
    <Icon name="lucide:github" class="size-[20px] shrink-0 text-white" />
    <span class="font-display text-[15px] font-normal whitespace-nowrap text-white">
      {github.label}
    </span>
  </a>

  <a
    href={second.href}
    target="_blank"
    rel="noopener noreferrer"
    class="glass flex h-fit flex-1 flex-row items-center justify-center gap-[7px] rounded-[13px] px-[13px] py-[8px]"
  >
    <BilibiliIcon class="size-[18px] shrink-0 text-ink" />
    <span class="text-[13px] font-medium whitespace-nowrap text-ink">{second.label}</span>
  </a>

  {/* 真按钮不是摆设：和桌面迷你爱心同一套状态（LikeWidget 的脚本认所有
      data-like-site 按钮），点了同步点亮、计数同步、心形爆裂照放 */}
  <button
    type="button"
    data-like
    data-like-site
    aria-pressed="false"
    aria-label={t('home.likeSite')}
    class="glass group/like relative flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center gap-[6px] rounded-[13px] px-[12px] py-[8px]"
  >
    <span data-like-burst aria-hidden="true" class="pointer-events-none absolute inset-0"></span>
    <span class="relative size-[18px] shrink-0 transition-transform group-active/like:scale-90">
      <Icon name="lucide:heart" class="absolute inset-0 size-[18px] text-like-ink" />
      <!-- 已赞态的实心心：lucide 的 use 影子树填不了色，叠同形内联路径 -->
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        class="absolute inset-0 size-[18px] scale-50 fill-like-ink opacity-0 transition-[opacity,scale] duration-300 group-aria-pressed/like:scale-100 group-aria-pressed/like:opacity-100"
      >
        <path
          d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
        ></path>
      </svg>
    </span>
    <span data-like-count class="text-[12px] font-medium whitespace-nowrap text-like-text">0</span>
  </button>
</div>
