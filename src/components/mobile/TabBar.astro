---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

const { nav } = useI18n(Astro)
---

<!-- Tab Bar
     不挂共享元素名：玻璃条的过渡快照是块模糊空板；换页瞬时，位置固定视觉本就连续 -->
<nav
  class="glass fixed bottom-[29px] left-[16px] right-[16px] z-20 flex h-fit flex-row items-center gap-[2px] rounded-[22px] p-[8px] xl:hidden"
>
  {
    nav.map((item) => (
      <a
        href={item.href}
        aria-current={item.active ? 'page' : undefined}
        class:list={[
          'flex h-fit flex-1 flex-col items-center justify-center gap-[3px] rounded-[15px] py-[7px]',
          item.active && 'bg-fire-tint',
        ]}
      >
        <Icon
          name={`lucide:${item.icon}`}
          class:list={['size-[20px] shrink-0', item.active ? 'text-brand-ink' : 'text-ink-soft']}
        />
        {/*
          Tab 文案用 short（短标）：七格平分 390 屏宽（减去两侧 16px 边距和
          8px 内边距），每格约 47px。英文/日文的短标比中文长（Posts / ホーム），
          10px 字号下最长的「ブログロール」也放不下 —— 所以移动端一律用 short，
          且译文里特意挑了短词（见 ui.ts 的 nav.*.short）。加了「听歌」这一格
          之后余量更小，新增导航项前先在 390px 宽下看一眼截断情况。
        */}
        <span
          class:list={[
            'max-w-full truncate text-[10px]',
            item.active ? 'font-semibold text-brand-ink' : 'font-normal text-ink',
          ]}
        >
          {item.short}
        </span>
      </a>
    ))
  }
</nav>
