---
/**
 * Projects 与 Share 两页筛选行共用的胶囊。
 * 不是 FilterPill 组件的实例：设计里这两页是在实例上覆盖出的另一套尺寸
 * （p-[7px_12px] + 12.5px/bold + 1px 描边），FilterPill 本体是 p-[6px_13px] + 12px/medium。
 *
 * 选中态由 aria-pressed 驱动（沿用 Sidebar 里 aria-checked 的写法），
 * 这样脚本只翻一个属性就能换样式，不用在 JS 里拼类名。
 */
interface Props {
  label: string
  active?: boolean
  /** 写进 data-filter 供筛选脚本读取；默认取 label */
  value?: string
  href?: string | undefined
}

const { label, active = false, value, href } = Astro.props

const Tag = href ? 'a' : 'button'
---

<Tag
  href={href}
  type={href ? undefined : 'button'}
  data-filter={href ? undefined : (value ?? label)}
  aria-pressed={href ? undefined : active}
  class="box-border flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center rounded-[12px] bg-chip px-[12px] py-[7px] text-[12.5px] font-bold whitespace-nowrap text-ink-soft outline-1 -outline-offset-[0.5px] outline-hairline transition-colors aria-pressed:bg-fire-tint aria-pressed:text-brand-ink aria-pressed:outline-brand"
>
  {label}
</Tag>
