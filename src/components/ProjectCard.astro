---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import placeholderArt from '../../images/placeholder-art.png'

interface Props {
  title: string
  desc: string
  stack: string
  stars: number | string
  href?: string | undefined
  /** 网格里的实例会覆盖成 fill_container */
  full?: boolean
  /** owner/repo；给了就让 RepoStars 的脚本来刷新 star 数 */
  repo?: string | undefined
}

const { title, desc, stack, stars, href, full = false, repo } = Astro.props
---

<!-- Project Card · blog.pen XnV5M -->
<a
  href={href ?? '#'}
  target={href?.startsWith('http') ? '_blank' : undefined}
  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
  data-gh={repo}
  class:list={[
    'glass box-border flex flex-col items-start gap-[14px] rounded-[28px] p-[20px]',
    full ? 'w-full' : 'w-[260px]',
  ]}
>
  <!-- 还没有项目截图：先用品牌占位图（scripts/gen-placeholder-art.mjs 生成），
       以后有真图就在这里换成对应的 import -->
  <Image
    src={placeholderArt}
    alt=""
    width={792}
    height={396}
    class="h-[132px] w-full shrink-0 rounded-[18px] object-cover"
  />

  <span class="flex w-full shrink-0 flex-row items-center gap-[8px]">
    <span class="min-w-0 flex-1 truncate text-[16px] font-medium text-ink" title={title}>{title}</span>
    <Icon name="lucide:arrow-up-right" class="size-[18px] shrink-0 text-ink-muted" />
  </span>

  <span class="w-full text-[13px]/[21px] font-normal text-ink-soft">{desc}</span>

  <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[10px]">
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{stack}</span>
    <span class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
      ★ <span data-gh-stars>{stars}</span>
    </span>
  </span>
</a>
