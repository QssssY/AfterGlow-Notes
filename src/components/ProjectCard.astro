---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import placeholderArt from '../../images/placeholder-art.webp'

interface Props {
  title: string
  desc: string
  stack: string
  stars: number | string
  href?: string | undefined
  /** 网格里的实例会覆盖成 fill_container */
  full?: boolean
  /** owner/repo；给了就让 RepoStars 的脚本来刷新 star 数 */
  repo?: string | undefined
  /** 项目配图（管理端上传，utils/project-thumbs.ts 按仓库名取）；没有退回占位图 */
  thumb?: ImageMetadata | undefined
}

const { title, desc, stack, stars, href, full = false, repo, thumb } = Astro.props
---

<!-- Project Card · blog.pen XnV5M -->
<a
  href={href ?? '#'}
  target={href?.startsWith('http') ? '_blank' : undefined}
  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
  data-gh={repo}
  class:list={[
    'glass box-border flex flex-col items-start gap-[14px] rounded-[28px] p-[20px]',
    // h-full：网格行 items-stretch，同排卡片等高，desc 行数不同也不参差
    full ? 'h-full w-full' : 'w-[260px]',
  ]}
>
  <!-- 配图在管理端「项目」页签上传（按仓库名存 images/projects/）；没传用品牌占位图。
       包一层做 hover 微光扫描（img 上放不了伪元素） -->
  <span class="img-sheen relative block h-[132px] w-full shrink-0 overflow-hidden rounded-[18px]">
    <Image
      src={thumb ?? placeholderArt}
      alt=""
      width={792}
      height={396}
      class="h-full w-full object-cover"
    />
  </span>

  <span class="flex w-full shrink-0 flex-row items-center gap-[8px]">
    <span class="min-w-0 flex-1 truncate text-[16px] font-medium text-ink" title={title}>{title}</span>
    <Icon name="lucide:arrow-up-right" class="size-[18px] shrink-0 text-ink-muted" />
  </span>

  <!-- flex-1：desc 吃掉等高后多出的空间，底部那行 语言·star 在同排卡片间对齐 -->
  <span class="w-full flex-1 text-[13px]/[21px] font-normal text-ink-soft">{desc}</span>

  <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[10px]">
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{stack}</span>
    <span class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
    <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
      ★ <span data-gh-stars>{stars}</span>
    </span>
  </span>
</a>
