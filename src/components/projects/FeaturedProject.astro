---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import placeholderArt from '../../../images/placeholder-art.png'

interface Props {
  badge: string
  title: string
  desc: string
  /**
   * 设计稿这行是「语言 · ★N · 更新于X」三段圆点分隔。
   * 拆成三个具名属性而不是字符串数组，是为了能单独给 star 数挂刷新钩子。
   */
  stack: string
  stars: number | string
  updated: string
  href?: string | undefined
  /** owner/repo；给了就让 RepoStars 的脚本来刷新 star 数 */
  repo?: string | undefined
  /** 设计稿这里是 Unsplash 占位图，等提供真实截图 */
  thumb?: ImageMetadata | undefined
}

const { badge, title, desc, stack, stars, updated, href, repo, thumb } = Astro.props
const external = href?.startsWith('http')
---

<!-- Featured · blog.pen Projects -->
<a
  href={href ?? '#'}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-gh={repo}
  class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[24px] rounded-[32px] p-[20px] xl:flex-row xl:items-center"
>
  {/* 没给截图时用品牌占位图（scripts/gen-placeholder-art.mjs 生成），不再是一块素色 */}
  <Image
    src={thumb ?? placeholderArt}
    alt=""
    width={1080}
    height={636}
    class="h-[212px] w-full shrink-0 rounded-[22px] object-cover xl:w-[360px]"
  />

  <span class="flex h-fit w-full flex-col items-start gap-[12px] xl:flex-1">
    <!-- 徽标这轮跟着设计稿从金色改成橙色：底 fire-tint、字 brand-ink，两个都是变量，
         原先那对写死的十六进制在暗色下不跟主题走 -->
    <span class="flex h-fit w-fit shrink-0 flex-row rounded-[12px] bg-fire-tint px-[11px] py-[5px]">
      <span class="text-[11px] font-medium whitespace-nowrap text-brand-ink">{badge}</span>
    </span>

    <span class="font-display text-[26px]/[34px] font-normal whitespace-nowrap text-ink">{title}</span>

    <span class="w-full text-[14px]/[25px] font-normal text-ink">{desc}</span>

    <span class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px]">
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{stack}</span>
      <span class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
        ★ <span data-gh-stars>{stars}</span>
      </span>
      <span class="size-[4px] shrink-0 rounded-full bg-ink-muted"></span>
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">{updated}</span>
      <span class="h-[1px] flex-1"></span>
      <Icon name="lucide:arrow-up-right" class="size-[20px] shrink-0 text-ink-soft" />
    </span>
  </span>
</a>
