---
import { Icon } from 'astro-icon/components'
import StackPill from '~/components/StackPill.astro'

interface Props {
  stacks: readonly string[]
  /** 当前选中的技术栈标签 */
  active?: string
}

const { stacks, active = stacks[0] } = Astro.props

const VIEWS = [
  { key: 'grid', icon: 'layout-grid', label: '网格视图' },
  { key: 'list', icon: 'list', label: '列表视图' },
] as const
---

<!-- Filter Bar · blog.pen Projects -->
<div class="flex h-[38px] w-full shrink-0 flex-row items-center justify-between gap-[12px]">
  {/* min-w-0 才轮得到 overflow-x-auto：原先 w-fit shrink-0 盒子跟着内容长，
      窄屏 pill 直接戳出视口而不是横滚 */}
  <div class="scrollbar-none flex h-fit min-w-0 flex-row items-center gap-[7px] overflow-x-auto xl:overflow-visible">
    {stacks.map((stack) => <StackPill label={stack} active={stack === active} />)}
  </div>

  <div class="hidden h-fit w-fit shrink-0 flex-row items-center gap-[6px] xl:flex">
    {
      VIEWS.map((view) => (
        <button
          type="button"
          data-view-set={view.key}
          aria-pressed={view.key === 'grid'}
          aria-label={view.label}
          class="group/v flex size-[34px] shrink-0 cursor-pointer flex-row items-center justify-center rounded-[12px] bg-chip outline-1 -outline-offset-[0.5px] outline-hairline transition-colors aria-pressed:bg-fire-tint aria-pressed:outline-brand"
        >
          <Icon
            name={`lucide:${view.icon}`}
            class="size-[16px] shrink-0 text-ink-muted transition-colors group-aria-pressed/v:text-brand-ink"
          />
        </button>
      ))
    }
  </div>
</div>
