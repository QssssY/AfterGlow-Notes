---
import { Icon } from 'astro-icon/components'

interface Props {
  label: string
  icon: string
  href?: string | undefined
  active?: boolean
  /** 侧栏里的实例是 fill_container；组件本身定义为 232px 宽 */
  full?: boolean
}

const { label, icon: iconName, href, active = false, full = false } = Astro.props
---

<!-- Nav Item
     relative 是给侧栏的滑动高亮用的：胶囊绝对定位在条目下面，
     条目自己不建层的话，文字会被胶囊盖住。hover 底色由胶囊负责，这里只过渡文字色。 -->
<a
  href={href ?? '#'}
  class:list={[
    'group/nav relative box-border flex flex-row items-center gap-[12px] rounded-[26px] px-[20px] py-[12px] transition-colors',
    full ? 'w-full' : 'w-[232px]',
    active && 'glass-solid',
  ]}
  aria-current={active ? 'page' : undefined}
>
  <!-- 悬停配色照搬 YYsuni nav-card：图标染品牌色、文字加深加粗（与激活态同款），
       胶囊只给底色，颜色变化由条目自己给 —— 之前 ink-soft→ink 的差距肉眼看不出（用户点名） -->
  <Icon
    name={`lucide:${iconName}`}
    class:list={[
      'size-[26px] shrink-0 transition-colors',
      active ? 'text-brand' : 'text-ink-soft group-hover/nav:text-brand',
    ]}
  />
  <span
    class:list={[
      'text-[15px] whitespace-nowrap transition-colors',
      active
        ? 'font-medium text-ink'
        : 'font-normal text-ink-soft group-hover/nav:font-medium group-hover/nav:text-ink',
    ]}>{label}</span
  >
</a>
