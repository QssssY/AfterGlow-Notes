---
interface Props {
  /** 形如「数 据 STATS」 */
  caption: string
}

const { caption } = Astro.props
---

<!--
  左栏面板外壳 —— 归档页、项目页、关于页的左栏面板共用这一套参数
  （glass-panel 底 + r28 + p18 + gap12，caption 11.5/700/字距 1.8）。
  文章详情页左栏那两块不走这里：它们是 r26 + p22 + glass，另一套投影。
-->
<section
  class="glass-panel box-border flex h-fit w-full shrink-0 flex-col items-start gap-[12px] rounded-[28px] p-[18px]"
>
  <span class="text-[11.5px] font-bold tracking-[1.8px] whitespace-nowrap text-ink-muted">
    {caption}
  </span>
  <slot />
</section>
