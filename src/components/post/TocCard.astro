---
import type { MarkdownHeading } from 'astro'
import { useI18n } from '~/i18n'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const { t } = useI18n(Astro)
// 设计里 H3 用 pl-[12px] 表达层级
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <nav class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[12px] rounded-[26px] p-[22px]">
      <span class="text-[12px] font-normal tracking-[0.8px] whitespace-nowrap text-ink-soft">
        {t('post.tocCaption')}
      </span>

      {/* 长文目录卡内限高自滚（YYsuni 同款 300），粘性组才能保证一屏装得下；
          relative 是给脚本算 offsetTop 用的（把高亮项滚进视野中央） */}
      <div
        data-toc-box
        class="relative flex max-h-[300px] w-full flex-col gap-[12px] overflow-y-auto [scrollbar-width:none]"
      >
        {items.map((heading, i) => (
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            data-active={i === 0 ? '' : undefined}
            class:list={[
              'group flex h-fit w-full shrink-0 flex-row items-center gap-[10px]',
              heading.depth === 3 && 'pl-[12px]',
            ]}
          >
            <span class="h-[14px] w-[2px] shrink-0 rounded-[1px] bg-hairline transition-colors group-hover:bg-dot-idle group-data-active:bg-brand" />
            <span class="flex-1 text-[13px] font-normal text-ink-soft transition-colors group-hover:text-ink group-data-active:font-medium group-data-active:text-ink">
              {heading.text}
            </span>
          </a>
        ))}
      </div>
    </nav>
  )
}

<script>
  // 滚动高亮：取当前视口内最靠上的标题。
  // 客户端路由：scroll 监听只挂一次，换页后由 astro:page-load 刷新元素引用
  let links: HTMLElement[] = []
  let headings: HTMLElement[] = []
  let lastActive = ''

  const setActive = (slug: string) => {
    if (slug === lastActive) return // 不重复写，免得和访客手动滚目录打架
    lastActive = slug
    for (const link of links) {
      const on = link.dataset.tocLink === slug
      if (on) link.setAttribute('data-active', '')
      else link.removeAttribute('data-active')
      // 目录比 300 高时把高亮项带到盒子中央（只动盒内滚动，不碰页面）
      if (on) {
        const box = link.closest<HTMLElement>('[data-toc-box]')
        if (box && box.scrollHeight > box.clientHeight + 4) {
          box.scrollTop = Math.max(0, link.offsetTop - (box.clientHeight - link.offsetHeight) / 2)
        }
      }
    }
  }

  const update = () => {
    if (headings.length === 0) return
    let current = headings[0]?.id
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= 120) current = heading.id
      else break
    }
    if (current) setActive(current)
  }

  // rAF 节流（2026-08-29 掉帧复盘）：滚动事件一帧内能来好几次，而这里每次都要
  // 对每个标题读 getBoundingClientRect —— 中间又夹着 setActive 的属性写与
  // 盒内 scrollTop 写，读写交替把布局反复打回作废（layout thrashing）。
  // 收敛到「每帧至多算一次」，长文的标题越多省得越多；位置仍是实时量的，
  // 不缓存偏移量 —— 正文挂着 content-visibility，行高要滚到才定得下来
  let ticking = false
  const onScroll = () => {
    if (ticking) return
    ticking = true
    requestAnimationFrame(() => {
      ticking = false
      update()
    })
  }
  addEventListener('scroll', onScroll, { passive: true })

  document.addEventListener('astro:page-load', () => {
    links = [...document.querySelectorAll<HTMLElement>('[data-toc-link]')]
    headings = links
      .map((link) => document.getElementById(link.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null)
    lastActive = '' // 换页必须重置，否则新页首个高亮会被去重逻辑跳过
    update()
  })
</script>
