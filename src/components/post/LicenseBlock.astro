---
import { Icon } from 'astro-icon/components'
import { useI18n } from '~/i18n'

interface Props {
  /** 展示用的文章链接（域名 + 路径，域名跟 astro.config 的 site 走） */
  permalink: string
  shareUrl: string
  title: string
  updated?: Date | undefined
}

const { permalink, shareUrl, title, updated } = Astro.props
const { t, fmt } = useI18n(Astro)

const stamp = updated ? t('post.lastModified', { date: fmt.dateDots(updated) }) : ''

const shares = [
  { icon: 'link', label: t('common.copyLink'), href: shareUrl },
  {
    icon: 'twitter',
    label: t('post.shareX'),
    href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`,
  },
  {
    icon: 'mail',
    label: t('post.shareMail'),
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(shareUrl)}`,
  },
]
---

<!-- License Block
     响应式：窄屏（<sm）分享钮换到第二行右对齐 —— 三颗钮加图标占掉 200px 后，
     留给 URL 的只剩 80px，break-all 会把它折成五行；让 URL 吃满整行才体面。
     ≥sm 与设计完全一致（徽标 + 文字 + 钮 一行 gap16） -->
<div class="glass-panel box-border flex h-fit w-full shrink-0 flex-col items-stretch gap-[12px] rounded-[22px] px-[18px] py-[16px] sm:flex-row sm:items-center sm:gap-[16px]">
  <span class="flex h-fit min-w-0 flex-1 flex-row items-center gap-[16px]">
    <span class="flex size-[40px] shrink-0 flex-row items-center justify-center rounded-[12px] bg-fire-tint">
      <Icon name="lucide:creative-commons" class="size-[19px] shrink-0 text-brand-ink" />
    </span>

    {/* min-w-0：没有它这列拒绝收窄到 URL 的固有宽度以下，窄屏会把右侧按钮顶穿卡片；
        URL 里没有可断点，配 break-all 让它能在任意字符处换行 */}
    <span class="flex h-fit min-w-0 flex-1 flex-col items-start gap-[4px]">
      <span class="text-[13.5px] font-bold whitespace-nowrap text-ink">{t('post.license')}</span>
      <span class="w-full text-[12.5px] font-normal break-all text-ink-soft">
        {t('post.licenseNote', { permalink, stamp })}
      </span>
    </span>
  </span>

  <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[8px] self-end sm:self-auto">
    {
      shares.map((share) => (
        <a
          href={share.href}
          aria-label={share.label}
          target={share.icon === 'link' ? undefined : '_blank'}
          rel={share.icon === 'link' ? undefined : 'noopener noreferrer'}
          class="flex h-[34px] w-[36px] shrink-0 flex-row items-center justify-center rounded-[12px] bg-chip outline-1 -outline-offset-[0.5px] outline-hairline"
        >
          <Icon name={`lucide:${share.icon}`} class="size-[15px] shrink-0 text-ink-soft" />
        </a>
      ))
    }
  </span>
</div>
