---
import { Icon } from 'astro-icon/components'
import { relativeDay } from '~/utils/post'

interface Props {
  /**
   * 点赞数。设计稿画了「喜欢 · 328」，但真实计数需要后端服务，
   * 所以不传时整个按钮不渲染 —— 不编假数字。
   */
  likes?: number | undefined
  updated?: Date | undefined
}

const { likes, updated } = Astro.props
---

<!-- Actions · blog.pen Post 文章详情 / Article Card -->
<div class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px]">
  <!--
    设计稿只画了静态计数；真正的点赞需要后端计数服务。
    描边 #F5C0CB66 在设计稿里仍是写死的（那轮抽 like-* 变量漏了它），照抄。
  -->
  {
    likes !== undefined && (
      <span class="flex h-fit w-fit shrink-0 flex-row items-center gap-[8px] rounded-[22px] bg-like-tint px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-[#F5C0CB66]">
        <Icon name="lucide:heart" class="size-[18px] shrink-0 text-like-ink" />
        <span class="text-[13px] font-medium whitespace-nowrap text-like-text">喜欢 · {likes}</span>
      </span>
    )
  }

  <button
    type="button"
    data-copy-link
    class="flex h-fit w-fit shrink-0 flex-row items-center gap-[8px] rounded-[22px] bg-chip px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-card-border"
  >
    <Icon name="lucide:link" class="size-[16px] shrink-0 text-ink-soft" />
    <span data-copy-label class="text-[13px] font-normal whitespace-nowrap text-ink-soft">
      复制链接
    </span>
  </button>

  <span class="h-[1px] flex-1"></span>

  {
    updated && (
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
        最后更新于 {relativeDay(updated)}
      </span>
    )
  }
</div>

<script>
  for (const button of document.querySelectorAll<HTMLElement>('[data-copy-link]')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]')
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href)
        if (label) {
          const original = label.textContent
          label.textContent = '已复制'
          setTimeout(() => {
            label.textContent = original
          }, 1600)
        }
      } catch {
        // 剪贴板不可用（非 HTTPS 或用户拒绝）时静默失败，不打断阅读
      }
    })
  }
</script>
