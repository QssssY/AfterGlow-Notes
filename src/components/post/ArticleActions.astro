---
import { Icon } from 'astro-icon/components'
import { relativeDay } from '~/utils/post'

interface Props {
  /** 文章 id，点赞的本机存储按它区分 */
  slug: string
  updated?: Date | undefined
}

const { slug, updated } = Astro.props
---

<!-- Actions · blog.pen Post 文章详情 / Article Card -->
<div class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px]">
  <!--
    「喜欢 · N」的 N 来自 Go 后端（配了 PUBLIC_API_BASE 时），一人一票可取消；
    后端不在就退回本机模式：localStorage 记住、不显示数字 —— 不编计数。
    描边 #F5C0CB66 在设计稿里仍是写死的（那轮抽 like-* 变量漏了它），照抄。
  -->
  <button
    type="button"
    data-like
    data-like-slug={slug}
    aria-pressed="false"
    class="group/like relative flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center gap-[8px] rounded-[22px] bg-like-tint px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-[#F5C0CB66]"
  >
    <span data-like-burst aria-hidden="true" class="pointer-events-none absolute inset-0"></span>
    <span class="relative size-[18px] shrink-0">
      <Icon name="lucide:heart" class="absolute inset-0 size-[18px] text-like-ink" />
      <!-- 已赞态的实心心：lucide 的 use 影子树填不了色，叠一颗同形的内联实心路径 -->
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        class="absolute inset-0 size-[18px] scale-50 fill-like-ink opacity-0 transition-[opacity,scale] duration-300 group-aria-pressed/like:scale-100 group-aria-pressed/like:opacity-100"
      >
        <path
          d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
        ></path>
      </svg>
    </span>
    <span
      data-like-label
      class="text-[13px] font-medium whitespace-nowrap text-like-text transition-colors">喜欢</span
    >
  </button>

  <button
    type="button"
    data-copy-link
    class="flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center gap-[8px] rounded-[22px] bg-chip px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-card-border"
  >
    <Icon name="lucide:link" class="size-[16px] shrink-0 text-ink-soft" />
    <span data-copy-label class="text-[13px] font-normal whitespace-nowrap text-ink-soft">
      复制链接
    </span>
  </button>

  <span class="h-[1px] flex-1"></span>

  {
    updated && (
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
        最后更新于 {relativeDay(updated)}
      </span>
    )
  }
</div>

<script>
  import { postLike, swr, swrPatch, touch } from '~/scripts/api'
  import { copyText } from '~/scripts/clipboard'
  import { likeBurst } from '~/scripts/like-burst'
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLElement>('[data-like][data-like-slug]')) {
      const slug = button.dataset.likeSlug!
      const KEY = `afterglow:liked:${slug}`
      const label = button.querySelector<HTMLElement>('[data-like-label]')

      // localStorage 在隐私模式下会抛，包起来后点赞退化成本次会话有效
      const read = () => {
        try {
          return localStorage.getItem(KEY) === '1'
        } catch {
          return false
        }
      }
      const write = (liked: boolean) => {
        try {
          if (liked) localStorage.setItem(KEY, '1')
          else localStorage.removeItem(KEY)
        } catch {
          // 存不了就算了，不打断交互
        }
      }

      let liked = read()
      // 服务端计数；null = 后端没配或没应答，只显示文案不显示数字
      let total: number | null = null

      const render = () => {
        button.setAttribute('aria-pressed', String(liked))
        if (label) {
          const prefix = liked ? '已喜欢' : '喜欢'
          label.textContent = total !== null && total > 0 ? `${prefix} · ${total}` : prefix
        }
      }
      render()

      // 合并接口一个往返拿齐（touch 同时记阅读，和文章页脚本共用同一次 POST）；
      // swr 先回放上次的数字 —— 换页瞬时的站上，计数不慢半拍
      swr(`touch:${slug}`, () => touch(slug), (state) => {
        liked = state.liked
        total = state.likes
        write(liked)
        render()
      })

      button.addEventListener('click', () => {
        liked = !liked
        write(liked)
        if (total !== null) total += liked ? 1 : -1 // 乐观更新，应答后校正
        render()
        if (liked) likeBurst(button)

        postLike(slug, liked ? 'like' : 'unlike').then((state) => {
          if (!state) {
            // 服务端没应答（断网/限流）：回滚乐观更新，别让点的人以为成功了
            if (total !== null) total += liked ? -1 : 1
            liked = !liked
            write(liked)
            render()
            return
          }
          liked = state.liked
          total = state.count
          write(liked)
          render()
          // 缓存同步：下次回放别闪回点赞前的旧态
          swrPatch(`touch:${slug}`, { likes: state.count, liked: state.liked })
        })
      })
    }
  })
</script>

<script>
  // 客户端路由：模块只执行一次，换页后要在新 DOM 上重新初始化
  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLElement>('[data-copy-link]')) {
      const label = button.querySelector<HTMLElement>('[data-copy-label]')
      button.addEventListener('click', async () => {
        // 纯 HTTP 下 navigator.clipboard 不存在，copyText 里有 execCommand 兜底
        const ok = await copyText(location.href)
        if (label) {
          const original = label.textContent
          label.textContent = ok ? '已复制' : '复制失败，请手动复制地址'
          setTimeout(() => {
            label.textContent = original
          }, 1600)
        }
      })
    }
  })
</script>
