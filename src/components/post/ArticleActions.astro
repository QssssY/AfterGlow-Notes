---
import { Icon } from 'astro-icon/components'
import { relativeDay } from '~/utils/post'

interface Props {
  /** 文章 id，点赞的本机存储按它区分 */
  slug: string
  updated?: Date | undefined
}

const { slug, updated } = Astro.props
---

<!-- Actions · blog.pen Post 文章详情 / Article Card -->
<div class="flex h-fit w-full shrink-0 flex-row items-center gap-[12px]">
  <!--
    设计稿画的是静态的「喜欢 · 328」——真实的共享计数需要后端，
    这里和首页 Like Widget 同一套口径：本机点赞、localStorage 记住、
    点下去有 YYsuni 式的心形爆裂。有计数服务了再把数字接上。
    描边 #F5C0CB66 在设计稿里仍是写死的（那轮抽 like-* 变量漏了它），照抄。
  -->
  <button
    type="button"
    data-like
    data-like-slug={slug}
    aria-pressed="false"
    class="group/like relative flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center gap-[8px] rounded-[22px] bg-like-tint px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-[#F5C0CB66]"
  >
    <span data-like-burst aria-hidden="true" class="pointer-events-none absolute inset-0"></span>
    <Icon
      name="lucide:heart"
      class="size-[18px] shrink-0 text-like-ink transition-colors group-aria-pressed/like:text-like-text"
    />
    <span
      data-like-label
      class="text-[13px] font-medium whitespace-nowrap text-like-text transition-colors">喜欢</span
    >
  </button>

  <button
    type="button"
    data-copy-link
    class="flex h-fit w-fit shrink-0 cursor-pointer flex-row items-center gap-[8px] rounded-[22px] bg-chip px-[18px] py-[10px] outline-1 -outline-offset-[0.5px] outline-card-border"
  >
    <Icon name="lucide:link" class="size-[16px] shrink-0 text-ink-soft" />
    <span data-copy-label class="text-[13px] font-normal whitespace-nowrap text-ink-soft">
      复制链接
    </span>
  </button>

  <span class="h-[1px] flex-1"></span>

  {
    updated && (
      <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
        最后更新于 {relativeDay(updated)}
      </span>
    )
  }
</div>

<script>
  import { likeBurst } from '~/scripts/like-burst'

  for (const button of document.querySelectorAll<HTMLElement>('[data-like][data-like-slug]')) {
    const KEY = `firefly:liked:${button.dataset.likeSlug}`
    const label = button.querySelector<HTMLElement>('[data-like-label]')

    // localStorage 在隐私模式下会抛，包起来后点赞退化成本次会话有效
    const read = () => {
      try {
        return localStorage.getItem(KEY) === '1'
      } catch {
        return false
      }
    }
    const write = (liked: boolean) => {
      try {
        if (liked) localStorage.setItem(KEY, '1')
        else localStorage.removeItem(KEY)
      } catch {
        // 存不了就算了，不打断交互
      }
    }

    let liked = read()
    const render = () => {
      button.setAttribute('aria-pressed', String(liked))
      if (label) label.textContent = liked ? '已喜欢' : '喜欢'
    }
    render()

    button.addEventListener('click', () => {
      liked = !liked
      write(liked)
      render()
      if (liked) likeBurst(button)
    })
  }
</script>

<script>
  for (const button of document.querySelectorAll<HTMLElement>('[data-copy-link]')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]')
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href)
        if (label) {
          const original = label.textContent
          label.textContent = '已复制'
          setTimeout(() => {
            label.textContent = original
          }, 1600)
        }
      } catch {
        // 剪贴板不可用（非 HTTPS 或用户拒绝）时静默失败，不打断阅读
      }
    })
  }
</script>
