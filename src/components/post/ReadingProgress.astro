---
// Reading Progress
---

<!-- 进度用 transform: scaleX 表达（w-full + origin-left）：改 width 每个滚动
     事件都要布局，scaleX 只走合成器；光晕反正被 3px 高的 overflow-hidden 裁掉，
     横向缩放带来的形变看不见 -->
<div class="fixed top-0 left-0 z-50 h-[3px] w-full overflow-hidden bg-hairline">
  <div
    data-reading-bar
    class="h-[3px] w-full origin-left bg-brand shadow-[0_0_8px_0_var(--glow-fire)]"
    style="transform: scaleX(0)"
  >
  </div>
</div>

<script>
  // 客户端路由：window 上的监听只挂一次（模块只执行一次），
  // 换页后由 astro:page-load 刷新 bar 的引用 —— 不在的页面上 bar 为 null，直接无操作
  let bar: HTMLElement | null = null
  let last = -1
  // 可滚距离缓存：scrollHeight 是布局相关属性，每个滚动事件读一次就等于
  // 逼浏览器把待处理的布局全算完（同一帧里别的脚本刚写过 DOM 时尤其贵）。
  // 页面高度只在换页/resize/图片落位时变，那时重量即可（2026-08-29 掉帧复盘）
  let max = 0
  const remeasure = () => {
    max = document.documentElement.scrollHeight - window.innerHeight
  }

  const update = () => {
    if (!bar) return
    // 量化到 0.1%（3px 高的细线上不足 2px 一步），没变就不写
    const ratio = max > 0 ? Math.round(Math.min(1, Math.max(0, window.scrollY / max)) * 1000) / 1000 : 0
    if (ratio === last) return
    last = ratio
    bar.style.transform = `scaleX(${ratio})`
  }

  addEventListener('scroll', update, { passive: true })
  addEventListener('resize', () => {
    remeasure()
    update()
  })
  // 图片渐显、content-visibility 的行高定稿都会改文档高度 —— 盯着文档尺寸变化重量
  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(() => {
      remeasure()
      update()
    }).observe(document.documentElement)
  }

  document.addEventListener('astro:page-load', () => {
    bar = document.querySelector<HTMLElement>('[data-reading-bar]')
    last = -1 // 新文档的条是新元素，得重写一次
    remeasure()
    update()
  })
</script>
