---
import { Icon } from 'astro-icon/components'

interface Entry {
  title: string
  href: string
}

interface Props {
  prev?: Entry | undefined
  next?: Entry | undefined
}

const { prev, next } = Astro.props
---

<!-- Prev Next · blog.pen Post 文章详情 -->
{
  (prev || next) && (
    <div class="flex h-fit w-full shrink-0 flex-row items-start gap-[20px]">
      {prev ? (
        <a
          href={prev.href}
          class="glass box-border flex h-fit flex-1 flex-row items-center justify-start gap-[10px] rounded-[24px] px-[20px] py-[16px]"
        >
          <Icon name="lucide:chevron-left" class="size-[18px] shrink-0 text-ink-muted" />
          <span class="flex h-fit w-fit shrink-0 flex-col items-start gap-[3px]">
            <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">上一篇</span>
            <span class="text-[14px] font-medium whitespace-nowrap text-ink">{prev.title}</span>
          </span>
        </a>
      ) : (
        <span class="flex-1" />
      )}

      {next ? (
        <a
          href={next.href}
          class="glass box-border flex h-fit flex-1 flex-row items-center justify-end gap-[10px] rounded-[24px] px-[20px] py-[16px]"
        >
          <span class="flex h-fit w-fit shrink-0 flex-col items-end gap-[3px]">
            <span class="text-[11px] font-normal whitespace-nowrap text-ink-muted">下一篇</span>
            <span class="text-[14px] font-medium whitespace-nowrap text-ink">{next.title}</span>
          </span>
          <Icon name="lucide:chevron-right" class="size-[18px] shrink-0 text-ink-muted" />
        </a>
      ) : (
        <span class="flex-1" />
      )}
    </div>
  )
}
