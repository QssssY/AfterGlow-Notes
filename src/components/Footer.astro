---
import { site } from '~/config'

interface Props {
  /** License 行文案按页面不同：文章页 CC BY-NC、项目页 MIT、About 页托管信息 */
  license?: string
}

const { license = `文章采用 CC BY-NC 4.0 授权 · ${site.title}` } = Astro.props
---

<!-- Footer · blog.pen（5 个桌面页共用，仅 License 行文案不同） -->
<footer class="flex h-fit w-full flex-col items-center justify-center gap-[12px]">
  <div class="h-[1px] w-full shrink-0 bg-hairline"></div>

  <div class="flex h-[8px] w-fit shrink-0 flex-row items-center gap-[6px]">
    <span class="size-[4px] shrink-0 rounded-full bg-hairline"></span>
    <span class="size-[6px] shrink-0 rounded-full bg-brand"></span>
    <span class="size-[4px] shrink-0 rounded-full bg-hairline"></span>
  </div>

  <span class="text-[12px] font-normal whitespace-nowrap text-ink-muted">
    © {site.since} {site.author} · 由 Astro 与一点耐心构建
  </span>

  <span class="text-[11.5px] font-normal whitespace-nowrap text-ink-muted opacity-[0.8]">
    {license}
  </span>
</footer>
