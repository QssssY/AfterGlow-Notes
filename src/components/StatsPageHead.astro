---
/**
 * Share / Blogroll 两页共用的 Page Head。
 * 和 projects/PageHead.astro 不是同一套：标题 30px、副标题 15/24，
 * 统计值是小号加粗正文字（不是 Averia 大字），条目间有 1px 分隔线。
 */
interface Props {
  title: string
  subtitle: string
  stats: readonly { value: string; label: string }[]
}

const { title, subtitle, stats } = Astro.props
---

<!-- Page Head · blog.pen Share JinhX / Blogroll SAL0U -->
<div
  class="glass box-border flex h-fit w-full shrink-0 flex-col items-start gap-[20px] rounded-[30px] px-[30px] py-[26px] xl:flex-row xl:items-center xl:gap-[30px]"
>
  <div class="flex h-fit w-full flex-col items-start gap-[10px] xl:flex-1">
    <h1 class="font-display text-[30px]/[36px] font-normal text-ink">{title}</h1>
    <p class="w-full text-[15px]/[24px] font-normal text-ink-soft">{subtitle}</p>
  </div>

  <div class="flex h-fit w-fit shrink-0 flex-row items-center gap-[26px]">
    {
      stats.map((stat, i) => (
        <>
          {i > 0 && <span class="h-[28px] w-[1px] shrink-0 bg-hairline" />}
          <span class="flex h-fit w-fit shrink-0 flex-col items-center gap-[3px]">
            <span class="text-[15px] font-bold whitespace-nowrap text-ink">{stat.value}</span>
            <span class="text-[11.5px] font-normal whitespace-nowrap text-ink-muted">
              {stat.label}
            </span>
          </span>
        </>
      ))
    }
  </div>
</div>
