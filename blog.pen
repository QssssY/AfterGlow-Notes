                              "fill": "$gold",
                              "width": 3,
                              "height": 28
                            },
                            {
                              "type": "text",
                              "id": "XC0Je",
                              "name": "Quote Text",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "工具的上限不是它能做多少事，而是它允许你犯多少次错。",
                              "lineHeight": 1.8,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal",
                              "fontStyle": "italic"
                            }
                          ]
