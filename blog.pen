                          "name": "P",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "传统设计文件里，一个按钮是「圆角矩形 + 居中文本」。而在语义化的画布里，它就是一个按钮：它知道自己有主次状态，知道被点击后应该给出反馈。渲染只是它的一种表现形式。",
                          "lineHeight": 1.9,
                          "fontFamily": "$font-body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
