                        {
                          "type": "text",
                          "id": "NtYJW",
                          "name": "H2 从图层到语义",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "从图层到语义",
